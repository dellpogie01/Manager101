            }
            lines {
              text: "            title = \"Theory of Constraints\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            abbreviation = \"TOC\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Operations Management, Quality & Process Improvement\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A management paradigm stating that every system has at least one bottleneck (constraint) limiting its total throughput.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To systematically identify and elevate system constraints to maximize throughput.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"When production lines, software teams, or sales pipelines experience throughput bottlenecks.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Identify the constraint.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Exploit the constraint (maximize its output without extra investment).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Subordinate everything else to the constraint.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Elevate the constraint (invest resources to expand capacity).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Repeat (prevent inertia).\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"In a bakery where the oven can only bake 50 loaves an hour while mixers can do 200, the oven is the constraint; all prep work is subordinated to oven speed.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            advantages = listOf(\"Laser focus on system bottlenecks\", \"Rapid throughput gains\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            limitations = listOf(\"Requires constant re-evaluation as constraints shift\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"Improving any part of a system other than the bottleneck is a waste of time and money.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
