            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"Fixing a broken login button (High Impact, Low Effort - Quick Win) vs. rebuilding the entire database (High Impact, High Effort - Major Project).\","
