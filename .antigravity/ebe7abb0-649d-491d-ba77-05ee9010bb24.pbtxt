              text: "                \"Calculate Availability (Operating Time / Planned Production Time).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Calculate Performance (Actual Output / Ideal Speed Output).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Calculate Quality (Good Units / Total Units Produced).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Multiply: OEE = Availability x Performance x Quality.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
