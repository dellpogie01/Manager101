            }
            lines {
              text: "            title = \"Kanban Method\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"Kanban\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Operations Management, Quality & Process Improvement\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A visual workflow management method using cards and columns to limit work in progress (WIP) and optimize flow.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To visualize bottlenecks, balance workload, and maximize flow efficiency.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"For software development, marketing tasks, and operations workflow tracking.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Visualize workflow on board (To Do, Doing, Done).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Limit Work in Progress (WIP limits).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Manage flow and measure lead time.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Improve collaboratively.\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            workplaceExample = \"A software team setting a WIP limit of 3 items in \'In Progress\' to prevent multitasking and finish features faster.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            advantages = listOf(\"Visual clarity\", \"Prevents team burnout via WIP limits\", \"Highly flexible\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            limitations = listOf(\"Lacks strict time-boxing of Scrum\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            keyTakeaway = \"Limiting work-in-progress and visualizing bottlenecks dramatically accelerates task completion.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            relatedModelIds = listOf(\"scrum\", \"lean\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            illustrationType = \"kanban_board\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ManagementModel("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            id = \"toc\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryIds = listOf(\"cat4\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            title = \"Theory of Constraints\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"TOC\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Operations Management, Quality & Process Improvement\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A management paradigm stating that every system has at least one bottleneck (constraint) limiting its total throughput.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To systematically identify and elevate system constraints to maximize throughput.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"When production lines, software teams, or sales pipelines experience throughput bottlenecks.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Identify the constraint.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Exploit the constraint (maximize its output without extra investment).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Subordinate everything else to the constraint.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Elevate the constraint (invest resources to expand capacity).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Repeat (prevent inertia).\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            workplaceExample = \"In a bakery where the oven can only bake 50 loaves an hour while mixers can do 200, the oven is the constraint; all prep work is subordinated to oven speed.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            advantages = listOf(\"Laser focus on system bottlenecks\", \"Rapid throughput gains\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            limitations = listOf(\"Requires constant re-evaluation as constraints shift\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            keyTakeaway = \"Improving any part of a system other than the bottleneck is a waste of time and money.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            relatedModelIds = listOf(\"lean\", \"value_stream_mapping\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            illustrationType = \"flow_chart\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ManagementModel("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            id = \"value_stream_mapping\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryIds = listOf(\"cat4\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            title = \"Value Stream Mapping\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"VSM\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Operations Management, Quality & Process Improvement\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A Lean flowcharting tool documenting every step required to bring a product or service from origin to customer.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To identify waste, lead times, and process bottlenecks across end-to-end workflows.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"During Lean transformations and operational audits.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
