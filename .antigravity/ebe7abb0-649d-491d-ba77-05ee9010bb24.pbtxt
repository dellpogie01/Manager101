              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            relatedModelIds = listOf(\"project_risk_matrix\", \"raid_log\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
