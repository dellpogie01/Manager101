            lines {
              text: "                \"Calculate Quality (Good Units / Total Units Produced).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Multiply: OEE = Availability x Performance x Quality.\""
