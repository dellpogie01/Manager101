            lines {
              text: "            definition = \"A strategic growth tool evaluating risk across existing vs. new products and existing vs. new markets.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To help executives choose between Market Penetration, Product Development, Market Development, and Diversification.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"When planning corporate growth and expansion strategies.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Evaluate Market Penetration (existing products in existing markets - lowest risk).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Assess Market Development (existing products in new markets).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Explore Product Development (new products in existing markets).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Consider Diversification (new products in new markets - highest risk).\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
