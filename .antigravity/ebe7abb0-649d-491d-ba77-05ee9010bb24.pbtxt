            lines {
              text: "                \"Identify potential failure modes for a process or design.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Score Severity (S), Occurrence (O), and Detection (D) from 1 to 10.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Calculate Risk Priority Number (RPN = S x O x D).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Prioritize and mitigate highest RPN failure modes.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
