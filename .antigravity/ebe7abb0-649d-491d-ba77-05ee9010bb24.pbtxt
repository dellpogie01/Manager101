            }
            lines {
              text: "            abbreviation = \"VRIO\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"General Management & Strategic Planning\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"An internal resource evaluation framework assessing Value, Rarity, Inimitability, and Organization.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To determine whether internal resources and capabilities can sustain competitive advantage.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"During internal resource audits and strategic capability assessments.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Value: Does the resource enable competitive advantage?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Rarity: Do competitors possess it?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Inimitability: Is it costly/difficult for rivals to imitate?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Organization: Is the firm organized to exploit it?\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            workplaceExample = \"A proprietary AI algorithm is evaluated as valuable, rare, costly to imitate, and well-organized, yielding sustainable advantage.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            advantages = listOf(\"Rigorous internal audit\", \"Identifies core competitive moats\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            limitations = listOf(\"Subjective evaluation of capabilities\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            keyTakeaway = \"Sustainable competitive advantage stems from resources that are valuable, rare, hard to imitate, and backed by organizational execution.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
