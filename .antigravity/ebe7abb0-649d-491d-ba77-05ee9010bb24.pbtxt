            }
            lines {
              text: "            title = \"CLEAR Coaching Model\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"CLEAR\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Communication, Coaching & People Development\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A coaching framework encompassing Contracting, Listening, Exploring, Action, and Review.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To structure transformational coaching conversations and behavioral change.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"During intensive coaching and personal transformation discussions.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Contract: Agree on session goals and boundaries.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Listen: Active, empathetic listening.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Explore: Uncover underlying issues and perspectives.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Action: Agree on concrete next steps.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Review: Evaluate progress and learnings.\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            workplaceExample = \"Structuring a performance improvement coaching conversation starting with a clear contract on session objectives.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            advantages = listOf(\"Structured progression\", \"Strong focus on listening and review\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            limitations = listOf(\"Takes time to execute fully\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            keyTakeaway = \"Contracting clear session boundaries before deep listening and action planning drives coaching success.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
