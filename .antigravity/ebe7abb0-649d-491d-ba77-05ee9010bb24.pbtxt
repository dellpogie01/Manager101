              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"\'During yesterday\'s client pitch (Situation), you interrupted the client twice while they spoke (Behavior), which made them look frustrated and reduced our credibility (Impact).\'\","
