            }
            lines {
              text: "            definition = \"Strategies outlining competitive advantage via Cost Leadership, Differentiation, or Focus.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To guide firms on how to achieve sustainable competitive advantage in their target market.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"When positioning a business unit or product line against competitors.\","
