            }
            lines {
              text: "            definition = \"A learning framework stating that development occurs 70% from experiential stretch assignments, 20% from developmental relationships, and 10% from formal coursework.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To design balanced and effective professional development programs.\","
