            lines {
              text: "            abbreviation = \"Break-Even\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Financial Management & Managerial Accounting\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A financial calculation determining the sales volume required to cover total fixed and variable costs (Zero Profit point).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To calculate minimum sales targets required before a product or business becomes profitable.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"When launching new products, pricing goods, or evaluating startup feasibility.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Identify Fixed Costs (rent, salaries).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Determine Variable Cost per unit.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Determine Selling Price per unit.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Calculate Break-Even Units = Fixed Costs / (Selling Price - Variable Cost per unit).\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            workplaceExample = \"A cafe with $10,000 monthly fixed costs, selling coffee for $5 with $2 variable cost has a break-even point of 3,333 cups monthly.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            advantages = listOf(\"Simple and vital financial feasibility check\", \"Clear sales targets\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            limitations = listOf(\"Assumes constant selling prices and linear costs\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            keyTakeaway = \"Knowing your break-even sales volume is essential before launching any commercial enterprise.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
