            }
            lines {
              text: "            definition = \"Allocating a fixed maximum amount of time to a specific activity, after which work stops regardless of completion.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To prevent perfectionism and Parkinson\'s Law by enforcing hard time limits.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"When writing reports, brainstorming, or preventing scope creep on tasks.\","
