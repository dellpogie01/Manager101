steps {
  type: CORTEX_STEP_TYPE_USER_INPUT
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1791894684
      nanos: 550018481
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "ebe7abb0-649d-491d-ba77-05ee9010bb24"
      step_index: 1
      cascade_id: "ebe7abb0-649d-491d-ba77-05ee9010bb24"
    }
