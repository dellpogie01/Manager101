  planner_response {
    thinking: "**Constructing the Repository**\n\nI\'m now focused on constructing the complete model catalog repository in `/app/src/main/java/com/example/data/ManagementRepository.kt`. I\'m going to ensure the repository contains the nine specified categories and all required management models, including their category entries.\n\n\n"
    tool_calls {
      id: "call_271872"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"package com.example.data\\n\\nimport com.example.model.Category\\nimport com.example.model.ManagementModel\\n\\nobject ManagementRepository {\\n\\n    val categories = listOf(\\n        Category(\\n            id = \\\"cat1\\\",\\n            name = \\\"General Management & Strategic Planning\\\",\\n            description = \\\"High-level goal setting, competitive analysis, organizational design, and long-term business strategy.\\\",\\n            iconName = \\\"strategy\\\",\\n            modelCount = 20\\n        ),\\n        Category(\\n            id = \\\"cat2\\\",\\n            name = \\\"Decision-Making & Problem-Solving\\\",\\n            description = \\\"Structured methods for root cause analysis, risk evaluation, and optimal decision selection.\\\",\\n            iconName = \\\"psychology\\\",\\n            modelCount = 20\\n        ),\\n        Category(\\n            id = \\\"cat3\\\",\\n            name = \\\"Communication, Coaching & People Development\\\",\\n            description = \\\"Frameworks for constructive feedback, leadership coaching, active listening, and talent growth.\\\",\\n            iconName = \\\"people\\\",\\n            modelCount = 20\\n        ),\\n        Category(\\n            id = \\\"cat4\\\",\\n            name = \\\"Operations Management, Quality & Process Improvement\\\",\\n            description = \\\"Methodologies for eliminating waste, improving quality, standardizing operations, and continuous improvement.\\\",\\n            iconName = \\\"settings\\\",\\n            modelCount = 20\\n        ),\\n        Category(\\n            id = \\\"cat5\\\",\\n            name = \\\"Project, Program & Portfolio Management\\\",\\n            description = \\\"Structured approaches to planning, scheduling, risk tracking, and delivering projects successfully.\\\",\\n            iconName = \\\"assignment\\\",\\n            modelCount = 20\\n        ),\\n        Category(\\n            id = \\\"cat6\\\",\\n            name = \\\"Performance Management & Productivity\\\",\\n            description = \\\"Measuring business and personal performance, setting KPIs, and tracking output efficiently.\\\",\\n            iconName = \\\"trending_up\\\",\\n            modelCount = 20\\n        ),\\n        Category(\\n            id = \\\"cat7\\\",\\n            name = \\\"Risk Management, Governance & Compliance\\\",\\n            description = \\\"Identifying enterprise risks, establishing internal controls, and ensuring regulatory compliance.\\\",\\n            iconName = \\\"security\\\",\\n            modelCount = 20\\n        ),\\n        Category(\\n            id = \\\"cat8\\\",\\n            name = \\\"Financial Management & Managerial Accounting\\\",\\n            description = \\\"Cost-volume-profit analysis, capital budgeting, financial ratios, and investment appraisal.\\\",\\n            iconName = \\\"attach_money\\\",\\n            modelCount = 20\\n        ),\\n        Category(\\n            id = \\\"cat9\\\",\\n            name = \\\"Time Management & Personal Productivity\\\",\\n            description = \\\"Techniques for prioritizing tasks, blocking time, and enhancing individual effectiveness.\\\",\\n            iconName = \\\"schedule\\\",\\n            modelCount = 20\\n        )\\n    )\\n\\n    val models = listOf(\\n        // CATEGORY 1\\n        ManagementModel(\\n            id = \\\"smart_goals\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat3\\\", \\\"cat6\\\"),\\n            title = \\\"SMART Goals\\\",\\n            abbreviation = \\\"SMART\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A goal-setting framework ensuring objectives are Specific, Measurable, Achievable, Relevant, and Time-bound.\\\",\\n            purpose = \\\"To provide clarity, focus, and measurable criteria for individual and team objectives.\\\",\\n            whenToUse = \\\"When establishing performance targets, project deliverables, or personal development goals.\\\",\\n            steps = listOf(\\n                \\\"Specific: Define exact what, why, and how.\\\",\\n                \\\"Measurable: Establish concrete metrics for tracking progress.\\\",\\n                \\\"Achievable: Ensure goals are realistic given resources.\\\",\\n                \\\"Relevant: Align with broader team and organizational strategy.\\\",\\n                \\\"Time-bound: Set a clear deadline or target date.\\\"\\n            ),\\n            workplaceExample = \\\"Instead of \'improve customer service\', set \'reduce average customer support ticket response time to under 2 hours by Q3\'.\\\",\\n            advantages = listOf(\\\"Eliminates ambiguity\\\", \\\"Improves accountability\\\", \\\"Provides clear success metrics\\\"),\\n            limitations = listOf(\\\"Can stifle spontaneous creativity\\\", \\\"Over-focus on metrics can miss qualitative value\\\"),\\n            keyTakeaway = \\\"Clear, measurable criteria transform vague ambitions into actionable roadmaps.\\\",\\n            relatedModelIds = listOf(\\\"mbo\\\", \\\"okrs\\\"),\\n            illustrationType = \\\"smart_goals\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"mbo\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat6\\\"),\\n            title = \\\"Management by Objectives\\\",\\n            abbreviation = \\\"MBO\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A strategic management model where managers and employees work together to set, record, and monitor organizational goals.\\\",\\n            purpose = \\\"To align organizational objectives with individual employee targets, boosting motivation and performance.\\\",\\n            whenToUse = \\\"During annual performance planning and organizational alignment cycles.\\\",\\n            steps = listOf(\\n                \\\"Define organizational goals.\\\",\\n                \\\"Translate goals into employee objectives.\\\",\\n                \\\"Monitor performance and progress.\\\",\\n                \\\"Evaluate and reward performance against objectives.\\\"\\n            ),\\n            workplaceExample = \\\"Department head collaborates with software engineers to define quarterly feature release milestones.\\\",\\n            advantages = listOf(\\\"Enhances employee engagement\\\", \\\"Clarifies priorities\\\", \\\"Strengthens alignment\\\"),\\n            limitations = listOf(\\\"Can create administrative burden\\\", \\\"Prone to setting short-term goals at expense of long-term health\\\"),\\n            keyTakeaway = \\\"Shared goal setting bridges top-down strategy with bottom-up execution.\\\",\\n            relatedModelIds = listOf(\\\"smart_goals\\\", \\\"okrs\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"okrs\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat6\\\"),\\n            title = \\\"Objectives and Key Results\\\",\\n            abbreviation = \\\"OKRs\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A goal-setting framework consisting of an inspirational Objective and 3-5 quantifiable Key Results.\\\",\\n            purpose = \\\"To drive aggressive growth and alignment around ambitious measurable outcomes.\\\",\\n            whenToUse = \\\"For quarterly company, team, and individual priority setting.\\\",\\n            steps = listOf(\\n                \\\"Draft qualitative, time-bound Objective.\\\",\\n                \\\"Define 3 measurable Key Results per Objective.\\\",\\n                \\\"Track weekly progress and grade quarterly.\\\"\\n            ),\\n            workplaceExample = \\\"Objective: Deliver world-class user onboarding. KR1: Increase conversion rate from 15% to 25%. KR2: Reduce drop-off in step 2 by 40%.\\\",\\n            advantages = listOf(\\\"Fosters ambition\\\", \\\"Transparent alignment\\\", \\\"Focuses on outcomes over outputs\\\"),\\n            limitations = listOf(\\\"Can cause stress if tied strictly to compensation\\\", \\\"Requires cultural discipline\\\"),\\n            keyTakeaway = \\\"Ambitious qualitative objectives grounded by concrete quantitative key results accelerate high performance.\\\",\\n            relatedModelIds = listOf(\\\"smart_goals\\\", \\\"mbo\\\"),\\n            illustrationType = \\\"okr_diagram\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"swot\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"SWOT Analysis\\\",\\n            abbreviation = \\\"SWOT\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A strategic planning tool evaluating Strengths, Weaknesses, Opportunities, and Threats.\\\",\\n            purpose = \\\"To identify internal capabilities and external market dynamics for strategic positioning.\\\",\\n            whenToUse = \\\"During business planning, product launches, or strategic reviews.\\\",\\n            steps = listOf(\\n                \\\"Identify internal Strengths (advantages) and Weaknesses (vulnerabilities).\\\",\\n                \\\"Analyze external Opportunities (market tailwinds) and Threats (risks).\\\",\\n                \\\"Formulate strategies linking strengths to opportunities and mitigating threats.\\\"\\n            ),\\n            workplaceExample = \\\"A retail store assesses its strong brand loyalty (Strength) against high lease costs (Weakness), e-commerce growth (Opportunity), and rising competition (Threat).\\\",\\n            advantages = listOf(\\\"Simple and intuitive\\\", \\\"Comprehensive internal/external view\\\", \\\"Guides strategic thinking\\\"),\\n            limitations = listOf(\\\"Can become subjective list-making without prioritization\\\", \\\"Static snapshot\\\"),\\n            keyTakeaway = \\\"Matching internal strengths with external market opportunities forms the bedrock of sound strategy.\\\",\\n            relatedModelIds = listOf(\\\"pestle\\\", \\\"porters_five_forces\\\"),\\n            illustrationType = \\\"swot_matrix\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"pestle\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"PESTLE Analysis\\\",\\n            abbreviation = \\\"PESTLE\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A framework tracking macro-environmental factors: Political, Economic, Social, Technological, Legal, and Environmental.\\\",\\n            purpose = \\\"To scan external macro-environmental influences impacting an organization or industry.\\\",\\n            whenToUse = \\\"When entering new markets, launching major products, or conducting long-term strategic planning.\\\",\\n            steps = listOf(\\n                \\\"Analyze Political factors (regulations, government stability).\\\",\\n                \\\"Evaluate Economic trends (inflation, interest rates, growth).\\\",\\n                \\\"Examine Social demographics and cultural shifts.\\\",\\n                \\\"Review Technological innovations and disruptions.\\\",\\n                \\\"Check Legal compliance and labor laws.\\\",\\n                \\\"Assess Environmental and sustainability factors.\\\"\\n            ),\\n            workplaceExample = \\\"An electric vehicle manufacturer analyzes government subsidies (Political), charging infrastructure costs (Economic), consumer climate awareness (Environmental), and battery tech breakthroughs (Technological).\\\",\\n            advantages = listOf(\\\"Holistic macro view\\\", \\\"Proactive risk mitigation\\\", \\\"Identifies emerging trends\\\"),\\n            limitations = listOf(\\\"Can be overwhelming with data\\\", \\\"Requires ongoing updates\\\"),\\n            keyTakeaway = \\\"Anticipating macro-environmental shifts prevents organizations from being blindsided by external forces.\\\",\\n            relatedModelIds = listOf(\\\"swot\\\", \\\"scenario_planning\\\"),\\n            illustrationType = \\\"pestle_grid\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"porters_five_forces\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"Porter\'s Five Forces\\\",\\n            abbreviation = \\\"Five Forces\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A framework analyzing industry attractiveness and competitive intensity using five distinct market forces.\\\",\\n            purpose = \\\"To determine industry profitability potential and guide competitive positioning.\\\",\\n            whenToUse = \\\"When evaluating industry entry, market attractiveness, or competitive strategy.\\\",\\n            steps = listOf(\\n                \\\"Analyze Threat of New Entrants (barriers to entry).\\\",\\n                \\\"Evaluate Bargaining Power of Buyers.\\\",\\n                \\\"Assess Bargaining Power of Suppliers.\\\",\\n                \\\"Examine Threat of Substitute Products or Services.\\\",\\n                \\\"Determine Rivalry Among Existing Competitors.\\\"\\n            ),\\n            workplaceExample = \\\"A software startup evaluates high switching costs for buyers (low buyer power) but fierce existing rivalry to price products effectively.\\\",\\n            advantages = listOf(\\\"Rigorous industry analysis\\\", \\\"Identifies profit pools\\\", \\\"Informs strategic entry/exit\\\"),\\n            limitations = listOf(\\\"Assumes static industry structures\\\", \\\"Less effective in rapidly converging industries\\\"),\\n            keyTakeaway = \\\"Industry profitability is governed by more than just direct competitors; suppliers, buyers, substitutes, and entrants dictate market margins.\\\",\\n            relatedModelIds = listOf(\\\"porters_generic_strategies\\\", \\\"value_chain\\\"),\\n            illustrationType = \\\"five_forces\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"porters_generic_strategies\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"Porter\'s Generic Strategies\\\",\\n            abbreviation = \\\"Generic Strategies\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"Strategies outlining competitive advantage via Cost Leadership, Differentiation, or Focus.\\\",\\n            purpose = \\\"To guide firms on how to achieve sustainable competitive advantage in their target market.\\\",\\n            whenToUse = \\\"When positioning a business unit or product line against competitors.\\\",\\n            steps = listOf(\\n                \\\"Determine strategic advantage: Low Cost vs. Differentiation.\\\",\\n                \\\"Determine strategic target: Broad Market vs. Niche Focus.\\\",\\n                \\\"Select archetype: Cost Leadership, Differentiation, Cost Focus, or Differentiation Focus.\\\"\\n            ),\\n            workplaceExample = \\\"Budget airlines choose Cost Leadership, while luxury car makers choose Differentiation.\\\",\\n            advantages = listOf(\\\"Clear strategic direction\\\", \\\"Prevents being \'stuck in the middle\'\\\"),\\n            limitations = listOf(\\\"Oversimplifies complex modern hybrid strategies\\\"),\\n            keyTakeaway = \\\"A firm must choose between being the lowest-cost producer or distinctively differentiated to succeed.\\\",\\n            relatedModelIds = listOf(\\\"porters_five_forces\\\", \\\"vrio\\\"),\\n            illustrationType = \\\"matrix_2x2\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"mckinsey_7s\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"McKinsey 7S Framework\\\",\\n            abbreviation = \\\"7S\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A model analyzing organizational effectiveness through seven interrelated hard and soft elements.\\\",\\n            purpose = \\\"To diagnose organizational alignment during restructuring, mergers, or culture change.\\\",\\n            whenToUse = \\\"When organizational performance is declining or strategic execution is failing.\\\",\\n            steps = listOf(\\n                \\\"Analyze Hard Elements: Strategy, Structure, Systems.\\\",\\n                \\\"Analyze Soft Elements: Shared Values, Style, Staff, Skills.\\\",\\n                \\\"Evaluate alignment between hard and soft components.\\\"\\n            ),\\n            workplaceExample = \\\"A company adopting digital transformation realizes new software (Systems) fails because employee mindset (Shared Values and Staff) is unaligned.\\\",\\n            advantages = listOf(\\\"Comprehensive organizational lens\\\", \\\"Connects hard logic with human culture\\\"),\\n            limitations = listOf(\\\"Complex to execute\\\", \\\"Focuses on internal factors over external environment\\\"),\\n            keyTakeaway = \\\"Successful strategy execution requires harmonious alignment between hard operational structures and soft human elements.\\\",\\n            relatedModelIds = listOf(\\\"balanced_scorecard\\\", \\\"value_chain\\\"),\\n            illustrationType = \\\"seven_s\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"balanced_scorecard\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat6\\\"),\\n            title = \\\"Balanced Scorecard\\\",\\n            abbreviation = \\\"BSC\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A strategic performance management tool looking at four perspectives: Financial, Customer, Internal Business Processes, and Learning & Growth.\\\",\\n            purpose = \\\"To balance traditional financial metrics with operational, customer, and employee drivers of future growth.\\\",\\n            whenToUse = \\\"When building enterprise performance measurement systems and strategic dashboards.\\\",\\n            steps = listOf(\\n                \\\"Define Financial objectives and metrics.\\\",\\n                \\\"Establish Customer satisfaction and market share goals.\\\",\\n                \\\"Identify internal operational processes critical to success.\\\",\\n                \\\"Set Learning & Growth targets for staff capabilities and culture.\\\"\\n            ),\\n            workplaceExample = \\\"A hospital tracks financial margins alongside patient wait times, treatment error rates, and staff nurse training hours.\\\",\\n            advantages = listOf(\\\"Prevents short-term financial myopia\\\", \\\"Balanced view of organization\\\", \\\"Connects daily work to strategy\\\"),\\n            limitations = listOf(\\\"Requires disciplined data collection\\\", \\\"Can become cluttered with too many KPIs\\\"),\\n            keyTakeaway = \\\"Financial success is the lagging result of satisfied customers, efficient internal processes, and capable, engaged people.\\\",\\n            relatedModelIds = listOf(\\\"okrs\\\", \\\"kpis\\\"),\\n            illustrationType = \\\"balanced_scorecard\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"business_model_canvas\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"Business Model Canvas\\\",\\n            abbreviation = \\\"BMC\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A visual strategic management template for developing and documenting business models across nine building blocks.\\\",\\n            purpose = \\\"To map, test, and pivot business models rapidly and collaboratively.\\\",\\n            whenType = \\\"When launching startups, new ventures, or pivoting existing business lines.\\\",\\n            whenToUse = \\\"During early-stage innovation and business design workshops.\\\",\\n            steps = listOf(\\n                \\\"Define Customer Segments and Value Propositions.\\\",\\n                \\\"Map Channels and Customer Relationships.\\\",\\n                \\\"Identify Revenue Streams and Cost Structure.\\\",\\n                \\\"Determine Key Resources, Key Activities, and Key Partners.\\\"\\n            ),\\n            workplaceExample = \\\"A food delivery app maps restaurant partners (Key Partners), delivery logistics (Key Activities), and commission revenue (Revenue Streams).\\\",\\n            advantages = listOf(\\\"One-page visual clarity\\\", \\\"Highly collaborative\\\", \\\"Easy to iterate and pivot\\\"),\\n            limitations = listOf(\\\"High-level overview lacking deep operational execution detail\\\"),\\n            keyTakeaway = \\\"A business model is greater than a product; it is the interconnected architecture of value creation, delivery, and capture.\\\",\\n            relatedModelIds = listOf(\\\"swot\\\", \\\"value_chain\\\"),\\n            illustrationType = \\\"bmc_grid\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"ansoff_matrix\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"Ansoff Matrix\\\",\\n            abbreviation = \\\"Ansoff\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A strategic growth tool evaluating risk across existing vs. new products and existing vs. new markets.\\\",\\n            purpose = \\\"To help executives choose between Market Penetration, Product Development, Market Development, and Diversification.\\\",\\n            whenToUse = \\\"When planning corporate growth and expansion strategies.\\\",\\n            steps = listOf(\\n                \\\"Evaluate Market Penetration (existing products in existing markets - lowest risk).\\\",\\n                \\\"Assess Market Development (existing products in new markets).\\\",\\n                \\\"Explore Product Development (new products in existing markets).\\\",\\n                \\\"Consider Diversification (new products in new markets - highest risk).\\\"\\n            ),\\n            workplaceExample = \\\"A coffee shop selling loyalty punch cards (Penetration) vs. opening stores overseas (Market Development).\\\",\\n            advantages = listOf(\\\"Clear risk framework for growth\\\", \\\"Structured strategic options\\\"),\\n            limitations = listOf(\\\"Does not account for competitor reactions\\\", \\\"High-level categorization\\\"),\\n            keyTakeaway = \\\"Growth strategies carry varying degrees of risk depending on whether products and markets are familiar or entirely new.\\\",\\n            relatedModelIds = listOf(\\\"bcg_matrix\\\", \\\"swot\\\"),\\n            illustrationType = \\\"matrix_2x2\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"bcg_matrix\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"BCG Growth-Share Matrix\\\",\\n            abbreviation = \\\"BCG Matrix\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A portfolio management framework categorizing business units or products into Cash Cows, Stars, Question Marks, and Dogs.\\\",\\n            purpose = \\\"To allocate capital and manage product lifecycles across a diversified portfolio.\\\",\\n            whenToUse = \\\"During multi-product portfolio reviews and strategic resource allocation.\\\",\\n            steps = listOf(\\n                \\\"Plot business units by Market Growth Rate and Relative Market Share.\\\",\\n                \\\"Classify into Stars (high growth, high share), Cash Cows (low growth, high share), Question Marks (high growth, low share), and Dogs (low growth, low share).\\\",\\n                \\\"Invest in Stars, harvest Cash Cows, evaluate Question Marks, and divest Dogs.\\\"\\n            ),\\n            workplaceExample = \\\"A tech conglomerate funds its AI startup division (Question Mark) using steady cash flows from legacy enterprise software (Cash Cow).\\\",\\n            advantages = listOf(\\\"Simple portfolio visualization\\\", \\\"Guides cash allocation\\\"),\\n            limitations = listOf(\\\"Oversimplifies market dynamics\\\", \\\"Assumes high share automatically equals high profit\\\"),\\n            keyTakeaway = \\\"Balanced portfolios require mature cash cows to fund future stars and question marks.\\\",\\n            relatedModelIds = listOf(\\\"ansoff_matrix\\\", \\\"balanced_scorecard\\\"),\\n            illustrationType = \\\"bcg_grid\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"eisenhower_matrix\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat2\\\", \\\"cat6\\\", \\\"cat9\\\"),\\n            title = \\\"Eisenhower Matrix\\\",\\n            abbreviation = \\\"Eisenhower\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A prioritization framework sorting tasks by Urgency and Importance into four quadrants.\\\",\\n            purpose = \\\"To focus time on what is important rather than merely urgent.\\\",\\n            whenToUse = \\\"Daily or weekly task planning and time management.\\\",\\n            steps = listOf(\\n                \\\"Quadrant 1: Urgent and Important (Do immediately).\\\",\\n                \\\"Quadrant 2: Important, Not Urgent (Schedule time for growth and prevention).\\\",\\n                \\\"Quadrant 3: Urgent, Not Important (Delegate).\\\",\\n                \\\"Quadrant 4: Neither Urgent nor Important (Eliminate).\\\"\\n            ),\\n            workplaceExample = \\\"Scheduling daily strategic planning (Q2) instead of getting bogged down answering every incoming Slack notification (Q3).\\\",\\n            advantages = listOf(\\\"Instantly clarifies priorities\\\", \\\"Reduces firefighting\\\"),\\n            limitations = listOf(\\\"Requires discipline to distinguish true importance from urgency\\\"),\\n            keyTakeaway = \\\"Effective leaders spend their time in Quadrant 2\342\200\224on important, non-urgent tasks that build long-term value.\\\",\\n            relatedModelIds = listOf(\\\"pareto_analysis\\\", \\\"time_blocking\\\"),\\n            illustrationType = \\\"eisenhower\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"raci_matrix\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat5\\\"),\\n            title = \\\"RACI Matrix\\\",\\n            abbreviation = \\\"RACI\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A responsibility assignment chart defining roles across Responsible, Accountable, Consulted, and Informed.\\\",\\n            purpose = \\\"To eliminate ambiguity and confusion regarding project roles and decision ownership.\\\",\\n            whenToUse = \\\"At project kickoff and during organizational workflow design.\\\",\\n            steps = listOf(\\n                \\\"List all project tasks and deliverables.\\\",\\n                \\\"List all project roles and stakeholders.\\\",\\n                \\\"Assign R (do the work), A (sole owner/approver), C (provide input), and I (kept updated) for each task.\\\"\\n            ),\\n            workplaceExample = \\\"Assigning Project Manager as Accountable and Lead Developer as Responsible for software deployment.\\\",\\n            advantages = listOf(\\\"Prevents overlapping ownership\\\", \\\"Ensures every task has exactly one Accountable owner\\\"),\\n            limitations = listOf(\\\"Can create bureaucracy if overused\\\"),\\n            keyTakeaway = \\\"Clear ownership with a single \'Accountable\' person per task prevents project gridlock.\\\",\\n            relatedModelIds = listOf(\\\"stakeholder_analysis\\\", \\\"work_breakdown_structure\\\"),\\n            illustrationType = \\\"raci_table\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"hoshin_kanri\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"Hoshin Kanri\\\",\\n            abbreviation = \\\"Policy Deployment\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A strategic policy deployment methodology connecting executive breakthroughs to daily frontline operations.\\\",\\n            purpose = \\\"To ensure everyone in an organization pulls in the exact same strategic direction.\\\",\\n            whenToUse = \\\"For annual corporate strategy planning and cascading breakthrough goals.\\\",\\n            steps = listOf(\\n                \\\"Develop 3-5 year breakthrough vision.\\\",\\n                \\\"Cascade annual goals using Catchball (two-way dialogue).\\\",\\n                \\\"Deploy metrics to operational teams.\\\",\\n                \\\"Review monthly performance.\\\"\\n            ),\\n            workplaceExample = \\\"Executive management aligns with plant floor supervisors on a 50% defect reduction target using X-matrix planning.\\\",\\n            advantages = listOf(\\\"Total organizational alignment\\\", \\\"Eliminates silos\\\"),\\n            limitations = listOf(\\\"Rigid framework requiring strong leadership discipline\\\"),\\n            keyTakeaway = \\\"Strategy deployment succeeds through collaborative \'catchball\' dialogue between leadership and frontline execution teams.\\\",\\n            relatedModelIds = listOf(\\\"okrs\\\", \\\"balanced_scorecard\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"stakeholder_analysis\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat5\\\"),\\n            title = \\\"Stakeholder Analysis\\\",\\n            abbreviation = \\\"Stakeholder Map\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A process of identifying individuals or groups affected by a project and mapping their Power and Interest.\\\",\\n            purpose = \\\"To manage expectations, secure buy-in, and mitigate opposition from key stakeholders.\\\",\\n            whenToUse = \\\"At project inception and during major organizational change initiatives.\\\",\\n            steps = listOf(\\n                \\\"Identify all stakeholders.\\\",\\n                \\\"Assess their Power (influence) and Interest (stake).\\\",\\n                \\\"Map onto Power/Interest Grid (Keep Satisfied, Manage Closely, Monitor, Keep Informed).\\\",\\n                \\\"Develop tailored engagement strategies.\\\"\\n            ),\\n            workplaceExample = \\\"Engaging the CFO (high power, high interest) with weekly budget reports while keeping junior staff informed.\\\",\\n            advantages = listOf(\\\"Proactive risk management\\\", \\\"Builds strong coalition support\\\"),\\n            limitations = listOf(\\\"Stakeholder attitudes can shift rapidly\\\"),\\n            keyTakeaway = \\\"Understanding stakeholder power and interest ensures communication is targeted where it matters most.\\\",\\n            relatedModelIds = listOf(\\\"raci_matrix\\\", \\\"raid_log\\\"),\\n            illustrationType = \\\"matrix_2x2\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"scenario_planning\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"Scenario Planning\\\",\\n            abbreviation = \\\"Scenario Analysis\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A strategic technique exploring multiple plausible future operating environments to test resilience.\\\",\\n            purpose = \\\"To prepare organizations for uncertainty and volatility rather than relying on a single forecast.\\\",\\n            whenToUse = \\\"During long-term strategic planning in volatile or disruptive industries.\\\",\\n            steps = listOf(\\n                \\\"Identify key uncertainties and driving forces.\\\",\\n                \\\"Develop 3-4 distinct plausible scenarios (e.g., boom, recession, technological disruption).\\\",\\n                \\\"Evaluate strategy performance under each scenario.\\\",\\n                \\\"Build robust contingency plans and early warning indicators.\\\"\\n            ),\\n            workplaceExample = \\\"An energy company models strategies for oil prices at $40, $80, and $140 per barrel.\\\",\\n            advantages = listOf(\\\"Enhances organizational agility\\\", \\\"Challenges groupthink\\\"),\\n            limitations = listOf(\\\"Resource-intensive\\\", \\\"Cannot predict exact future\\\"),\\n            keyTakeaway = \\\"Robust strategies are stress-tested against multiple plausible futures, not just optimistic forecasts.\\\",\\n            relatedModelIds = listOf(\\\"pestle\\\", \\\"swot\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"value_chain\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat4\\\"),\\n            title = \\\"Value Chain Analysis\\\",\\n            abbreviation = \\\"Value Chain\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A model dividing business activities into primary (operations, logistics, sales) and support activities to identify cost and differentiation advantages.\\\",\\n            purpose = \\\"To analyze where value is created and where costs can be optimized across operational stages.\\\",\\n            whenToUse = \\\"When seeking to improve profit margins or build competitive advantage.\\\",\\n            steps = listOf(\\n                \\\"Identify Primary Activities: Inbound Logistics, Operations, Outbound Logistics, Marketing & Sales, Service.\\\",\\n                \\\"Identify Support Activities: Procurement, Tech Development, HR, Infrastructure.\\\",\\n                \\\"Analyze cost and value drivers for each activity.\\\"\\n            ),\\n            workplaceExample = \\\"A manufacturer automates inbound logistics and procurement to lower unit costs without sacrificing product quality.\\\",\\n            advantages = listOf(\\\"Granular operational insight\\\", \\\"Highlights cost reduction and differentiation opportunities\\\"),\\n            limitations = listOf(\\\"Can be complex to map across service industries\\\"),\\n            keyTakeaway = \\\"Competitive advantage is won by optimizing the chain of primary and support activities that deliver value to customers.\\\",\\n            relatedModelIds = listOf(\\\"porters_five_forces\\\", \\\"vrio\\\"),\\n            illustrationType = \\\"value_chain_diagram\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"vrio\\\",\\n            categoryIds = listOf(\\\"cat1\\\"),\\n            title = \\\"VRIO Framework\\\",\\n            abbreviation = \\\"VRIO\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"An internal resource evaluation framework assessing Value, Rarity, Inimitability, and Organization.\\\",\\n            purpose = \\\"To determine whether internal resources and capabilities can sustain competitive advantage.\\\",\\n            whenToUse = \\\"During internal resource audits and strategic capability assessments.\\\",\\n            steps = listOf(\\n                \\\"Value: Does the resource enable competitive advantage?\\\",\\n                \\\"Rarity: Do competitors possess it?\\\",\\n                \\\"Inimitability: Is it costly/difficult for rivals to imitate?\\\",\\n                \\\"Organization: Is the firm organized to exploit it?\\\"\\n            ),\\n            workplaceExample = \\\"A proprietary AI algorithm is evaluated as valuable, rare, costly to imitate, and well-organized, yielding sustainable advantage.\\\",\\n            advantages = listOf(\\\"Rigorous internal audit\\\", \\\"Identifies core competitive moats\\\"),\\n            limitations = listOf(\\\"Subjective evaluation of capabilities\\\"),\\n            keyTakeaway = \\\"Sustainable competitive advantage stems from resources that are valuable, rare, hard to imitate, and backed by organizational execution.\\\",\\n            relatedModelIds = listOf(\\\"swot\\\", \\\"mckinsey_7s\\\"),\\n            illustrationType = \\\"vrio_flow\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"bpm\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat4\\\"),\\n            title = \\\"Business Process Management\\\",\\n            abbreviation = \\\"BPM\\\",\\n            categoryName = \\\"General Management & Strategic Planning\\\",\\n            definition = \\\"A systematic approach to making an organization\'s workflow more effective, efficient, and adaptable.\\\",\\n            purpose = \\\"To continuously design, model, execute, monitor, and optimize business processes.\\\",\\n            whenToUse = \\\"When scaling operations, reducing cycle times, or undergoing digital transformation.\\\",\\n            steps = listOf(\\n                \\\"Design and model current processes.\\\",\\n                \\\"Execute and automate workflows.\\\",\\n                \\\"Monitor and measure process performance.\\\",\\n                \\\"Optimize and continuously improve.\\\"\\n            ),\\n            workplaceExample = \\\"Digitizing invoice approval workflows to reduce processing time from 14 days to 2 days.\\\",\\n            advantages = listOf(\\\"Streamlined operations\\\", \\\"Improved compliance\\\", \\\"Higher efficiency\\\"),\\n            limitations = listOf(\\\"Can encounter employee resistance during process redesign\\\"),\\n            keyTakeaway = \\\"Optimized business processes form the operational backbone of agile, scalable enterprises.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"six_sigma\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n\\n        // CATEGORY 2 \342\200\224 DECISION-MAKING AND PROBLEM-SOLVING\\n        ManagementModel(\\n            id = \\\"rational_decision\\\",\\n            categoryIds = listOf(\\\"cat2\\\"),\\n            title = \\\"Rational Decision-Making Model\\\",\\n            abbreviation = \\\"Rational Model\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A structured, step-by-step cognitive approach to making logically sound, optimal choices.\\\",\\n            purpose = \\\"To eliminate emotional bias and evaluate options systematically.\\\",\\n            whenToUse = \\\"For high-stakes capital allocation, major procurement, or strategic choices.\\\",\\n            steps = listOf(\\n                \\\"Define the problem.\\\",\\n                \\\"Identify decision criteria.\\\",\\n                \\\"Weight the criteria.\\\",\\n                \\\"Generate alternative solutions.\\\",\\n                \\\"Evaluate alternatives against criteria.\\\",\\n                \\\"Select and implement the optimal choice.\\\"\\n            ),\\n            workplaceExample = \\\"Evaluating software vendor bids using a scored rubric of cost, security, scalability, and support.\\\",\\n            advantages = listOf(\\\"Logical and defensible\\\", \\\"Reduces cognitive bias\\\"),\\n            limitations = listOf(\\\"Time-consuming\\\", \\\"Assumes complete information availability\\\"),\\n            keyTakeaway = \\\"Systematic evaluation of criteria and alternatives leads to objective, defensible decisions.\\\",\\n            relatedModelIds = listOf(\\\"weighted_decision_matrix\\\", \\\"cost_benefit\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"vroom_yetton\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat3\\\"),\\n            title = \\\"Vroom\342\200\223Yetton\342\200\223Jago Decision Model\\\",\\n            abbreviation = \\\"Vroom-Yetton\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A leadership decision model prescribing the optimal degree of team participation based on situation attributes.\\\",\\n            purpose = \\\"To help leaders choose between autocratic, consultative, and group decision styles.\\\",\\n            whenToUse = \\\"When deciding whether to make a decision alone, consult the team, or delegate consensus.\\\",\\n            steps = listOf(\\n                \\\"Assess problem attributes (importance of quality, team commitment required).\\\",\\n                \\\"Follow decision tree path.\\\",\\n                \\\"Select leadership style: Autocratic (A1/A2), Consultative (C1/C2), or Group (G2).\\\"\\n            ),\\n            workplaceExample = \\\"Choosing an autocratic decision during an urgent cybersecurity crisis versus group consensus for office re-layout.\\\",\\n            advantages = listOf(\\\"Situational flexibility\\\", \\\"Balances decision quality with buy-in\\\"),\\n            limitations = listOf(\\\"Complex decision tree to navigate\\\"),\\n            keyTakeaway = \\\"The right decision-making style depends on the urgency of the problem and the level of team buy-in required.\\\",\\n            relatedModelIds = listOf(\\\"six_thinking_hats\\\", \\\"rational_decision\\\"),\\n            illustrationType = \\\"decision_tree\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"pareto_analysis\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat6\\\", \\\"cat9\\\"),\\n            title = \\\"Pareto Analysis (80/20 Rule)\\\",\\n            abbreviation = \\\"Pareto / 80/20\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A decision rule stating that roughly 80% of consequences come from 20% of the causes.\\\",\\n            purpose = \\\"To prioritize efforts on the vital few issues yielding the greatest impact.\\\",\\n            whenToUse = \\\"When tackling backlogs, defect reduction, or customer complaint analysis.\\\",\\n            steps = listOf(\\n                \\\"List problems or causes.\\\",\\n                \\\"Measure frequency or impact of each.\\\",\\n                \\\"Sort in descending order and calculate cumulative percentages.\\\",\\n                \\\"Focus resources on the top 20% drivers.\\\"\\n            ),\\n            workplaceExample = \\\"Realizing 80% of software bugs stem from 20% of the codebase modules, directing QA testing there.\\\",\\n            advantages = listOf(\\\"High-impact prioritization\\\", \\\"Saves time and resources\\\"),\\n            limitations = listOf(\\\"Not all problems fit strict 80/20 proportions\\\"),\\n            keyTakeaway = \\\"Focusing on the vital 20% of causes delivers 80% of the results.\\\",\\n            relatedModelIds = listOf(\\\"eisenhower_matrix\\\", \\\"five_whys\\\"),\\n            illustrationType = \\\"pareto_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"five_whys\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat4\\\"),\\n            title = \\\"Five Whys\\\",\\n            abbreviation = \\\"5 Whys\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"An iterative interrogative technique used to explore cause-and-effect relationships underlying a problem.\\\",\\n            purpose = \\\"To drill down past symptoms to discover the true root cause.\\\",\\n            whenToUse = \\\"During incident post-mortems, quality defects, and operational failures.\\\",\\n            steps = listOf(\\n                \\\"State the problem clearly.\\\",\\n                \\\"Ask \'Why\' did this happen?\\\",\\n                \\\"Ask \'Why\' again to the answer.\\\",\\n                \\\"Repeat until root cause is uncovered (typically 5 iterations).\\\"\\n            ),\\n            workplaceExample = \\\"Server crashed? Why? Memory overflow. Why? Memory leak in job runner. Why? Unreleased connection pool. Root cause: Missing unit test for leak detection.\\\",\\n            advantages = listOf(\\\"Simple and fast\\\", \\\"Requires no complex statistics\\\"),\\n            limitations = listOf(\\\"Can lead down single subjective paths depending on facilitator\\\"),\\n            keyTakeaway = \\\"Asking \'Why\' five times strips away surface symptoms to reveal actionable root causes.\\\",\\n            relatedModelIds = listOf(\\\"fishbone\\\", \\\"root_cause_analysis\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"fishbone\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat4\\\"),\\n            title = \\\"Fishbone Diagram (Ishikawa)\\\",\\n            abbreviation = \\\"Ishikawa\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A visualization tool categorizing potential causes of a problem into categories (e.g., 6Ms: Manpower, Methods, Materials, Machinery, Measurement, Milieu).\\\",\\n            purpose = \\\"To brainstorm and organize all potential root causes of a quality or operational issue.\\\",\\n            whenToUse = \\\"During root cause analysis workshops and quality circles.\\\",\\n            steps = listOf(\\n                \\\"Write down the problem statement at the fish head.\\\",\\n                \\\"Draw major category bones (Methods, Machines, Materials, Manpower, etc.).\\\",\\n                \\\"Brainstorm contributing factors branching off each category.\\\",\\n                \\\"Investigate most likely causes.\\\"\\n            ),\\n            workplaceExample = \\\"Investigating manufacturing scrap defects by examining machine calibration and raw material batches.\\\",\\n            advantages = listOf(\\\"Comprehensive brainstorming structure\\\", \\\"Visual clarity\\\"),\\n            limitations = listOf(\\\"Does not prove causation without empirical testing\\\"),\\n            keyTakeaway = \\\"Categorizing potential causes systematically prevents overlooking hidden systemic issues.\\\",\\n            relatedModelIds = listOf(\\\"five_whys\\\", \\\"dmaic\\\"),\\n            illustrationType = \\\"fishbone_diagram\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"pdca\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat4\\\"),\\n            title = \\\"PDCA Cycle (Plan\342\200\223Do\342\200\223Check\342\200\223Act)\\\",\\n            abbreviation = \\\"PDCA / Deming\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"An iterative four-step management method for continuous improvement of processes and products.\\\",\\n            purpose = \\\"To test changes on a small scale, measure results, and standardize improvements.\\\",\\n            whenToUse = \\\"During continuous improvement initiatives and pilot implementations.\\\",\\n            steps = listOf(\\n                \\\"Plan: Identify problem and formulate hypothesis.\\\",\\n                \\\"Do: Implement change on a small scale.\\\",\\n                \\\"Check: Measure and evaluate results against expected outcomes.\\\",\\n                \\\"Act: Standardize the change or revise and repeat.\\\"\\n            ),\\n            workplaceExample = \\\"Testing a new customer checkout flow on 5% of users before rolling out globally.\\\",\\n            advantages = listOf(\\\"Safe iterative learning\\\", \\\"Drives continuous improvement\\\"),\\n            limitations = listOf(\\\"Can be slow for rapid crisis management\\\"),\\n            keyTakeaway = \\\"Continuous improvement thrives on rapid cycles of planning, testing, checking, and acting.\\\",\\n            relatedModelIds = listOf(\\\"kaizen\\\", \\\"dmaic\\\"),\\n            illustrationType = \\\"pdca_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"dmaic\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat4\\\"),\\n            title = \\\"DMAIC\\\",\\n            abbreviation = \\\"DMAIC\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A data-driven Six Sigma quality strategy consisting of Define, Measure, Analyze, Improve, and Control.\\\",\\n            purpose = \\\"To eliminate defects, reduce variation, and optimize business processes.\\\",\\n            whenToUse = \\\"For complex, data-heavy quality and operational defect reduction projects.\\\",\\n            steps = listOf(\\n                \\\"Define project goals and customer requirements.\\\",\\n                \\\"Measure current process performance and collect data.\\\",\\n                \\\"Analyze data to find root causes of defects.\\\",\\n                \\\"Improve process by addressing root causes.\\\",\\n                \\\"Control future performance with monitoring.\\\"\\n            ),\\n            workplaceExample = \\\"Reducing customer billing errors in a telecom billing system from 4% to under 0.1%.\\\",\\n            advantages = listOf(\\\"Rigorous data-driven methodology\\\", \\\"High financial payback\\\"),\\n            limitations = listOf(\\\"Requires statistical training\\\", \\\"Time-intensive\\\"),\\n            keyTakeaway = \\\"Rigorous data analysis combined with structured problem solving eliminates chronic process defects.\\\",\\n            relatedModelIds = listOf(\\\"six_sigma\\\", \\\"pdca\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"a3_problem_solving\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat4\\\"),\\n            title = \\\"A3 Problem-Solving\\\",\\n            abbreviation = \\\"A3\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A structured problem-solving and continuous improvement report developed on a single A3-sized sheet of paper.\\\",\\n            purpose = \\\"To foster collaborative problem-solving, root cause analysis, and concise communication.\\\",\\n            whenToUse = \\\"For operational problem solving and continuous improvement coaching.\\\",\\n            steps = listOf(\\n                \\\"Background & Current Condition.\\\",\\n                \\\"Problem Statement & Goal Setting.\\\",\\n                \\\"Root Cause Analysis.\\\",\\n                \\\"Countermeasures & Implementation Plan.\\\",\\n                \\\"Follow-up & Results Verification.\\\"\\n            ),\\n            workplaceExample = \\\"Plant engineers map warehouse picking delays on a single A3 sheet to align management on countermeasures.\\\",\\n            advantages = listOf(\\\"Encourages concise thinking\\\", \\\"Visual and collaborative\\\"),\\n            limitations = listOf(\\\"Requires coaching culture to use effectively\\\"),\\n            keyTakeaway = \\\"Fitting a complex problem and solution onto a single A3 sheet forces clarity and operational alignment.\\\",\\n            relatedModelIds = listOf(\\\"five_whys\\\", \\\"pdca\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"eight_d\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat4\\\"),\\n            title = \\\"8D Problem-Solving\\\",\\n            abbreviation = \\\"8D\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"An eight-discipline problem-solving methodology designed to identify, correct, and eliminate recurring non-conformances.\\\",\\n            purpose = \\\"To resolve major customer-facing quality failures permanently.\\\",\\n            whenToUse = \\\"When addressing severe product defects or systemic customer complaints.\\\",\\n            steps = listOf(\\n                \\\"D1: Form Team, D2: Describe Problem, D3: Containment Action.\\\",\\n                \\\"D4: Identify Root Cause, D5: Choose Corrective Actions, D6: Implement & Validate.\\\",\\n                \\\"D7: Prevent Recurrence, D8: Congratulate Team.\\\"\\n            ),\\n            workplaceExample = \\\"Automotive supplier issues an 8D report after a defective brake component is discovered in customer vehicles.\\\",\\n            advantages = listOf(\\\"Extremely thorough\\\", \\\"Customer-focused containment and prevention\\\"),\\n            limitations = listOf(\\\"Bureaucratic for minor issues\\\"),\\n            keyTakeaway = \\\"Permanent containment and root cause elimination prevent catastrophic quality failures from recurring.\\\",\\n            relatedModelIds = listOf(\\\"dmaic\\\", \\\"fmea\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"six_thinking_hats\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat3\\\"),\\n            title = \\\"Six Thinking Hats\\\",\\n            abbreviation = \\\"6 Hats\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A parallel thinking process by Edward de Bono separating thinking into six distinct emotional and logical perspectives.\\\",\\n            purpose = \\\"To remove ego, structure meetings, and examine problems from all angles.\\\",\\n            whenToUse = \\\"During brainstorming, strategic evaluation, and conflict resolution meetings.\\\",\\n            steps = listOf(\\n                \\\"White Hat: Facts and data.\\\",\\n                \\\"Red Hat: Intuition and emotions.\\\",\\n                \\\"Black Hat: Cautions and risks.\\\",\\n                \\\"Yellow Hat: Benefits and optimism.\\\",\\n                \\\"Green Hat: Creativity and new ideas.\\\",\\n                \\\"Blue Hat: Process control and summary.\\\"\\n            ),\\n            workplaceExample = \\\"In a product meeting, team members wear the \'Black Hat\' collectively to list risks without anyone feeling personally defensive.\\\",\\n            advantages = listOf(\\\"Prevents argumentative debate\\\", \\\"Uncovers blind spots\\\"),\\n            limitations = listOf(\\\"Requires team familiarity and participation\\\"),\\n            keyTakeaway = \\\"Separating emotion from logic and switching cognitive perspectives unlocks comprehensive problem evaluation.\\\",\\n            relatedModelIds = listOf(\\\"vroom_yetton\\\", \\\"pre_mortem\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"decision_tree\\\",\\n            categoryIds = listOf(\\\"cat2\\\"),\\n            title = \\\"Decision Tree Analysis\\\",\\n            abbreviation = \\\"Decision Tree\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A flowchart model mapping out decisions, potential outcomes, resource costs, and utility probabilities.\\\",\\n            purpose = \\\"To evaluate mathematical expected values of competing courses of action under uncertainty.\\\",\\n            whenToUse = \\\"For financial investments, R&D project pipelines, and branching choices.\\\",\\n            steps = listOf(\\n                \\\"Draw decision nodes and branch alternatives.\\\",\\n                \\\"Map probabilistic outcome nodes for each branch.\\\",\\n                \\\"Assign costs and payoffs to each path.\\\",\\n                \\\"Calculate expected monetary value (EMV) for each branch and select optimal path.\\\"\\n            ),\\n            workplaceExample = \\\"Comparing whether to build a new warehouse ($5M cost with 70% high demand probability) vs. leasing.\\\",\\n            advantages = listOf(\\\"Visualizes uncertainty\\\", \\\"Quantifies financial payoffs\\\"),\\n            limitations = listOf(\\\"Can become overly complex with many variables\\\"),\\n            keyTakeaway = \\\"Mapping decision branches and probabilities calculates the mathematically optimal path forward.\\\",\\n            relatedModelIds = listOf(\\\"cost_benefit\\\", \\\"weighted_decision_matrix\\\"),\\n            illustrationType = \\\"decision_tree\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"cost_benefit\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat8\\\"),\\n            title = \\\"Cost\342\200\223Benefit Analysis\\\",\\n            abbreviation = \\\"CBA\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A financial and operational evaluation comparing total expected costs against total expected benefits.\\\",\\n            purpose = \\\"To determine whether a project or policy is economically justifiable.\\\",\\n            whenToUse = \\\"When proposing capital expenditures, IT upgrades, or policy changes.\\\",\\n            steps = listOf(\\n                \\\"Identify all costs (direct, indirect, implementation).\\\",\\n                \\\"Quantify all benefits (revenue gains, cost savings, time saved).\\\",\\n                \\\"Discount future cash flows to present value.\\\",\\n                \\\"Calculate Cost-Benefit Ratio (Benefits / Costs).\\\"\\n            ),\\n            workplaceExample = \\\"Evaluating a $100k CRM software investment projected to save $150k in sales rep hours annually.\\\",\\n            advantages = listOf(\\\"Clear financial rationale\\\", \\\"Justifies resource allocation\\\"),\\n            limitations = listOf(\\\"Difficult to quantify intangible benefits like employee morale\\\"),\\n            keyTakeaway = \\\"Projects should only proceed when quantified benefits clearly outweigh implementation costs.\\\",\\n            relatedModelIds = listOf(\\\"npv\\\", \\\"roi\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"weighted_decision_matrix\\\",\\n            categoryIds = listOf(\\\"cat2\\\"),\\n            title = \\\"Weighted Decision Matrix\\\",\\n            abbreviation = \\\"Decision Matrix\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A quantitative tool scoring competing options against weighted criteria.\\\",\\n            purpose = \\\"To make objective choices among multiple viable alternatives.\\\",\\n            whenToUse = \\\"When selecting software vendors, office locations, or project portfolios.\\\",\\n            steps = listOf(\\n                \\\"List evaluation criteria (e.g., Cost, Speed, Quality).\\\",\\n                \\\"Assign a percentage weight to each criterion (totaling 100%).\\\",\\n                \\\"Score each option on a scale (1-10).\\\",\\n                \\\"Multiply scores by weights and sum totals to rank options.\\\"\\n            ),\\n            workplaceExample = \\\"Scoring three cloud hosting providers on security (weight 40%), cost (weight 30%), and support (weight 30%).\\\",\\n            advantages = listOf(\\\"Removes emotional bias\\\", \\\"Transparent scoring\\\"),\\n            limitations = listOf(\\\"Weights and scores can be manipulated to favor a preferred outcome\\\"),\\n            keyTakeaway = \\\"Scoring alternatives against weighted criteria transforms subjective debates into objective decisions.\\\",\\n            relatedModelIds = listOf(\\\"rational_decision\\\", \\\"decision_tree\\\"),\\n            illustrationType = \\\"raci_table\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"force_field\\\",\\n            categoryIds = listOf(\\\"cat2\\\"),\\n            title = \\\"Force Field Analysis\\\",\\n            abbreviation = \\\"Force Field\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A change management model examining driving forces (pushing for change) versus restraining forces (resisting change).\\\",\\n            purpose = \\\"To evaluate whether change is viable and identify levers to overcome resistance.\\\",\\n            whenToUse = \\\"When planning organizational restructuring or new process rollouts.\\\",\\n            steps = listOf(\\n                \\\"State the proposed change.\\\",\\n                \\\"Brainstorm driving forces pushing for change.\\\",\\n                \\\"Brainstorm restraining forces resisting change.\\\",\\n                \\\"Score forces and develop strategies to strengthen drivers or weaken restraints.\\\"\\n            ),\\n            workplaceExample = \\\"Moving to remote work: Driver is employee flexibility; Restrainer is loss of informal collaboration.\\\",\\n            advantages = listOf(\\\"Highlights obstacles before implementation\\\", \\\"Guides change strategy\\\"),\\n            limitations = listOf(\\\"Subjective scoring of forces\\\"),\\n            keyTakeaway = \\\"Successful change requires strengthening driving forces while systematically reducing restraining obstacles.\\\",\\n            relatedModelIds = listOf(\\\"swot\\\", \\\"six_thinking_hats\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"root_cause_analysis\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat4\\\"),\\n            title = \\\"Root Cause Analysis\\\",\\n            abbreviation = \\\"RCA\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A structured problem-solving approach designed to uncover the fundamental origin of failures rather than treating symptoms.\\\",\\n            purpose = \\\"To prevent recurring operational failures.\\\",\\n            whenToUse = \\\"Following major system outages, safety incidents, or severe defects.\\\",\\n            steps = listOf(\\n                \\\"Define the failure event.\\\",\\n                \\\"Gather timeline and data.\\\",\\n                \\\"Identify contributing factors using 5 Whys or Fishbone.\\\",\\n                \\\"Implement permanent corrective and preventive actions (CAPA).\\\"\\n            ),\\n            workplaceExample = \\\"Fixing an assembly line stoppage by repairing the sensor wiring harness rather than just resetting the fuse.\\\",\\n            advantages = listOf(\\\"Prevents recurring failures\\\", \\\"Improves system reliability\\\"),\\n            limitations = listOf(\\\"Requires investigative time\\\"),\\n            keyTakeaway = \\\"Treating symptoms guarantees recurring failures; solving root causes ensures permanent reliability.\\\",\\n            relatedModelIds = listOf(\\\"five_whys\\\", \\\"fishbone\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"kepner_tregoe\\\",\\n            categoryIds = listOf(\\\"cat2\\\"),\\n            title = \\\"Kepner\342\200\223Tregoe Decision Analysis\\\",\\n            abbreviation = \\\"KT Method\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A structured methodology for problem analysis, potential problem analysis, and rational decision-making.\\\",\\n            purpose = \\\"To make unbiased, risk-mitigated decisions in complex enterprise environments.\\\",\\n            whenToUse = \\\"During high-risk technical troubleshooting and strategic selection.\\\",\\n            steps = listOf(\\n                \\\"Appraise situation and divide into components.\\\",\\n                \\\"Define Musts (mandatory constraints) and Wants (weighted desires).\\\",\\n                \\\"Evaluate alternatives against Musts and Wants.\\\",\\n                \\\"Conduct Potential Problem Analysis for risk mitigation.\\\"\\n            ),\\n            workplaceExample = \\\"NASA mission control utilizing KT troubleshooting during spacecraft anomalies.\\\",\\n            advantages = listOf(\\\"Extremely rigorous\\\", \\\"Minimizes cognitive bias\\\"),\\n            limitations = listOf(\\\"Steep training curve\\\", \\\"Bureaucratic for quick decisions\\\"),\\n            keyTakeaway = \\\"Separating must-have constraints from weighted desires ensures high-stakes choices withstand rigorous scrutiny.\\\",\\n            relatedModelIds = listOf(\\\"rational_decision\\\", \\\"pre_mortem\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"impact_effort_matrix\\\",\\n            categoryIds = listOf(\\\"cat2\\\", \\\"cat9\\\"),\\n            title = \\\"Impact\342\200\223Effort Matrix\\\",\\n            abbreviation = \\\"Impact/Effort\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A prioritization grid sorting initiatives into Quick Wins, Major Projects, Fill-Ins, and Thankless Tasks.\\\",\\n            purpose = \\\"To maximize ROI on time and resources by focusing on high-impact, low-effort projects.\\\",\\n            whenToUse = \\\"When prioritizing feature backlogs, improvement ideas, or task lists.\\\",\\n            steps = listOf(\\n                \\\"List all proposed tasks or ideas.\\\",\\n                \\\"Estimate Business Impact (High/Low) and Implementation Effort (High/Low).\\\",\\n                \\\"Plot on 2x2 matrix.\\\",\\n                \\\"Prioritize Quick Wins first, then Major Projects; avoid Thankless Tasks.\\\"\\n            ),\\n            workplaceExample = \\\"Fixing a broken login button (High Impact, Low Effort - Quick Win) vs. rebuilding the entire database (High Impact, High Effort - Major Project).\\\",\\n            advantages = listOf(\\\"Instant prioritization clarity\\\", \\\"Maximizes resource efficiency\\\"),\\n            limitations = listOf(\\\"Impact and effort estimates can be inaccurate\\\"),\\n            keyTakeaway = \\\"Always tackle \'Quick Wins\' first to build momentum before investing in major projects.\\\",\\n            relatedModelIds = listOf(\\\"eisenhower_matrix\\\", \\\"moscow\\\"),\\n            illustrationType = \\\"matrix_2x2\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"pre_mortem\\\",\\n            categoryIds = listOf(\\\"cat2\\\"),\\n            title = \\\"Pre-Mortem Analysis\\\",\\n            abbreviation = \\\"Pre-Mortem\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A managerial strategy where a team imagines a project has completely failed before it even launches, working backward to uncover vulnerabilities.\\\",\\n            purpose = \\\"To overcome optimism bias and unearth hidden risks proactively.\\\",\\n            whenToUse = \\\"At the conclusion of project planning, prior to project greenlight.\\\",\\n            steps = listOf(\\n                \\\"Assume the project has failed spectacularly.\\\",\\n                \\\"Each team member writes down every reason why it failed.\\\",\\n                \\\"Compile and categorize risks.\\\",\\n                \\\"Revise project plan to mitigate identified vulnerabilities.\\\"\\n            ),\\n            workplaceExample = \\\"Before launching a new product line, the team imagines it sold zero units because shipping delays angered retailers.\\\",\\n            advantages = listOf(\\\"Destroys groupthink and over-optimism\\\", \\\"Proactive risk mitigation\\\"),\\n            limitations = listOf(\\\"Requires psychological safety to voice failure scenarios\\\"),\\n            keyTakeaway = \\\"Imagining failure in advance is the best way to prevent failure in reality.\\\",\\n            relatedModelIds = listOf(\\\"six_thinking_hats\\\", \\\"project_risk_matrix\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"cynefin_framework\\\",\\n            categoryIds = listOf(\\\"cat2\\\"),\\n            title = \\\"Cynefin Framework\\\",\\n            abbreviation = \\\"Cynefin\\\",\\n            categoryName = \\\"Decision-Making & Problem-Solving\\\",\\n            definition = \\\"A conceptual framework categorizing contexts into Clear, Complicated, Complex, Chaotic, and Confusion domains.\\\",\\n            purpose = \\\"To guide leaders on how to make decisions appropriate to the level of system complexity.\\\",\\n            whenToUse = \\\"When choosing leadership approaches in unfamiliar or shifting business environments.\\\",\\n            steps = listOf(\\n                \\\"Identify domain: Clear (best practice), Complicated (expert analysis), Complex (probe-sense-respond), Chaotic (act-sense-respond).\\\",\\n                \\\"Apply matching leadership decision style.\\\",\\n                \\\"Avoid applying simple rules to complex adaptive environments.\\\"\\n            ),\\n            workplaceExample = \\\"Treating supply chain logistics as Complicated (expert analysis) vs. managing an ongoing cyber breach as Chaotic (immediate containment).\\\",\\n            advantages = listOf(\\\"Prevents applying wrong problem-solving approach\\\", \\\"Enhances strategic awareness\\\"),\\n            limitations = listOf(\\\"Nuanced framework requiring leadership training\\\"),\\n            keyTakeaway = \\\"Effective leaders match their decision-making approach to the specific complexity domain of the problem.\\\",\\n            relatedModelIds = listOf(\\\"vroom_yetton\\\", \\\"six_thinking_hats\\\"),\\n            illustrationType = \\\"cynefin_grid\\\"\\n        ),\\n\\n        // CATEGORY 3 \342\200\224 COMMUNICATION, COACHING, AND PEOPLE DEVELOPMENT\\n        ManagementModel(\\n            id = \\\"grow_coaching\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"GROW Coaching Model\\\",\\n            abbreviation = \\\"GROW\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A coaching framework structured around Goal, Reality, Options, and Will.\\\",\\n            purpose = \\\"To guide employee development and problem-solving through empowering questions rather than giving direct answers.\\\",\\n            whenToUse = \\\"During 1:1 coaching sessions, career development discussions, and mentoring.\\\",\\n            steps = listOf(\\n                \\\"Goal: Establish what the coachee wants to achieve.\\\",\\n                \\\"Reality: Examine the current situation and obstacles.\\\",\\n                \\\"Options: Brainstorm possible solutions and actions.\\\",\\n                \\\"Will: Commit to specific action steps and timeline.\\\"\\n            ),\\n            workplaceExample = \\\"Manager asks: \'What is your career goal?\' (Goal), \'Where do you stand today?\' (Reality), \'What could you try?\' (Options), \'What will you commit to doing by Friday?\' (Will).\\\",\\n            advantages = listOf(\\\"Builds employee autonomy\\\", \\\"Encourages creative problem solving\\\"),\\n            limitations = listOf(\\\"Requires active listening and patience\\\", \\\"Less effective in acute crises\\\"),\\n            keyTakeaway = \\\"Great coaching empowers individuals to find their own solutions through structured inquiry.\\\",\\n            relatedModelIds = listOf(\\\"clear_coaching\\\", \\\"oskar_coaching\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"clear_coaching\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"CLEAR Coaching Model\\\",\\n            abbreviation = \\\"CLEAR\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A coaching framework encompassing Contracting, Listening, Exploring, Action, and Review.\\\",\\n            purpose = \\\"To structure transformational coaching conversations and behavioral change.\\\",\\n            whenToUse = \\\"During intensive coaching and personal transformation discussions.\\\",\\n            steps = listOf(\\n                \\\"Contract: Agree on session goals and boundaries.\\\",\\n                \\\"Listen: Active, empathetic listening.\\\",\\n                \\\"Explore: Uncover underlying issues and perspectives.\\\",\\n                \\\"Action: Agree on concrete next steps.\\\",\\n                \\\"Review: Evaluate progress and learnings.\\\"\\n            ),\\n            workplaceExample = \\\"Structuring a performance improvement coaching conversation starting with a clear contract on session objectives.\\\",\\n            advantages = listOf(\\\"Structured progression\\\", \\\"Strong focus on listening and review\\\"),\\n            limitations = listOf(\\\"Takes time to execute fully\\\"),\\n            keyTakeaway = \\\"Contracting clear session boundaries before deep listening and action planning drives coaching success.\\\",\\n            relatedModelIds = listOf(\\\"grow_coaching\\\", \\\"oskar_coaching\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"oskar_coaching\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"OSKAR Coaching Model\\\",\\n            abbreviation = \\\"OSKAR\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A solution-focused coaching model focusing on Outcome, Scaling, Know-how, Affirm & Action, and Review.\\\",\\n            purpose = \\\"To focus coaching on solutions and strengths rather than dwelling on problem history.\\\",\\n            whenToUse = \\\"When coaching employees toward rapid capability building and positive reinforcement.\\\",\\n            steps = listOf(\\n                \\\"Outcome: What is the desired future?\\\",\\n                \\\"Scaling: Rate current situation on a 1-10 scale.\\\",\\n                \\\"Know-how: Identify what is already working and resources available.\\\",\\n                \\\"Affirm & Action: Praise strengths and define next steps.\\\",\\n                \\\"Review: Track progress.\\\"\\n            ),\\n            workplaceExample = \\\"Asking an employee \'On a scale of 1-10, how confident are you in presenting?\' and exploring how to move from 6 to 8.\\\",\\n            advantages = listOf(\\\"Solution-focused\\\", \\\"Highly encouraging and positive\\\"),\\n            limitations = listOf(\\\"Can gloss over deep systemic root causes\\\"),\\n            keyTakeaway = \\\"Focusing on what is already working accelerates positive performance growth.\\\",\\n            relatedModelIds = listOf(\\\"grow_coaching\\\", \\\"clear_coaching\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"sbi_feedback\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"SBI Feedback Model\\\",\\n            abbreviation = \\\"SBI\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A feedback framework structuring delivery around Situation, Behavior, and Impact.\\\",\\n            purpose = \\\"To deliver objective, non-judgmental feedback that drives behavioral change without triggering defensiveness.\\\",\\n            whenToUse = \\\"During performance reviews, peer feedback, and real-time coaching.\\\",\\n            steps = listOf(\\n                \\\"Situation: Describe the specific time and place.\\\",\\n                \\\"Behavior: Describe observable actions without emotional judgment.\\\",\\n                \\\"Impact: Explain the tangible effect of the behavior on the team or work.\\\"\\n            ),\\n            workplaceExample = \\\"\'During yesterday\'s client pitch (Situation), you interrupted the client twice while they spoke (Behavior), which made them look frustrated and reduced our credibility (Impact).\'\\\",\\n            advantages = listOf(\\\"Eliminates personal attacks\\\", \\\"Highly objective and clear\\\"),\\n            limitations = listOf(\\\"Requires supervisor observation accuracy\\\"),\\n            keyTakeaway = \\\"Isolating the specific situation and observable behavior from its impact prevents defensive reactions.\\\",\\n            relatedModelIds = listOf(\\\"coin_feedback\\\", \\\"radical_candor\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"coin_feedback\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"COIN Feedback Model\\\",\\n            abbreviation = \\\"COIN\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A feedback model covering Context, Observation, Impact, and Next Steps.\\\",\\n            purpose = \\\"To provide actionable, constructive feedback paired with collaborative forward-looking solutions.\\\",\\n            whenToUse = \\\"During 1:1 feedback and employee development discussions.\\\",\\n            steps = listOf(\\n                \\\"Context: Set the scene.\\\",\\n                \\\"Observation: State objective facts observed.\\\",\\n                \\\"Impact: Detail consequences.\\\",\\n                \\\"Next Steps: Agree on future corrective or developmental actions.\\\"\\n            ),\\n            workplaceExample = \\\"Providing feedback on report formatting by noting the context, observing missing charts, explaining impact, and agreeing on template guidelines.\\\",\\n            advantages = listOf(\\\"Action-oriented\\\", \\\"Constructive dialogue\\\"),\\n            limitations = listOf(\\\"Requires mutual trust\\\"),\\n            keyTakeaway = \\\"Pairing objective observations and impacts with collaborative next steps transforms criticism into growth.\\\",\\n            relatedModelIds = listOf(\\\"sbi_feedback\\\", \\\"radical_candor\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"desc_communication\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"DESC Communication Model\\\",\\n            abbreviation = \\\"DESC\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"An assertive communication framework: Describe, Express, Specify, Consequences.\\\",\\n            purpose = \\\"To resolve conflicts and assert professional boundaries constructively.\\\",\\n            whenToUse = \\\"During workplace conflict resolution and difficult conversations.\\\",\\n            steps = listOf(\\n                \\\"Describe the situation objectively.\\\",\\n                \\\"Express feelings and thoughts using \'I\' statements.\\\",\\n                \\\"Specify concrete requested changes.\\\",\\n                \\\"Consequences: Outline positive outcomes of compliance.\\\"\\n            ),\\n            workplaceExample = \\\"\'When deadlines are missed without notice (Describe), I feel stressed about our client commitments (Express). I need updates 24 hours prior (Specify), which will keep our projects on track (Consequences).\'\\\",\\n            advantages = listOf(\\\"Promotes assertiveness\\\", \\\"Reduces interpersonal hostility\\\"),\\n            limitations = listOf(\\\"Requires emotional composure\\\"),\\n            keyTakeaway = \\\"Assertive communication replaces emotional confrontation with clear requests and positive consequences.\\\",\\n            relatedModelIds = listOf(\\\"sbi_feedback\\\", \\\"nonviolent_communication\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"johari_window\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"Johari Window\\\",\\n            abbreviation = \\\"Johari\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A psychological tool for self-awareness and mutual understanding across Open, Blind, Hidden, and Unknown quadrants.\\\",\\n            purpose = \\\"To improve self-awareness and team trust through feedback and self-disclosure.\\\",\\n            whenToUse = \\\"During team building, leadership retreats, and self-reflection workshops.\\\",\\n            steps = listOf(\\n                \\\"Open Area: Known to self and others.\\\",\\n                \\\"Blind Spot: Unknown to self, known to others.\\\",\\n                \\\"Hidden Area: Known to self, unknown to others.\\\",\\n                \\\"Unknown Area: Unknown to self and others.\\\",\\n                \\\"Expand Open area by asking for feedback and sharing self-disclosure.\\\"\\n            ),\\n            workplaceExample = \\\"Receiving feedback that you talk too fast in meetings (reducing Blind Spot) or sharing your design philosophy (reducing Hidden Area).\\\",\\n            advantages = listOf(\\\"Deepens team empathy\\\", \\\"Enhances self-awareness\\\"),\\n            limitations = listOf(\\\"Requires psychological safety and trust\\\"),\\n            keyTakeaway = \\\"Expanding our open self-awareness through feedback and trust builds high-performing teams.\\\",\\n            relatedModelIds = listOf(\\\"active_listening\\\", \\\"360_feedback\\\"),\\n            illustrationType = \\\"matrix_2x2\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"radical_candor\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"Radical Candor Framework\\\",\\n            abbreviation = \\\"Radical Candor\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A feedback framework balancing \'Care Personally\' with \'Challenge Directly\'.\\\",\\n            purpose = \\\"To guide managers on how to give praise and criticism effectively without being aggressive or ruinously empathetic.\\\",\\n            whenToUse = \\\"During day-to-day management, feedback sessions, and culture building.\\\",\\n            steps = listOf(\\n                \\\"Care Personally: Demonstrate genuine human empathy.\\\",\\n                \\\"Challenge Directly: Give honest, unvarnished feedback.\\\",\\n                \\\"Avoid Ruinous Empathy (nice on surface, unhelpful), Manipulative Insincerity, and Obnoxious Aggression.\\\"\\n            ),\\n            workplaceExample = \\\"Telling a team member \'Your slides had formatting errors that hurt our pitch, but I know you can fix them by noon because your content was brilliant.\'\\\",\\n            advantages = listOf(\\\"Builds high trust and high standards\\\", \\\"Prevents unspoken resentment\\\"),\\n            limitations = listOf(\\\"Easily misconstrued as license to be blunt if \'Care Personally\' is missing\\\"),\\n            keyTakeaway = \\\"True leadership demands caring personally while challenging directly.\\\",\\n            relatedModelIds = listOf(\\\"sbi_feedback\\\", \\\"coin_feedback\\\"),\\n            illustrationType = \\\"matrix_2x2\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"nonviolent_communication\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"Nonviolent Communication\\\",\\n            abbreviation = \\\"NVC\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A communication process based on Observations, Feelings, Needs, and Requests.\\\",\\n            purpose = \\\"To resolve conflicts with empathy and clarity without blame or judgment.\\\",\\n            whenToUse = \\\"During negotiations, team conflict resolution, and difficult conversations.\\\",\\n            steps = listOf(\\n                \\\"Observation: State objective facts without evaluation.\\\",\\n                \\\"Feeling: State emotional reaction.\\\",\\n                \\\"Need: Identify universal human need underlying feeling.\\\",\\n                \\\"Request: Make a clear, actionable, positive request.\\\"\\n            ),\\n            workplaceExample = \\\"\'When code is deployed without tests (Observation), I feel anxious (Feeling) because reliability is our priority (Need). Would you run unit tests before merging? (Request).\'\\\",\\n            advantages = listOf(\\\"De-escalates tension\\\", \\\"Builds deep connection\\\"),\\n            limitations = listOf(\\\"Unfamiliar syntax requiring practice\\\"),\\n            keyTakeaway = \\\"Expressing observations, feelings, needs, and requests without blame transforms conflict into connection.\\\",\\n            relatedModelIds = listOf(\\\"desc_communication\\\", \\\"active_listening\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"active_listening\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"Active Listening Framework\\\",\\n            abbreviation = \\\"Active Listening\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A communication technique requiring the listener to fully concentrate, understand, respond, and remember what is being said.\\\",\\n            purpose = \\\"To build trust, ensure accurate understanding, and make speakers feel truly heard.\\\",\\n            whenToUse = \\\"During 1:1s, interviews, conflict resolution, and client discussions.\\\",\\n            steps = listOf(\\n                \\\"Pay attention and give undivided focus.\\\",\\n                \\\"Show evidence of listening (nodding, open posture).\\\",\\n                \\\"Provide feedback by paraphrasing (\'What I hear you saying is...\').\\\",\\n                \\\"Defer judgment and avoid interrupting.\\\"\\n            ),\\n            workplaceExample = \\\"Repeating back a team member\'s software architecture concern in your own words before offering a counter-proposal.\\\",\\n            advantages = listOf(\\\"Deepens trust\\\", \\\"Prevents misunderstandings\\\"),\\n            limitations = listOf(\\\"Requires cognitive effort and presence\\\"),\\n            keyTakeaway = \\\"Listening to understand rather than to reply is the foundation of empathetic leadership.\\\",\\n            relatedModelIds = listOf(\\\"johari_window\\\", \\\"grow_coaching\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"360_feedback\\\",\\n            categoryIds = listOf(\\\"cat3\\\", \\\"cat6\\\"),\\n            title = \\\"360-Degree Feedback\\\",\\n            abbreviation = \\\"360 Review\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A performance evaluation method where feedback comes from supervisors, peers, subordinates, and self-evaluation.\\\",\\n            purpose = \\\"To provide a comprehensive view of a leader\'s strengths and blind spots from all workplace directions.\\\",\\n            whenToUse = \\\"During leadership development programs and annual performance reviews.\\\",\\n            steps = listOf(\\n                \\\"Select raters (peers, managers, direct reports).\\\",\\n                \\\"Administer anonymous competency questionnaires.\\\",\\n                \\\"Aggregate results into comprehensive report.\\\",\\n                \\\"Debrief with executive coach and build development plan.\\\"\\n            ),\\n            workplaceExample = \\\"A director discovers through 360 feedback that while upper management loves her strategy (peers/boss), direct reports feel micromanaged.\\\",\\n            advantages = listOf(\\\"Comprehensive blind-spot visibility\\\", \\\"Democratic feedback\\\"),\\n            limitations = listOf(\\\"Can be abused to settle petty personal scores if anonymous safeguards fail\\\"),\\n            keyTakeaway = \\\"Feedback from all operational directions reveals leadership blind spots that upward reviews miss.\\\",\\n            relatedModelIds = listOf(\\\"johari_window\\\", \\\"idp\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"smart_development_goals\\\",\\n            categoryIds = listOf(\\\"cat3\\\", \\\"cat6\\\"),\\n            title = \\\"SMART Development Goals\\\",\\n            abbreviation = \\\"SMART Dev\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"Applying SMART criteria specifically to professional skills, competencies, and career growth milestones.\\\",\\n            purpose = \\\"To give career growth tangible milestones rather than vague aspirations.\\\",\\n            whenToUse = \\\"During employee career pathing and IDP creation.\\\",\\n            steps = listOf(\\n                \\\"Specific skill or competency target.\\\",\\n                \\\"Measurable certification or project output.\\\",\\n                \\\"Achievable learning curve.\\\",\\n                \\\"Relevant to role trajectory.\\\",\\n                \\\"Time-bound deadline.\\\"\\n            ),\\n            workplaceExample = \\\"Obtaining AWS Cloud Architect certification by the end of Q2.\\\",\\n            advantages = listOf(\\\"Actionable career growth\\\", \\\"Clear skill acquisition\\\"),\\n            limitations = listOf(\\\"Can over-quantify creative learning\\\"),\\n            keyTakeaway = \\\"Turning career aspirations into SMART development milestones ensures professional growth happens on schedule.\\\",\\n            relatedModelIds = listOf(\\\"smart_goals\\\", \\\"idp\\\"),\\n            illustrationType = \\\"smart_goals\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"idp\\\",\\n            categoryIds = listOf(\\\"cat3\\\", \\\"cat6\\\"),\\n            title = \\\"Individual Development Plan\\\",\\n            abbreviation = \\\"IDP\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A personalized roadmap outlining an employee\'s career goals, skill gaps, learning activities, and timelines.\\\",\\n            purpose = \\\"To align personal career aspirations with organizational capability needs.\\\",\\n            whenToUse = \\\"During annual employee reviews and career development planning.\\\",\\n            steps = listOf(\\n                \\\"Assess current competencies and career aspirations.\\\",\\n                \\\"Identify skill gaps.\\\",\\n                \\\"Select development activities (courses, mentoring, stretch assignments).\\\",\\n                \\\"Review progress quarterly.\\\"\\n            ),\\n            workplaceExample = \\\"An accountant wanting to transition to financial planning pairs with a senior analyst for mentorship and takes modeling courses.\\\",\\n            advantages = listOf(\\\"Boosts retention\\\", \\\"Structured career growth\\\"),\\n            limitations = listOf(\\\"Requires ongoing manager support to succeed\\\"),\\n            keyTakeaway = \\\"An individualized development plan turns career ambitions into actionable learning milestones.\\\",\\n            relatedModelIds = listOf(\\\"smart_development_goals\\\", \\\"70_20_10\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"70_20_10_model\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"70\342\200\22320\342\200\22310 Learning Model\\\",\\n            abbreviation = \\\"70-20-10\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A learning framework stating that development occurs 70% from experiential stretch assignments, 20% from developmental relationships, and 10% from formal coursework.\\\",\\n            purpose = \\\"To design balanced and effective professional development programs.\\\",\\n            whenToUse = \\\"When designing corporate training and leadership development curricula.\\\",\\n            steps = listOf(\\n                \\\"70%: Assign stretch projects and operational problem solving.\\\",\\n                \\\"20%: Provide mentoring, coaching, and peer feedback.\\\",\\n                \\\"10%: Provide formal workshops, courses, and reading.\\\"\\n            ),\\n            workplaceExample = \\\"Instead of sending engineers to a 5-day coding seminar (10%), assign them to lead a new microservice migration (70%) with a senior mentor (20%).\\\",\\n            advantages = listOf(\\\"Reflects real-world adult learning\\\", \\\"Cost-effective\\\"),\\n            limitations = listOf(\\\"Requires availability of stretch assignments\\\"),\\n            keyTakeaway = \\\"The vast majority of professional growth happens on the job through hands-on experience and mentorship.\\\",\\n            relatedModelIds = listOf(\\\"idp\\\", \\\"kirkpatrick\\\"),\\n            illustrationType = \\\"pie_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"kirkpatrick\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"Kirkpatrick Four Levels of Training Evaluation\\\",\\n            abbreviation = \\\"Kirkpatrick\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A model evaluating training effectiveness across Reaction, Learning, Behavior, and Results.\\\",\\n            purpose = \\\"To measure whether training investments actually change workplace behavior and business outcomes.\\\",\\n            whenToUse = \\\"When evaluating corporate training programs and leadership academies.\\\",\\n            steps = listOf(\\n                \\\"Level 1 (Reaction): Did trainees like the training?\\\",\\n                \\\"Level 2 (Learning): Did trainees acquire knowledge/skills?\\\",\\n                \\\"Level 3 (Behavior): Are trainees applying new skills on the job?\\\",\\n                \\\"Level 4 (Results): Did the training produce positive business outcomes?\\\"\\n            ),\\n            workplaceExample = \\\"Evaluating sales training not just by smiley face survey (L1) but by tracking whether sales conversion rates increased (L4).\\\",\\n            advantages = listOf(\\\"Comprehensive ROI evaluation of training\\\"),\\n            limitations = listOf(\\\"Levels 3 and 4 are difficult and time-consuming to measure\\\"),\\n            keyTakeaway = \\\"True training effectiveness is measured by behavioral change and business results, not just participant survey smiles.\\\",\\n            relatedModelIds = listOf(\\\"70_20_10\\\", \\\"addie\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"addie\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"ADDIE Instructional Design Model\\\",\\n            abbreviation = \\\"ADDIE\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"An instructional design framework consisting of Analysis, Design, Development, Implementation, and Evaluation.\\\",\\n            purpose = \\\"To create effective, structured learning and training programs.\\\",\\n            whenToUse = \\\"When developing corporate training modules, onboarding curricula, or e-learning courses.\\\",\\n            steps = listOf(\\n                \\\"Analyze learner needs and learning environment.\\\",\\n                \\\"Design learning objectives and assessment methods.\\\",\\n                \\\"Develop course materials and content.\\\",\\n                \\\"Implement and deliver training.\\\",\\n                \\\"Evaluate effectiveness and iterate.\\\"\\n            ),\\n            workplaceExample = \\\"Designing a new cybersecurity compliance training module for remote employees.\\\",\\n            advantages = listOf(\\\"Systematic and robust instructional design\\\"),\\n            limitations = listOf(\\\"Can be slow and linear if rapid prototyping is needed\\\"),\\n            keyTakeaway = \\\"Structured instructional design ensures training programs meet genuine learner needs and educational objectives.\\\",\\n            relatedModelIds = listOf(\\\"kirkpatrick\\\", \\\"blooms_taxonomy\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"blooms_taxonomy\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"Bloom\'s Taxonomy\\\",\\n            abbreviation = \\\"Bloom\'s\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A hierarchical framework categorizing educational learning objectives into Remembering, Understanding, Applying, Analyzing, Evaluating, and Creating.\\\",\\n            purpose = \\\"To design learning curricula progressing from basic recall to complex cognitive mastery.\\\",\\n            whenToUse = \\\"When designing exam questions, training curriculums, and skill assessments.\\\",\\n            steps = listOf(\\n                \\\"Remember: Recall facts and basic concepts.\\\",\\n                \\\"Understand: Explain ideas or concepts.\\\",\\n                \\\"Apply: Use information in new situations.\\\",\\n                \\\"Analyze: Draw connections among ideas.\\\",\\n                \\\"Evaluate: Justify a stand or decision.\\\",\\n                \\\"Create: Produce new or original work.\\\"\\n            ),\\n            workplaceExample = \\\"Designing software training tests that move beyond multiple-choice syntax recall (Remember) to building a secure API endpoint (Apply/Create).\\\",\\n            advantages = listOf(\\\"Clear cognitive progression\\\", \\\"Improves test and training design\\\"),\\n            limitations = listOf(\\\"Hierarchical rigidity can oversimplify fluid learning\\\"),\\n            keyTakeaway = \\\"True educational mastery moves from basic recall up to complex synthesis and creation.\\\",\\n            relatedModelIds = listOf(\\\"addie\\\", \\\"kirkpatrick\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"kolb_learning\\\",\\n            categoryIds = listOf(\\\"cat3\\\"),\\n            title = \\\"Kolb\'s Experiential Learning Cycle\\\",\\n            abbreviation = \\\"Kolb Cycle\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A four-stage experiential learning cycle: Concrete Experience, Reflective Observation, Abstract Conceptualization, and Active Experimentation.\\\",\\n            purpose = \\\"To explain how individuals learn from hands-on experience and reflection.\\\",\\n            whenToUse = \\\"During experiential training, debriefs, and leadership reflection workshops.\\\",\\n            steps = listOf(\\n                \\\"Concrete Experience: Doing or experiencing an activity.\\\",\\n                \\\"Reflective Observation: Reviewing and reflecting on the experience.\\\",\\n                \\\"Abstract Conceptualization: Learning lessons and forming theories.\\\",\\n                \\\"Active Experimentation: Testing new theories in practice.\\\"\\n            ),\\n            workplaceExample = \\\"After a failed client negotiation (Experience), reflecting on why it stalled (Reflection), concluding that pricing must be flexible (Conceptualization), and trying flexible pricing on the next pitch (Experimentation).\\\",\\n            advantages = listOf(\\\"Captures natural human learning\\\", \\\"Bridges theory and practice\\\"),\\n            limitations = listOf(\\\"Requires time for deep reflection\\\"),\\n            keyTakeaway = \\\"Learning is the continuous cycle of experiencing, reflecting, theorizing, and experimenting.\\\",\\n            relatedModelIds = listOf(\\\"70_20_10\\\", \\\"pdca\\\"),\\n            illustrationType = \\\"pdca_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"nine_box_matrix\\\",\\n            categoryIds = listOf(\\\"cat3\\\", \\\"cat6\\\"),\\n            title = \\\"Nine-Box Talent Matrix\\\",\\n            abbreviation = \\\"9-Box\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A talent management grid evaluating employees across Performance and Potential.\\\",\\n            purpose = \\\"To identify high potentials, succession candidates, and performance issues objectively.\\\",\\n            whenToUse = \\\"During annual talent reviews, succession planning, and workforce calibration.\\\",\\n            steps = listOf(\\n                \\\"Assess current performance on horizontal axis (Low, Medium, High).\\\",\\n                \\\"Assess future growth potential on vertical axis (Low, Medium, High).\\\",\\n                \\\"Plot employees into 9 grid boxes.\\\",\\n                \\\"Design targeted development actions for each tier (e.g., retain stars, coach low performers).\\\"\\n            ),\\n            workplaceExample = \\\"Identifying a high-potential, medium-performer as a future director candidate needing stretch assignments.\\\",\\n            advantages = listOf(\\\"Structured talent calibration\\\", \\\"Aids succession planning\\\"),\\n            limitations = listOf(\\\"Subjective manager ratings can introduce bias\\\"),\\n            keyTakeaway = \\\"Evaluating employees on both current performance and future potential ensures robust leadership succession.\\\",\\n            relatedModelIds = listOf(\\\"idp\\\", \\\"skills_gap_analysis\\\"),\\n            illustrationType = \\\"matrix_2x2\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"skills_gap_analysis\\\",\\n            categoryIds = listOf(\\\"cat3\\\", \\\"cat6\\\"),\\n            title = \\\"Skills Gap Analysis\\\",\\n            abbreviation = \\\"Gap Analysis\\\",\\n            categoryName = \\\"Communication, Coaching & People Development\\\",\\n            definition = \\\"A comparative assessment between current workforce skills and future strategic skill requirements.\\\",\\n            purpose = \\\"To identify training needs, hiring priorities, and organizational capability gaps.\\\",\\n            whenToUse = \\\"When adopting new technologies, expanding into new markets, or undergoing restructuring.\\\",\\n            steps = listOf(\\n                \\\"Identify future skill requirements based on business strategy.\\\",\\n                \\\"Audit current employee skills and proficiencies.\\\",\\n                \\\"Compare current vs. required to identify gaps.\\\",\\n                \\\"Formulate training, hiring, or outsourcing plan to bridge gaps.\\\"\\n            ),\\n            workplaceExample = \\\"Realizing the engineering team lacks cloud security skills before migrating to AWS, prompting targeted certifications.\\\",\\n            advantages = listOf(\\\"Targeted training investment\\\", \\\"Proactive workforce planning\\\"),\\n            limitations = listOf(\\\"Skills inventories require regular updates\\\"),\\n            keyTakeaway = \\\"Identifying skill gaps before strategic execution prevents project failure.\\\",\\n            relatedModelIds = listOf(\\\"idp\\\", \\\"nine_box_matrix\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n\\n        // CATEGORY 4 \342\200\224 OPERATIONS MANAGEMENT, QUALITY, AND PROCESS IMPROVEMENT\\n        ManagementModel(\\n            id = \\\"lean\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Lean Management\\\",\\n            abbreviation = \\\"Lean\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"An operational philosophy focused on maximizing customer value while minimizing waste (Muda).\\\",\\n            purpose = \\\"To streamline workflows, reduce lead times, and eliminate non-value-adding activities.\\\",\\n            whenToUse = \\\"When optimizing manufacturing, software delivery, or service operations.\\\",\\n            steps = listOf(\\n                \\\"Identify value from customer perspective.\\\",\\n                \\\"Map the value stream.\\\",\\n                \\\"Create flow by removing bottlenecks.\\\",\\n                \\\"Establish pull based on customer demand.\\\",\\n                \\\"Pursue perfection through continuous improvement.\\\"\\n            ),\\n            workplaceExample = \\\"Removing unnecessary approval sign-offs in a purchase order workflow to speed up delivery.\\\",\\n            advantages = listOf(\\\"Drastically reduces waste and lead times\\\", \\\"Improves efficiency\\\"),\\n            limitations = listOf(\\\"Can create intense pressure if implemented purely as cost-cutting\\\"),\\n            keyTakeaway = \\\"Eliminating waste and maximizing customer value is the engine of operational excellence.\\\",\\n            relatedModelIds = listOf(\\\"six_sigma\\\", \\\"kaizen\\\", \\\"kanban\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"six_sigma\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Six Sigma\\\",\\n            abbreviation = \\\"6\317\203\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A disciplined, data-driven methodology aiming for near-zero defects (3.4 defects per million opportunities).\\\",\\n            purpose = \\\"To eliminate process variation and defects using statistical rigor.\\\",\\n            whenToUse = \\\"For high-precision manufacturing, finance, and quality defect reduction.\\\",\\n            steps = listOf(\\n                \\\"Use DMAIC or DMADV methodologies.\\\",\\n                \\\"Apply statistical process control.\\\",\\n                \\\"Measure process sigma capability.\\\",\\n                \\\"Eliminate root causes of variation.\\\"\\n            ),\\n            workplaceExample = \\\"Reducing medical prescription dispensing errors to fewer than 3.4 per million fills.\\\",\\n            advantages = listOf(\\\"Exceptional quality control\\\", \\\"Data-backed precision\\\"),\\n            limitations = listOf(\\\"Heavy statistical overhead\\\", \\\"Can stifle agile innovation\\\"),\\n            keyTakeaway = \\\"Minimizing process variation yields world-class quality and customer reliability.\\\",\\n            relatedModelIds = listOf(\\\"dmaic\\\", \\\"lean\\\", \\\"spc\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"lean_six_sigma\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Lean Six Sigma\\\",\\n            abbreviation = \\\"LSS\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A methodology combining Lean\'s waste reduction with Six Sigma\'s variation and defect elimination.\\\",\\n            purpose = \\\"To achieve fast, waste-free workflows combined with statistical perfection.\\\",\\n            whenToUse = \\\"For comprehensive enterprise operational transformation.\\\",\\n            steps = listOf(\\n                \\\"Eliminate speed-blocking waste using Lean principles.\\\",\\n                \\\"Eliminate quality defects using Six Sigma statistics.\\\",\\n                \\\"Deploy Green Belt and Black Belt project teams.\\\"\\n            ),\\n            workplaceExample = \\\"Optimizing hospital emergency room admissions to cut wait times (Lean) and reduce medication errors (Six Sigma).\\\",\\n            advantages = listOf(\\\"Best of both worlds: speed + quality\\\"),\\n            limitations = listOf(\\\"Requires significant organizational training investment\\\"),\\n            keyTakeaway = \\\"Combining Lean speed with Six Sigma precision creates unstoppable operational excellence.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"six_sigma\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"tqm\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Total Quality Management\\\",\\n            abbreviation = \\\"TQM\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"An organization-wide commitment to infusing quality into every process, product, and customer interaction.\\\",\\n            purpose = \\\"To foster a permanent culture where all employees take responsibility for quality.\\\",\\n            whenToUse = \\\"During cultural transformations toward customer-centric quality.\\\",\\n            steps = listOf(\\n                \\\"Commitment from top leadership.\\\",\\n                \\\"Customer-focused quality standards.\\\",\\n                \\\"Employee empowerment and training.\\\",\\n                \\\"Continuous process improvement across all departments.\\\"\\n            ),\\n            workplaceExample = \\\"Empowering customer service agents to issue refunds instantly to resolve complaints without management approval.\\\",\\n            advantages = listOf(\\\"Whole-company alignment on quality\\\", \\\"High customer satisfaction\\\"),\\n            limitations = listOf(\\\"Takes years to embed in corporate culture\\\"),\\n            keyTakeaway = \\\"Quality is not just a department; it is the cultural responsibility of every employee.\\\",\\n            relatedModelIds = listOf(\\\"kaizen\\\", \\\"iso_9001\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"kaizen\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Kaizen\\\",\\n            abbreviation = \\\"Kaizen\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A Japanese philosophy of continuous, incremental improvement involving all employees.\\\",\\n            purpose = \\\"To make small, daily improvements that compound into massive operational excellence.\\\",\\n            whenToUse = \\\"In daily workplace operations, gemba walks, and team huddles.\\\",\\n            steps = listOf(\\n                \\\"Identify small inefficiencies in daily work.\\\",\\n                \\\"Encourage frontline staff to propose quick tweaks.\\\",\\n                \\\"Implement immediately and measure impact.\\\",\\n                \\\"Repeat daily.\\\"\\n            ),\\n            workplaceExample = \\\"Warehouse workers rearranging packing tape dispensers closer to boxes, saving 2 seconds per package.\\\",\\n            advantages = listOf(\\\"Empowers frontline staff\\\", \\\"Low cost, high cumulative impact\\\"),\\n            limitations = listOf(\\\"Does not address massive strategic pivots on its own\\\"),\\n            keyTakeaway = \\\"Small, daily, continuous improvements compound into extraordinary operational excellence.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"pdca\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"five_s\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"5S Methodology\\\",\\n            abbreviation = \\\"5S\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A workplace organization methodology: Sort, Set in Order, Shine, Standardize, and Sustain.\\\",\\n            purpose = \\\"To create a clean, organized, safe, and high-efficiency physical or digital workspace.\\\",\\n            whenToUse = \\\"When organizing warehouses, manufacturing floors, or software codebases/desks.\\\",\\n            steps = listOf(\\n                \\\"Sort: Remove unneeded items.\\\",\\n                \\\"Set in Order: Organize tools for ergonomic access.\\\",\\n                \\\"Shine: Clean workspace thoroughly.\\\",\\n                \\\"Standardize: Create rules for maintaining cleanliness.\\\",\\n                \\\"Sustain: Audit and build lifelong habits.\\\"\\n            ),\\n            workplaceExample = \\\"Labeling tool shadow boards in a mechanic shop so missing wrenches are instantly noticeable.\\\",\\n            advantages = listOf(\\\"Reduces searching time\\\", \\\"Improves safety and morale\\\"),\\n            limitations = listOf(\\\"Requires ongoing discipline to maintain\\\"),\\n            keyTakeaway = \\\"A place for everything and everything in its place eliminates operational friction.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"tpm\\\"),\\n            illustrationType = \\\"grid_5\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"tps\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Toyota Production System\\\",\\n            abbreviation = \\\"TPS\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"The pioneering manufacturing system combining Jidoka (automation with human touch) and Just-in-Time production.\\\",\\n            purpose = \\\"To manufacture highest quality products at lowest cost with shortest lead times.\\\",\\n            whenToUse = \\\"As the foundational benchmark for modern manufacturing and Lean operations.\\\",\\n            steps = listOf(\\n                \\\"Eliminate all forms of waste.\\\",\\n                \\\"Implement Just-in-Time (JIT) material flow.\\\",\\n                \\\"Apply Jidoka (stop production immediately when defect occurs).\\\",\\n                \\\"Respect for people and continuous improvement.\\\"\\n            ),\\n            workplaceExample = \\\"Toyota assembly line workers pulling the Andon cord to halt production the moment a defective bolt is spotted.\\\",\\n            advantages = listOf(\\\"Gold standard of manufacturing efficiency\\\", \\\"Zero defect focus\\\"),\\n            limitations = listOf(\\\"Requires highly disciplined supply chain partners\\\"),\\n            keyTakeaway = \\\"Quality at the source and relentless waste elimination define world-class operations.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"jit\\\", \\\"kanban\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"jit\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Just-in-Time\\\",\\n            abbreviation = \\\"JIT\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"An inventory strategy where materials are received only as they are needed in the production process.\\\",\\n            purpose = \\\"To eliminate inventory holding costs and reduce warehouse storage waste.\\\",\\n            whenToUse = \\\"In manufacturing, supply chain, and restaurant inventory management.\\\",\\n            steps = listOf(\\n                \\\"Establish reliable supplier delivery schedules.\\\",\\n                \\\"Produce only what is demanded by next step (pull system).\\\",\\n                \\\"Maintain near-zero buffer stock.\\\"\\n            ),\\n            workplaceExample = \\\"An automotive factory receives tires from suppliers exactly 2 hours before the car chassis reaches the installation station.\\\",\\n            advantages = listOf(\\\"Massive reduction in working capital tied up in inventory\\\", \\\"Lower storage costs\\\"),\\n            limitations = listOf(\\\"Vulnerable to supply chain shocks or supplier delays\\\"),\\n            keyTakeaway = \\\"Delivering materials exactly when needed eliminates costly inventory stockpiles.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"tps\\\", \\\"kanban\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"kanban\\\",\\n            categoryIds = listOf(\\\"cat4\\\", \\\"cat5\\\", \\\"cat9\\\"),\\n            title = \\\"Kanban Method\\\",\\n            abbreviation = \\\"Kanban\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A visual workflow management method using cards and columns to limit work in progress (WIP) and optimize flow.\\\",\\n            purpose = \\\"To visualize bottlenecks, balance workload, and maximize flow efficiency.\\\",\\n            whenToUse = \\\"For software development, marketing tasks, and operations workflow tracking.\\\",\\n            steps = listOf(\\n                \\\"Visualize workflow on board (To Do, Doing, Done).\\\",\\n                \\\"Limit Work in Progress (WIP limits).\\\",\\n                \\\"Manage flow and measure lead time.\\\",\\n                \\\"Improve collaboratively.\\\"\\n            ),\\n            workplaceExample = \\\"A software team setting a WIP limit of 3 items in \'In Progress\' to prevent multitasking and finish features faster.\\\",\\n            advantages = listOf(\\\"Visual clarity\\\", \\\"Prevents team burnout via WIP limits\\\", \\\"Highly flexible\\\"),\\n            limitations = listOf(\\\"Lacks strict time-boxing of Scrum\\\"),\\n            keyTakeaway = \\\"Limiting work-in-progress and visualizing bottlenecks dramatically accelerates task completion.\\\",\\n            relatedModelIds = listOf(\\\"scrum\\\", \\\"lean\\\"),\\n            illustrationType = \\\"kanban_board\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"toc\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Theory of Constraints\\\",\\n            abbreviation = \\\"TOC\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A management paradigm stating that every system has at least one bottleneck (constraint) limiting its total throughput.\\\",\\n            purpose = \\\"To systematically identify and elevate system constraints to maximize throughput.\\\",\\n            whenToUse = \\\"When production lines, software teams, or sales pipelines experience throughput bottlenecks.\\\",\\n            steps = listOf(\\n                \\\"Identify the constraint.\\\",\\n                \\\"Exploit the constraint (maximize its output without extra investment).\\\",\\n                \\\"Subordinate everything else to the constraint.\\\",\\n                \\\"Elevate the constraint (invest resources to expand capacity).\\\",\\n                \\\"Repeat (prevent inertia).\\\"\\n            ),\\n            workplaceExample = \\\"In a bakery where the oven can only bake 50 loaves an hour while mixers can do 200, the oven is the constraint; all prep work is subordinated to oven speed.\\\",\\n            advantages = listOf(\\\"Laser focus on system bottlenecks\\\", \\\"Rapid throughput gains\\\"),\\n            limitations = listOf(\\\"Requires constant re-evaluation as constraints shift\\\"),\\n            keyTakeaway = \\\"Improving any part of a system other than the bottleneck is a waste of time and money.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"value_stream_mapping\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"value_stream_mapping\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Value Stream Mapping\\\",\\n            abbreviation = \\\"VSM\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A Lean flowcharting tool documenting every step required to bring a product or service from origin to customer.\\\",\\n            purpose = \\\"To identify waste, lead times, and process bottlenecks across end-to-end workflows.\\\",\\n            whenToUse = \\\"During Lean transformations and operational audits.\\\",\\n            steps = listOf(\\n                \\\"Map current state material and information flow.\\\",\\n                \\\"Measure process times, changeover times, and inventory queues.\\\",\\n                \\\"Design future state eliminating waste and wait times.\\\",\\n                \\\"Execute implementation plan.\\\"\\n            ),\\n            workplaceExample = \\\"Mapping loan approval from customer application to fund disbursal, revealing 5 days of waiting time between departments.\\\",\\n            advantages = listOf(\\\"Uncovers hidden delay times\\\", \\\"End-to-end operational visibility\\\"),\\n            limitations = listOf(\\\"Can be complex to map across multi-tier enterprises\\\"),\\n            keyTakeaway = \\\"Mapping every step of the value stream exposes hidden wait times and waste.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"toc\\\"),\\n            illustrationType = \\\"value_chain_diagram\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"bpr\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Business Process Reengineering\\\",\\n            abbreviation = \\\"BPR\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"The radical redesign of core business processes to achieve dramatic improvements in cost, quality, and speed.\\\",\\n            purpose = \\\"To achieve breakthrough operational transformation rather than incremental tweaks.\\\",\\n            whenToUse = \\\"When legacy processes are fundamentally broken or facing disruptive market competition.\\\",\\n            steps = listOf(\\n                \\\"Identify customer needs and business vision.\\\",\\n                \\\"Discard old assumptions and legacy processes.\\\",\\n                \\\"Redesign workflows from scratch around modern technology.\\\",\\n                \\\"Implement new operating model.\\\"\\n            ),\\n            workplaceExample = \\\"Replacing paper-based insurance claims with an automated AI portal, cutting processing time from weeks to seconds.\\\",\\n            advantages = listOf(\\\"Dramatic step-change improvements\\\", \\\"Leverages modern technology\\\"),\\n            limitations = listOf(\\\"High risk of failure\\\", \\\"Causes major employee disruption\\\"),\\n            keyTakeaway = \\\"Radical reengineering replaces broken legacy workflows with breakthrough digital processes.\\\",\\n            relatedModelIds = listOf(\\\"bpm\\\", \\\"lean\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"spc\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Statistical Process Control\\\",\\n            abbreviation = \\\"SPC\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A method of quality control using statistical monitoring and control charts to ensure processes operate at peak efficiency.\\\",\\n            purpose = \\\"To detect and correct process variations before defective products are produced.\\\",\\n            whenToUse = \\\"In manufacturing, chemical processing, and automated quality assurance.\\\",\\n            steps = listOf(\\n                \\\"Collect process measurement data.\\\",\\n                \\\"Plot control charts with Upper and Lower Control Limits.\\\",\\n                \\\"Monitor for abnormal special-cause variation.\\\",\\n                \\\"Take corrective action when data points breach limits.\\\"\\n            ),\\n            workplaceExample = \\\"Monitoring bottle-filling weights on a conveyor belt using control charts to catch filling nozzle drift.\\\",\\n            advantages = listOf(\\\"Real-time defect prevention\\\", \\\"Distinguishes normal vs. abnormal variation\\\"),\\n            limitations = listOf(\\\"Requires statistical expertise\\\"),\\n            keyTakeaway = \\\"Statistical control charts catch process drift before defects reach customers.\\\",\\n            relatedModelIds = listOf(\\\"six_sigma\\\", \\\"fmea\\\"),\\n            illustrationType = \\\"pareto_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"fmea\\\",\\n            categoryIds = listOf(\\\"cat4\\\", \\\"cat5\\\", \\\"cat7\\\"),\\n            title = \\\"Failure Mode and Effects Analysis\\\",\\n            abbreviation = \\\"FMEA\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A structured risk assessment method evaluating potential failure modes, their Severity, Occurrence, and Detection (RPN score).\\\",\\n            purpose = \\\"To proactively identify and eliminate potential failures in designs, products, or processes.\\\",\\n            whenToUse = \\\"During product design, engineering prototyping, and process engineering.\\\",\\n            steps = listOf(\\n                \\\"Identify potential failure modes for a process or design.\\\",\\n                \\\"Score Severity (S), Occurrence (O), and Detection (D) from 1 to 10.\\\",\\n                \\\"Calculate Risk Priority Number (RPN = S x O x D).\\\",\\n                \\\"Prioritize and mitigate highest RPN failure modes.\\\"\\n            ),\\n            workplaceExample = \\\"Analyzing airplane engine turbine blade failure risks before manufacturing rollout.\\\",\\n            advantages = listOf(\\\"Proactive risk prevention\\\", \\\"Prioritizes engineering resources\\\"),\\n            limitations = listOf(\\\"Scoring can be subjective\\\"),\\n            keyTakeaway = \\\"Calculating Risk Priority Numbers ensures engineering teams fix the most dangerous potential failures first.\\\",\\n            relatedModelIds = listOf(\\\"risk_matrix\\\", \\\"spc\\\"),\\n            illustrationType = \\\"raci_table\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"poka_yoke\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Poka-Yoke (Error Proofing)\\\",\\n            abbreviation = \\\"Poka-Yoke\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A design technique preventing human errors by making incorrect operation physically impossible.\\\",\\n            purpose = \\\"To achieve zero defects by error-proofing workstation design.\\\",\\n            whenToUse = \\\"On manufacturing assembly lines, software UI forms, and machinery design.\\\",\\n            steps = listOf(\\n                \\\"Identify potential human error points in a process.\\\",\\n                \\\"Design physical or digital constraints making incorrect insertion/action impossible.\\\",\\n                \\\"Test error-proofing mechanism.\\\"\\n            ),\\n            workplaceExample = \\\"SIM cards notched in one corner so they can only be inserted correctly into phones.\\\",\\n            advantages = listOf(\\\"Eliminates human error\\\", \\\"Inexpensive and highly effective\\\"),\\n            limitations = listOf(\\\"Cannot prevent all complex cognitive errors\\\"),\\n            keyTakeaway = \\\"Designing processes so mistakes are physically impossible achieves defect-free operations.\\\",\\n            relatedModelIds = listOf(\\\"lean\\\", \\\"tps\\\", \\\"fmea\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"tpm\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Total Productive Maintenance\\\",\\n            abbreviation = \\\"TPM\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A maintenance methodology keeping all machinery productive through operator involvement and proactive servicing.\\\",\\n            purpose = \\\"To eliminate equipment breakdowns, unplanned downtime, and speed losses.\\\",\\n            whenToUse = \\\"In manufacturing plants, logistics centers, and asset-heavy facilities.\\\",\\n            steps = listOf(\\n                \\\"Perform autonomous maintenance (operators clean and inspect daily).\\\",\\n                \\\"Implement planned maintenance schedules.\\\",\\n                \\\"Provide equipment training.\\\",\\n                \\\"Measure Overall Equipment Effectiveness (OEE).\\\"\\n            ),\\n            workplaceExample = \\\"Machine operators lubricating and inspecting their own CNC milling cutters daily before shift start.\\\",\\n            advantages = listOf(\\\"Maximizes equipment uptime\\\", \\\"Empowers operators\\\"),\\n            limitations = listOf(\\\"Requires cultural discipline and training\\\"),\\n            keyTakeaway = \\\"Proactive equipment maintenance by operators prevents costly unplanned downtime.\\\",\\n            relatedModelIds = listOf(\\\"oee\\\", \\\"lean\\\", \\\"5s\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"oee\\\",\\n            categoryIds = listOf(\\\"cat4\\\", \\\"cat6\\\"),\\n            title = \\\"Overall Equipment Effectiveness\\\",\\n            abbreviation = \\\"OEE\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A metric multiplying Availability, Performance, and Quality to evaluate manufacturing productivity.\\\",\\n            purpose = \\\"To measure true manufacturing productivity and uncover hidden production losses.\\\",\\n            whenToUse = \\\"On factory floors and automated production lines.\\\",\\n            steps = listOf(\\n                \\\"Calculate Availability (Operating Time / Planned Production Time).\\\",\\n                \\\"Calculate Performance (Actual Output / Ideal Speed Output).\\\",\\n                \\\"Calculate Quality (Good Units / Total Units Produced).\\\",\\n                \\\"Multiply: OEE = Availability x Performance x Quality.\\\"\\n            ),\\n            workplaceExample = \\\"A bottling line operating 90% available, running at 80% speed, with 95% quality yields OEE of 68.4%.\\\",\\n            advantages = listOf(\\\"Golden standard metric for manufacturing productivity\\\", \\\"Pinpoints exact loss categories\\\"),\\n            limitations = listOf(\\\"Requires accurate automated data collection\\\"),\\n            keyTakeaway = \\\"OEE exposes the hidden losses of downtime, slow speed, and defects in manufacturing equipment.\\\",\\n            relatedModelIds = listOf(\\\"tpm\\\", \\\"six_sigma\\\"),\\n            illustrationType = \\\"pie_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"sipoc\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"SIPOC Diagram\\\",\\n            abbreviation = \\\"SIPOC\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"A high-level process documentation tool mapping Suppliers, Inputs, Process, Outputs, and Customers.\\\",\\n            purpose = \\\"To define process boundaries and scope before launching improvement projects.\\\",\\n            whenToUse = \\\"At the kickoff of Six Sigma, Lean, or BPM process improvement projects.\\\",\\n            steps = listOf(\\n                \\\"Define Customers who receive output.\\\",\\n                \\\"Define Outputs delivered by process.\\\",\\n                \\\"Map high-level Process steps (5-7 key steps).\\\",\\n                \\\"Identify Inputs required.\\\",\\n                \\\"Identify Suppliers providing inputs.\\\"\\n            ),\\n            workplaceExample = \\\"Mapping customer onboarding by listing IT/Sales as Suppliers, software licenses as Inputs, provisioning as Process, account activation as Output, and new hires as Customers.\\\",\\n            advantages = listOf(\\\"Clear high-level process scope\\\", \\\"Prevents scope creep\\\"),\\n            limitations = listOf(\\\"Lacks granular step-by-step detail\\\"),\\n            keyTakeaway = \\\"Defining Suppliers, Inputs, Processes, Outputs, and Customers aligns project scope instantly.\\\",\\n            relatedModelIds = listOf(\\\"value_stream_mapping\\\", \\\"dmaic\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"sop\\\",\\n            categoryIds = listOf(\\\"cat4\\\"),\\n            title = \\\"Standard Operating Procedures\\\",\\n            abbreviation = \\\"SOP\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"Step-by-step instructions compiled by an organization to help workers carry out routine operations.\\\",\\n            purpose = \\\"To ensure operational consistency, quality, safety, and regulatory compliance.\\\",\\n            whenToUse = \\\"When onboarding staff, standardizing workflows, and maintaining quality audits.\\\",\\n            steps = listOf(\\n                \\\"Document exact step-by-step actions for a task.\\\",\\n                \\\"Include safety warnings and quality checkpoints.\\\",\\n                \\\"Review and approve with subject matter experts.\\\",\\n                \\\"Train staff and audit compliance regularly.\\\"\\n            ),\\n            workplaceExample = \\\"An SOP detailing exact sanitary shutdown steps for a food processing plant.\\\",\\n            advantages = listOf(\\\"Ensures consistency\\\", \\\"Speeds up employee onboarding\\\"),\\n            limitations = listOf(\\\"Can become outdated if not regularly reviewed\\\"),\\n            keyTakeaway = \\\"Well-documented Standard Operating Procedures eliminate operational variance and ensure consistent quality.\\\",\\n            relatedModelIds = listOf(\\\"iso_9001\\\", \\\"5s\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"iso_9001\\\",\\n            categoryIds = listOf(\\\"cat4\\\", \\\"cat7\\\"),\\n            title = \\\"ISO 9001 Quality Management System\\\",\\n            abbreviation = \\\"ISO 9001\\\",\\n            categoryName = \\\"Operations Management, Quality & Process Improvement\\\",\\n            definition = \\\"An international standard setting out requirements for a quality management system (QMS).\\\",\\n            purpose = \\\"To demonstrate organizational ability to consistently provide products meeting customer and regulatory requirements.\\\",\\n            whenToUse = \\\"When bidding for enterprise/government contracts requiring certified quality management.\\\",\\n            steps = listOf(\\n                \\\"Establish quality policy and objectives.\\\",\\n                \\\"Document processes, SOPs, and quality manuals.\\\",\\n                \\\"Implement internal audits and management reviews.\\\",\\n                \\\"Undergo external certification audit.\\\"\\n            ),\\n            workplaceExample = \\\"A manufacturing firm achieving ISO 9001 certification to bid on aerospace supply contracts.\\\",\\n            advantages = listOf(\\\"Global credibility\\\", \\\"Structured quality assurance\\\"),\\n            limitations = listOf(\\\"Can involve heavy documentation overhead\\\"),\\n            keyTakeaway = \\\"ISO 9001 certification provides global assurance of disciplined quality management systems.\\\",\\n            relatedModelIds = listOf(\\\"tqm\\\", \\\"sop\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n\\n        // CATEGORY 5 \342\200\224 PROJECT, PROGRAM, AND PORTFOLIO MANAGEMENT\\n        ManagementModel(\\n            id = \\\"pmbok\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"PMBOK Framework\\\",\\n            abbreviation = \\\"PMBOK\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"The Project Management Body of Knowledge guiding project management across integration, scope, schedule, cost, quality, resource, communication, risk, procurement, and stakeholder management.\\\",\\n            purpose = \\\"To provide a comprehensive professional standard for managing complex projects.\\\",\\n            whenToUse = \\\"For large-scale construction, engineering, and enterprise IT projects.\\\",\\n            steps = listOf(\\n                \\\"Initiating, Planning, Executing, Monitoring & Controlling, Closing.\\\",\\n                \\\"Manage knowledge across 10 core project management areas.\\\"\\n            ),\\n            workplaceExample = \\\"Managing a skyscraper construction project using formal PMBOK change control boards.\\\",\\n            advantages = listOf(\\\"Exhaustive and structured\\\", \\\"Globally recognized standard\\\"),\\n            limitations = listOf(\\\"Can be overly bureaucratic for agile software projects\\\"),\\n            keyTakeaway = \\\"Comprehensive project management spans integration, scope, schedule, cost, quality, and risk.\\\",\\n            relatedModelIds = listOf(\\\"prince2\\\", \\\"wbs\\\", \\\"cpm\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"prince2\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"PRINCE2\\\",\\n            abbreviation = \\\"PRINCE2\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A structured project management method focusing on business justification, defined organization structure, and stage-based control.\\\",\\n            purpose = \\\"To ensure projects remain commercially viable and tightly controlled throughout their lifecycle.\\\",\\n            whenToUse = \\\"For UK government and enterprise projects requiring rigorous governance.\\\",\\n            steps = listOf(\\n                \\\"Ensure continued business justification.\\\",\\n                \\\"Learn from experience, define roles and responsibilities.\\\",\\n                \\\"Manage by stages and manage by exception.\\\"\\n            ),\\n            workplaceExample = \\\"A corporate IT rollout structured into distinct gated management stages with formal board reviews.\\\",\\n            advantages = listOf(\\\"Strong governance\\\", \\\"Clear business case focus\\\"),\\n            limitations = listOf(\\\"Heavy documentation and process overhead\\\"),\\n            keyTakeaway = \\\"Projects must maintain continuous business justification and stage-based governance to succeed.\\\",\\n            relatedModelIds = listOf(\\\"pmbok\\\", \\\"stage_gate\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"agile_project_management\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Agile Project Management\\\",\\n            abbreviation = \\\"Agile\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"An iterative project management approach focused on delivering small, working increments of value rapidly based on customer feedback.\\\",\\n            purpose = \\\"To adapt quickly to changing requirements and deliver continuous value.\\\",\\n            whenToUse = \\\"For software development, startups, and dynamic innovation projects.\\\",\\n            steps = listOf(\\n                \\\"Break project into iterative sprints.\\\",\\n                \\\"Collaborate closely with stakeholders and customers.\\\",\\n                \\\"Deliver working increments frequently.\\\",\\n                \\\"Adapt plans based on continuous feedback.\\\"\\n            ),\\n            workplaceExample = \\\"A software team releasing a new app feature every two weeks based on user beta feedback.\\\",\\n            advantages = listOf(\\\"High adaptability\\\", \\\"Rapid delivery of visible value\\\"),\\n            limitations = listOf(\\\"Less predictable final budget and timeline upfront\\\"),\\n            keyTakeaway = \\\"Agile delivery replaces rigid upfront planning with rapid, iterative value delivery.\\\",\\n            relatedModelIds = listOf(\\\"scrum\\\", \\\"kanban\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"scrum_framework\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Scrum Framework\\\",\\n            abbreviation = \\\"Scrum\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"An Agile framework featuring Sprints, Product Backlogs, Scrum Master, Product Owner, and ceremonies (Daily Standup, Sprint Planning, Review, Retrospective).\\\",\\n            purpose = \\\"To deliver complex products collaboratively in short time-boxed iterations.\\\",\\n            whenToUse = \\\"For software engineering, product teams, and agile project delivery.\\\",\\n            steps = listOf(\\n                \\\"Product Owner maintains prioritized Backlog.\\\",\\n                \\\"Sprint Planning: Select items for 2-week Sprint.\\\",\\n                \\\"Daily Standup: 15-minute sync.\\\",\\n                \\\"Sprint Review & Retrospective: Demo work and inspect/adapt process.\\\"\\n            ),\\n            workplaceExample = \\\"A fintech product team running 2-week sprints with daily standups and retrospectives.\\\",\\n            advantages = listOf(\\\"High transparency\\\", \\\"Strong team accountability and cadence\\\"),\\n            limitations = listOf(\\\"Requires disciplined adherence to roles and time-boxes\\\"),\\n            keyTakeaway = \\\"Scrum ceremonies and time-boxed sprints keep agile teams focused, aligned, and continuously improving.\\\",\\n            relatedModelIds = listOf(\\\"kanban\\\", \\\"agile_project_management\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"waterfall\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Waterfall Methodology\\\",\\n            abbreviation = \\\"Waterfall\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A linear sequential project management approach where each phase must be completed before the next begins.\\\",\\n            purpose = \\\"To manage projects with fixed requirements, strict regulatory compliance, and predictable deliverables.\\\",\\n            whenToUse = \\\"For construction, aerospace, and medical device engineering where requirements cannot change easily.\\\",\\n            steps = listOf(\\n                \\\"Requirements Gathering.\\\",\\n                \\\"System Design.\\\",\\n                \\\"Implementation / Coding.\\\",\\n                \\\"Testing & Verification.\\\",\\n                \\\"Deployment & Maintenance.\\\"\\n            ),\\n            workplaceExample = \\\"Building a bridge where blueprints must be 100% finished and approved before pouring concrete.\\\",\\n            advantages = listOf(\\\"Clear roadmap and budget upfront\\\", \\\"Easy to manage when requirements are fixed\\\"),\\n            limitations = listOf(\\\"Inflexible to mid-project changes\\\", \\\"Testing happens late in the cycle\\\"),\\n            keyTakeaway = \\\"Sequential waterfall planning works well when requirements are fixed and changes are prohibitively expensive.\\\",\\n            relatedModelIds = listOf(\\\"pmbok\\\", \\\"cpm\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"cpm\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Critical Path Method\\\",\\n            abbreviation = \\\"CPM\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A project modeling technique identifying the longest sequence of dependent tasks (critical path) determining minimum project duration.\\\",\\n            purpose = \\\"To schedule complex projects and identify which tasks have float vs. which will delay the entire project.\\\",\\n            whenToUse = \\\"For construction, manufacturing setup, and complex scheduling.\\\",\\n            steps = listOf(\\n                \\\"List all project tasks and duration estimates.\\\",\\n                \\\"Map task dependencies and sequence.\\\",\\n                \\\"Calculate earliest and latest start/finish times.\\\",\\n                \\\"Identify the Critical Path (zero float tasks).\\\"\\n            ),\\n            workplaceExample = \\\"Realizing foundation curing is on the critical path for building construction; delaying it by 2 days delays the entire building opening.\\\",\\n            advantages = listOf(\\\"Identifies exact project bottlenecks\\\", \\\"Optimizes schedule duration\\\"),\\n            limitations = listOf(\\\"Assumes fixed task durations\\\"),\\n            keyTakeaway = \\\"Focusing management attention on the critical path prevents project schedule overruns.\\\",\\n            relatedModelIds = listOf(\\\"pert\\\", \\\"wbs\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"pert\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Program Evaluation and Review Technique\\\",\\n            abbreviation = \\\"PERT\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A project scheduling tool using probabilistic time estimates (Optimistic, Most Likely, Pessimistic) to calculate task durations.\\\",\\n            purpose = \\\"To manage uncertainty and schedule risk in complex R&D or engineering projects.\\\",\\n            whenToUse = \\\"When project task durations are uncertain or unprecedented.\\\",\\n            steps = listOf(\\n                \\\"Estimate Optimistic (O), Most Likely (M), and Pessimistic (P) durations.\\\",\\n                \\\"Calculate expected time: TE = (O + 4M + P) / 6.\\\",\\n                \\\"Build network schedule and evaluate variance.\\\"\\n            ),\\n            workplaceExample = \\\"Estimating timeline for a novel vaccine manufacturing plant where exact equipment delivery times are uncertain.\\\",\\n            advantages = listOf(\\\"Accounts for uncertainty and risk in scheduling\\\"),\\n            limitations = listOf(\\\"Complex math calculations required\\\"),\\n            keyTakeaway = \\\"Using optimistic, most likely, and pessimistic estimates builds realistic schedules under uncertainty.\\\",\\n            relatedModelIds = listOf(\\\"cpm\\\", \\\"project_risk_matrix\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"evm\\\",\\n            categoryIds = listOf(\\\"cat5\\\", \\\"cat6\\\", \\\"cat8\\\"),\\n            title = \\\"Earned Value Management\\\",\\n            abbreviation = \\\"EVM\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A project control methodology integrating scope, schedule, and cost to measure project performance.\\\",\\n            purpose = \\\"To track whether a project is ahead/behind schedule and under/over budget objectively.\\\",\\n            whenToUse = \\\"For large government, defense, and enterprise construction/IT projects.\\\",\\n            steps = listOf(\\n                \\\"Track Planned Value (PV), Earned Value (EV), and Actual Cost (AC).\\\",\\n                \\\"Calculate Schedule Performance Index (SPI = EV / PV).\\\",\\n                \\\"Calculate Cost Performance Index (CPI = EV / AC).\\\",\\n                \\\"Forecast project completion cost and schedule.\\\"\\n            ),\\n            workplaceExample = \\\"An IT project with CPI of 0.85 indicates for every $1 spent, only $0.85 of value is earned, signaling budget overrun.\\\",\\n            advantages = listOf(\\\"Early warning system for cost and schedule overruns\\\", \\\"Objective metrics\\\"),\\n            limitations = listOf(\\\"Requires meticulous baseline tracking\\\"),\\n            keyTakeaway = \\\"Earned Value Management provides objective metrics revealing true cost and schedule health.\\\",\\n            relatedModelIds = listOf(\\\"pmbok\\\", \\\"cpm\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"wbs\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Work Breakdown Structure\\\",\\n            abbreviation = \\\"WBS\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A hierarchical decomposition of a project into smaller, manageable deliverables and work packages.\\\",\\n            purpose = \\\"To break complex projects into organized, estimable components.\\\",\\n            whenToUse = \\\"During project planning, scoping, and budgeting.\\\",\\n            steps = listOf(\\n                \\\"Define ultimate project deliverable.\\\",\\n                \\\"Decompose into major project phases.\\\",\\n                \\\"Break phases down into sub-deliverables and work packages.\\\",\\n                \\\"Assign ownership and cost estimates.\\\"\\n            ),\\n            workplaceExample = \\\"Breaking a mobile app project into WBS levels: App -> Authentication Module -> Login Screen -> UI Layout & API Integration.\\\",\\n            advantages = listOf(\\\"Prevents overlooked deliverables\\\", \\\"Clarifies scope boundaries\\\"),\\n            limitations = listOf(\\\"Can become overly granular if overdone\\\"),\\n            keyTakeaway = \\\"Decomposing complex projects into hierarchical work packages ensures complete scope coverage.\\\",\\n            relatedModelIds = listOf(\\\"pmbok\\\", \\\"cpm\\\", \\\"raci_matrix\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"moscow\\\",\\n            categoryIds = listOf(\\\"cat1\\\", \\\"cat2\\\", \\\"cat5\\\", \\\"cat9\\\"),\\n            title = \\\"MoSCoW Prioritization\\\",\\n            abbreviation = \\\"MoSCoW\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A prioritization technique categorizing requirements into Must have, Should have, Could have, and Won\'t have.\\\",\\n            purpose = \\\"To reach stakeholder consensus on feature scope and delivery priorities under tight deadlines.\\\",\\n            whenToUse = \\\"During software release planning, project scoping, and agile backlog grooming.\\\",\\n            steps = listOf(\\n                \\\"Must have: Non-negotiable core requirements.\\\",\\n                \\\"Should have: Important but not vital for launch.\\\",\\n                \\\"Could have: Desirable nice-to-haves if time permits.\\\",\\n                \\\"Won\'t have: Out of scope for current iteration.\\\"\\n            ),\\n            workplaceExample = \\\"For an e-commerce checkout launch: Credit card processing is \'Must have\', Apple Pay is \'Should have\', Dark mode is \'Could have\', Crypto payment is \'Won\'t have\'.\\\",\\n            advantages = listOf(\\\"Prevents scope creep\\\", \\\"Aligns stakeholders on hard trade-offs\\\"),\\n            limitations = listOf(\\\"Stakeholders often want everything classified as \'Must have\'\\\"),\\n            keyTakeaway = \\\"Categorizing requirements into Must, Should, Could, and Won\'t have prevents scope creep on projects.\\\",\\n            relatedModelIds = listOf(\\\"impact_effort_matrix\\\", \\\"agile_project_management\\\"),\\n            illustrationType = \\\"raci_table\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"raid_log\\\",\\n            categoryIds = listOf(\\\"cat5\\\", \\\"cat7\\\"),\\n            title = \\\"RAID Log\\\",\\n            abbreviation = \\\"RAID\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A project governance log tracking Risks, Assumptions, Issues, and Dependencies.\\\",\\n            purpose = \\\"To maintain centralized visibility over critical project uncertainties and roadblocks.\\\",\\n            whenToUse = \\\"Throughout project execution, status meetings, and steering committee reviews.\\\",\\n            steps = listOf(\\n                \\\"Risks: Track potential future threats and mitigation plans.\\\",\\n                \\\"Assumptions: Document operating assumptions and validate them.\\\",\\n                \\\"Issues: Track active problems requiring resolution.\\\",\\n                \\\"Dependencies: Track cross-team and vendor deliverables.\\\"\\n            ),\\n            workplaceExample = \\\"Logging that database migration depends on third-party API release (Dependency) and tracking server downtime risk (Risk).\\\",\\n            advantages = listOf(\\\"Centralized risk visibility\\\", \\\"Prevents surprises\\\"),\\n            limitations = listOf(\\\"Requires active maintenance to remain useful\\\"),\\n            keyTakeaway = \\\"A well-maintained RAID log keeps project risks, assumptions, issues, and dependencies visible to all stakeholders.\\\",\\n            relatedModelIds = listOf(\\\"project_risk_matrix\\\", \\\"pmbok\\\"),\\n            illustrationType = \\\"raci_table\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"project_risk_matrix\\\",\\n            categoryIds = listOf(\\\"cat5\\\", \\\"cat7\\\"),\\n            title = \\\"Project Risk Matrix\\\",\\n            abbreviation = \\\"Risk Matrix\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A 5x5 grid evaluating risks by Likelihood vs. Impact to prioritize mitigation strategies.\\\",\\n            purpose = \\\"To focus risk management resources on high-likelihood, high-impact threats.\\\",\\n            whenToUse = \\\"During project risk planning and ongoing status reviews.\\\",\\n            steps = listOf(\\n                \\\"Identify project risks.\\\",\\n                \\\"Score Likelihood (1-5) and Impact (1-5).\\\",\\n                \\\"Plot on matrix (High, Medium, Low risk zones).\\\",\\n                \\\"Assign mitigation owners for high-risk items.\\\"\\n            ),\\n            workplaceExample = \\\"Key developer quitting has High Impact and Medium Likelihood, prompting cross-training documentation mitigation.\\\",\\n            advantages = listOf(\\\"Visual risk prioritization\\\", \\\"Guides mitigation investment\\\"),\\n            limitations = listOf(\\\"Subjective scoring\\\"),\\n            keyTakeaway = \\\"Plotting risks by likelihood and impact ensures mitigation efforts target the most dangerous threats first.\\\",\\n            relatedModelIds = listOf(\\\"fmea\\\", \\\"raid_log\\\"),\\n            illustrationType = \\\"matrix_2x2\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"ccpm\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Critical Chain Project Management\\\",\\n            abbreviation = \\\"CCPM\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A project management method focusing on resource availability and buffer management rather than task completion dates.\\\",\\n            purpose = \\\"To eliminate multitasking, student syndrome, and Parkinson\'s Law to shorten project delivery times.\\\",\\n            whenToUse = \\\"For complex multi-project resource scheduling.\\\",\\n            steps = listOf(\\n                \\\"Identify critical chain based on resource constraints.\\\",\\n                \\\"Remove safety margins from individual tasks and aggregate into project buffer.\\\",\\n                \\\"Manage buffer consumption rates rather than task deadlines.\\\"\\n            ),\\n            workplaceExample = \\\"Consolidating scattered task padding into a single project buffer monitored weekly by management.\\\",\\n            advantages = listOf(\\\"Shortens project schedules\\\", \\\"Prevents multitasking waste\\\"),\\n            limitations = listOf(\\\"Cultural shift required to abandon traditional milestone deadlines\\\"),\\n            keyTakeaway = \\\"Aggregating safety buffers protects project completion dates from Parkinson\'s Law and multitasking delays.\\\",\\n            relatedModelIds = listOf(\\\"cpm\\\", \\\"toc\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"stage_gate\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Stage-Gate Model\\\",\\n            abbreviation = \\\"Stage-Gate\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A new product development process dividing innovation into distinct stages separated by quality gates.\\\",\\n            purpose = \\\"To kill unviable projects early and allocate funding only to high-potential innovations.\\\",\\n            whenToUse = \\\"For R&D pipeline management and new product development.\\\",\\n            steps = listOf(\\n                \\\"Stage 1: Scoping -> Gate 1: Go/Kill decision.\\\",\\n                \\\"Stage 2: Business Case -> Gate 2.\\\",\\n                \\\"Stage 3: Development -> Gate 3.\\\",\\n                \\\"Stage 4: Testing -> Gate 4.\\\",\\n                \\\"Stage 5: Launch.\\\"\\n            ),\\n            workplaceExample = \\\"Pharmaceutical R&D reviewing drug candidates at strict clinical trial gates before funding Phase 3.\\\",\\n            advantages = listOf(\\\"Mitigates risk of costly failed product launches\\\", \\\"Disciplined governance\\\"),\\n            limitations = listOf(\\\"Can slow down innovation if gates become bureaucratic\\\"),\\n            keyTakeaway = \\\"Strict stage-gates kill unviable projects early, conserving capital for winning innovations.\\\",\\n            relatedModelIds = listOf(\\\"prince2\\\", \\\"pmbok\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"safe\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Scaled Agile Framework\\\",\\n            abbreviation = \\\"SAFe\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A knowledge base for implementing agile practices at enterprise scale across teams, programs, and portfolios.\\\",\\n            purpose = \\\"To align large enterprises around agile product delivery.\\\",\\n            whenToUse = \\\"When large corporations with hundreds of developers need to synchronize agile releases.\\\",\\n            steps = listOf(\\n                \\\"Align teams around Agile Release Trains (ARTs).\\\",\\n                \\\"Synchronize PI (Program Increment) planning.\\\",\\n                \\\"Establish portfolio governance and lean budgeting.\\\"\\n            ),\\n            workplaceExample = \\\"A major bank synchronizing 50 software teams across a single 12-week program increment release train.\\\",\\n            advantages = listOf(\\\"Enables enterprise-wide agile alignment\\\", \\\"Bridges agile teams with corporate governance\\\"),\\n            limitations = listOf(\\\"Can become overly bureaucratic and heavy (\'Scaled Agile Bureaucracy\')\\\"),\\n            keyTakeaway = \\\"Scaling agile across large enterprises requires synchronizing teams around shared program increments and release trains.\\\",\\n            relatedModelIds = listOf(\\\"scrum_framework\\\", \\\"agile_project_management\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"ppm\\\",\\n            categoryIds = listOf(\\\"cat5\\\"),\\n            title = \\\"Project Portfolio Management\\\",\\n            abbreviation = \\\"PPM\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"Centralized management of an organization\'s projects and programs to align with strategic objectives and maximize ROI.\\\",\\n            purpose = \\\"To select and prioritize the right mix of projects within resource and budget constraints.\\\",\\n            whenType = \\\"During corporate budgeting and strategic resource planning.\\\",\\n            whenToUse = \\\"When balancing corporate project investments.\\\",\\n            steps = listOf(\\n                \\\"Inventory all proposed and active projects.\\\",\\n                \\\"Evaluate strategic alignment and ROI.\\\",\\n                \\\"Prioritize and select portfolio mix based on resource capacity.\\\",\\n                \\\"Monitor portfolio performance.\\\"\\n            ),\\n            workplaceExample = \\\"An enterprise IT steering committee evaluating 30 IT project proposals and funding the top 10 aligned with digital strategy.\\\",\\n            advantages = listOf(\\\"Aligns projects with corporate strategy\\\", \\\"Prevents resource over-allocation\\\"),\\n            limitations = listOf(\\\"Complex governance required\\\"),\\n            keyTakeaway = \\\"Portfolio management ensures capital is invested only in projects delivering maximum strategic ROI.\\\",\\n            relatedModelIds = listOf(\\\"pmbok\\\", \\\"balanced_scorecard\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"benefits_realization\\\",\\n            categoryIds = listOf(\\\"cat5\\\", \\\"cat6\\\"),\\n            title = \\\"Benefits Realization Management\\\",\\n            abbreviation = \\\"BRM\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A practice ensuring that projects deliver the intended business benefits and strategic value post-implementation.\\\",\\n            purpose = \\\"To bridge the gap between project delivery (outputs) and business value (outcomes).\\\",\\n            whenToUse = \\\"During project closure and post-implementation reviews.\\\",\\n            steps = listOf(\\n                \\\"Identify intended benefits during project initiation.\\\",\\n                \\\"Assign benefit owners.\\\",\\n                \\\"Track benefit realization metrics 6-12 months post-project close.\\\"\\n            ),\\n            workplaceExample = \\\"Tracking whether a new enterprise software system actually reduced customer churn 6 months after go-live.\\\",\\n            advantages = listOf(\\\"Ensures projects deliver true business value\\\", \\\"Accountability for outcomes\\\"),\\n            limitations = listOf(\\\"Requires post-project tracking discipline\\\"),\\n            keyTakeaway = \\\"Projects deliver outputs, but successful benefits realization management ensures they deliver enduring business value.\\\",\\n            relatedModelIds = listOf(\\\"balanced_scorecard\\\", \\\"pmbok\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"monte_carlo\\\",\\n            categoryIds = listOf(\\\"cat5\\\", \\\"cat8\\\"),\\n            title = \\\"Monte Carlo Simulation for Project Risk\\\",\\n            abbreviation = \\\"Monte Carlo\\\",\\n            categoryName = \\\"Project, Program & Portfolio Management\\\",\\n            definition = \\\"A computerized mathematical technique generating thousands of probabilistic outcome simulations to evaluate project schedule and cost risk.\\\",\\n            purpose = \\\"To model project uncertainty and forecast probability distributions of completion dates and budgets.\\\",\\n            whenToUse = \\\"For high-risk megaprojects, construction estimating, and financial modeling.\\\",\\n            steps = listOf(\\n                \\\"Define task duration ranges (min, most likely, max).\\\",\\n                \\\"Run 10,000 computer simulation iterations.\\\",\\n                \\\"Analyze probability distribution curve (e.g., 80% confidence date).\\\"\\n            ),\\n            workplaceExample = \\\"Simulating bridge construction costs 10,000 times to determine that there is a 90% chance costs will stay under $45M.\\\",\\n            advantages = listOf(\\\"Accounts for complex compounding risks\\\", \\\"Quantifies confidence intervals\\\"),\\n            limitations = listOf(\\\"Requires specialized software and statistical modeling\\\"),\\n            keyTakeaway = \\\"Monte Carlo simulations replace single-point guesses with rigorous probabilistic risk distributions.\\\",\\n            relatedModelIds = listOf(\\\"pert\\\", \\\"cpm\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n\\n        // CATEGORY 6 \342\200\224 PERFORMANCE MANAGEMENT AND PRODUCTIVITY\\n        ManagementModel(\\n            id = \\\"kpis\\\",\\n            categoryIds = listOf(\\\"cat6\\\"),\\n            title = \\\"Key Performance Indicators\\\",\\n            abbreviation = \\\"KPIs\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"Quantifiable metrics used to evaluate critical organizational or individual performance success.\\\",\\n            purpose = \\\"To measure progress toward strategic goals and guide operational decisions.\\\",\\n            whenToUse = \\\"In executive dashboards, team reviews, and operational monitoring.\\\",\\n            steps = listOf(\\n                \\\"Identify strategic objectives.\\\",\\n                \\\"Select 3-5 leading and lagging indicators.\\\",\\n                \\\"Establish baseline and target values.\\\",\\n                \\\"Monitor via dashboards and review regularly.\\\"\\n            ),\\n            workplaceExample = \\\"Tracking Monthly Recurring Revenue (MRR) and Customer Acquisition Cost (CAC) for a SaaS business.\\\",\\n            advantages = listOf(\\\"Clear quantitative focus\\\", \\\"Objective performance tracking\\\"),\\n            limitations = listOf(\\\"Goodhart\'s Law: when a measure becomes a target, it ceases to be a good measure if gamed\\\"),\\n            keyTakeaway = \\\"Choosing the right Key Performance Indicators keeps teams focused on what truly drives success.\\\",\\n            relatedModelIds = listOf(\\\"smart_goals\\\", \\\"okrs\\\", \\\"balanced_scorecard\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"smart_performance_goals\\\",\\n            categoryIds = listOf(\\\"cat6\\\"),\\n            title = \\\"SMART Performance Goals\\\",\\n            abbreviation = \\\"SMART Perf\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"Applying SMART criteria to employee performance appraisals and bonus targets.\\\",\\n            purpose = \\\"To ensure performance evaluations are objective, transparent, and fair.\\\",\\n            whenToUse = \\\"During annual performance reviews and quarterly goal setting.\\\",\\n            steps = listOf(\\n                \\\"Specific performance deliverable.\\\",\\n                \\\"Measurable output metric.\\\",\\n                \\\"Achievable given role constraints.\\\",\\n                \\\"Relevant to departmental goals.\\\",\\n                \\\"Time-bound review date.\\\"\\n            ),\\n            workplaceExample = \\\"Achieving a customer satisfaction (CSAT) score of over 92% across Q3 support tickets.\\\",\\n            advantages = listOf(\\\"Fair and transparent appraisals\\\", \\\"Eliminates bias\\\"),\\n            limitations = listOf(\\\"Can encourage gaming of specific metrics\\\"),\\n            keyTakeaway = \\\"SMART performance goals make employee reviews objective and transparent.\\\",\\n            relatedModelIds = listOf(\\\"smart_goals\\\", \\\"mbo\\\"),\\n            illustrationType = \\\"smart_goals\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"performance_prism\\\",\\n            categoryIds = listOf(\\\"cat6\\\"),\\n            title = \\\"Performance Prism\\\",\\n            abbreviation = \\\"Prism\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"A performance measurement framework considering five facets: Stakeholder Satisfaction, Strategies, Processes, Capabilities, and Stakeholder Contributions.\\\",\\n            purpose = \\\"To provide a broader stakeholder view than the Balanced Scorecard by including employees, suppliers, and regulators.\\\",\\n            whenToUse = \\\"When designing enterprise performance measurement systems involving diverse stakeholders.\\\",\\n            steps = listOf(\\n                \\\"Identify all stakeholders (not just shareholders and customers).\\\",\\n                \\\"Determine stakeholder wants and needs.\\\",\\n                \\\"Design strategies, processes, and capabilities to deliver.\\\",\\n                \\\"Define what the organization wants from stakeholders.\\\"\\n            ),\\n            workplaceExample = \\\"Measuring supplier satisfaction and regulatory compliance alongside customer metrics.\\\",\\n            advantages = listOf(\\\"Holistic stakeholder view\\\", \\\"Broader than Balanced Scorecard\\\"),\\n            limitations = listOf(\\\"Complex data collection overhead\\\"),\\n            keyTakeaway = \\\"The Performance Prism broadens performance measurement to encompass all key enterprise stakeholders.\\\",\\n            relatedModelIds = listOf(\\\"balanced_scorecard\\\", \\\"stakeholder_analysis\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"benchmarking\\\",\\n            categoryIds = listOf(\\\"cat6\\\"),\\n            title = \\\"Benchmarking\\\",\\n            abbreviation = \\\"Benchmarking\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"The process of measuring business processes and performance metrics against industry bests or competitors.\\\",\\n            purpose = \\\"To identify performance gaps and adopt best practices for operational improvement.\\\",\\n            whenToUse = \\\"During strategic reviews, quality audits, and cost optimization initiatives.\\\",\\n            steps = listOf(\\n                \\\"Identify metric or process to benchmark.\\\",\\n                \\\"Select benchmark partners (internal, competitor, or best-in-class industry leader).\\\",\\n                \\\"Collect data and analyze performance gaps.\\\",\\n                \\\"Implement best practice improvements.\\\"\\n            ),\\n            workplaceExample = \\\"An e-commerce retailer benchmarking their website loading speed against Amazon\'s industry benchmark.\\\",\\n            advantages = listOf(\\\"Provides external reality check\\\", \\\"Accelerates adoption of best practices\\\"),\\n            limitations = listOf(\\\"Hard to obtain accurate competitor data\\\"),\\n            keyTakeaway = \\\"Benchmarking against world-class industry standards reveals operational performance gaps.\\\",\\n            relatedModelIds = listOf(\\\"kpis\\\", \\\"balanced_scorecard\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"performance_improvement_plan\\\",\\n            categoryIds = listOf(\\\"cat6\\\", \\\"cat3\\\"),\\n            title = \\\"Performance Improvement Plan\\\",\\n            abbreviation = \\\"PIP\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"A structured formal tool giving an underperforming employee time and guidance to correct performance issues.\\\",\\n            purpose = \\\"To provide clear remediation milestones before taking termination action.\\\",\\n            whenToUse = \\\"When an employee fails to meet core job expectations over sustained periods.\\\",\\n            steps = listOf(\\n                \\\"Document specific performance deficiencies.\\\",\\n                \\\"Set clear, measurable improvement goals with deadlines (typically 30-90 days).\\\",\\n                \\\"Provide coaching, resources, and weekly check-ins.\\\",\\n                \\\"Evaluate outcome at completion.\\\"\\n            ),\\n            workplaceExample = \\\"A sales rep missing quota for 3 consecutive quarters is placed on a 60-day PIP with weekly call reviews.\\\",\\n            advantages = listOf(\\\"Fair and transparent legal due process\\\", \\\"Clear expectations\\\"),\\n            limitations = listOf(\\\"Often perceived as a precursor to termination rather than genuine rescue\\\"),\\n            keyTakeaway = \\\"A Performance Improvement Plan provides structured guidance and clear milestones for underperforming staff.\\\",\\n            relatedModelIds = listOf(\\\"sbi_feedback\\\", \\\"smart_goals\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"leading_lagging_indicators\\\",\\n            categoryIds = listOf(\\\"cat6\\\"),\\n            title = \\\"Leading and Lagging Indicators\\\",\\n            abbreviation = \\\"Lead/Lag\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"Performance metrics split into predictive leading indicators (driving future results) and historical lagging indicators (measuring past outcomes).\\\",\\n            purpose = \\\"To balance backward-looking results tracking with forward-looking predictive control.\\\",\\n            whenToUse = \\\"When designing balanced executive dashboards and operational scorecards.\\\",\\n            steps = listOf(\\n                \\\"Identify lagging results (e.g., quarterly revenue, profit).\\\",\\n                \\\"Identify leading predictors (e.g., sales calls made, customer meetings booked).\\\",\\n                \\\"Monitor leading indicators daily to forecast and influence lagging outcomes.\\\"\\n            ),\\n            workplaceExample = \\\"Tracking gym visits (leading) to predict weight loss (lagging).\\\",\\n            advantages = listOf(\\\"Predictive foresight\\\", \\\"Enables proactive course correction\\\"),\\n            limitations = listOf(\\\"Leading indicators require validation to ensure they actually predict results\\\"),\\n            keyTakeaway = \\\"Tracking leading indicators allows you to influence future outcomes before lagging results are recorded.\\\",\\n            relatedModelIds = listOf(\\\"kpis\\\", \\\"balanced_scorecard\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"productivity_measurement\\\",\\n            categoryIds = listOf(\\\"cat6\\\", \\\"cat8\\\"),\\n            title = \\\"Productivity Measurement Model\\\",\\n            abbreviation = \\\"Productivity Model\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"Calculates output per unit of input (labor, capital, materials) across operational processes.\\\",\\n            purpose = \\\"To measure efficiency gains and resource utilization.\\\",\\n            whenToUse = \\\"During operational audits, manufacturing reviews, and labor planning.\\\",\\n            steps = listOf(\\n                \\\"Measure total output generated (units produced, revenue earned).\\\",\\n                \\\"Measure total inputs consumed (labor hours, equipment costs, materials).\\\",\\n                \\\"Calculate Productivity Ratio = Output / Input.\\\"\\n            ),\\n            workplaceExample = \\\"Measuring customer support tickets resolved per agent hour.\\\",\\n            advantages = listOf(\\\"Clear efficiency metric\\\", \\\"Highlights productivity trends\\\"),\\n            limitations = listOf(\\\"Focuses on quantity over quality if not carefully managed\\\"),\\n            keyTakeaway = \\\"Measuring output per unit of input is the core of operational productivity tracking.\\\",\\n            relatedModelIds = listOf(\\\"oee\\\", \\\"kpis\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"logic_model\\\",\\n            categoryIds = listOf(\\\"cat6\\\"),\\n            title = \\\"Logic Model\\\",\\n            abbreviation = \\\"Logic Model\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"A systematic visual diagram linking program Inputs, Activities, Outputs, Outcomes, and Impacts.\\\",\\n            purpose = \\\"To evaluate program design and prove how activities lead to long-term impact.\\\",\\n            whenToUse = \\\"During grant writing, program evaluation, and project design.\\\",\\n            steps = listOf(\\n                \\\"Inputs: Resources invested.\\\",\\n                \\\"Activities: Actions taken.\\\",\\n                \\\"Outputs: Direct products/services delivered.\\\",\\n                \\\"Outcomes: Short/medium-term changes for participants.\\\",\\n                \\\"Impact: Long-term fundamental change.\\\"\\n            ),\\n            workplaceExample = \\\"Coding bootcamp mapping funding (Inputs) -> teaching classes (Activities) -> graduates certified (Outputs) -> employed in tech (Outcomes) -> career mobility (Impact).\\\",\\n            advantages = listOf(\\\"Clear causal chain logic\\\", \\\"Great for program evaluation\\\"),\\n            limitations = listOf(\\\"Can oversimplify complex social/business systems\\\"),\\n            keyTakeaway = \\\"A Logic Model maps the exact causal chain from resource inputs to long-term societal or business impact.\\\",\\n            relatedModelIds = listOf(\\\"balanced_scorecard\\\", \\\"okrs\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"performance_dashboard\\\",\\n            categoryIds = listOf(\\\"cat6\\\"),\\n            title = \\\"Performance Dashboard\\\",\\n            abbreviation = \\\"Dashboard\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"A visual user interface displaying key performance metrics and KPIs in real-time.\\\",\\n            purpose = \\\"To provide executives and teams with instant visibility into operational health.\\\",\\n            whenToUse = \\\"For daily executive monitoring, team huddles, and status tracking.\\\",\\n            steps = listOf(\\n                \\\"Select core KPIs.\\\",\\n                \\\"Design visual widget layout (charts, gauges, trend lines).\\\",\\n                \\\"Connect to live data sources.\\\",\\n                \\\"Review daily.\\\"\\n            ),\\n            workplaceExample = \\\"Sales director viewing real-time daily pipeline revenue and conversion rate gauges on a monitor.\\\",\\n            advantages = listOf(\\\"Real-time visibility\\\", \\\"Instant anomaly detection\\\"),\\n            limitations = listOf(\\\"Risk of vanity metrics cluttering view\\\"),\\n            keyTakeaway = \\\"A well-designed performance dashboard provides instant, real-time visibility into operational health.\\\",\\n            relatedModelIds = listOf(\\\"kpis\\\", \\\"balanced_scorecard\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"sla_management\\\",\\n            categoryIds = listOf(\\\"cat6\\\", \\\"cat7\\\"),\\n            title = \\\"Service Level Agreement Management\\\",\\n            abbreviation = \\\"SLA\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"Managing commitments between a service provider and client regarding uptime, response times, and quality standards.\\\",\\n            purpose = \\\"To ensure vendor accountability and maintain reliable operational standards.\\\",\\n            whenToUse = \\\"In IT service management, customer support, and vendor contracting.\\\",\\n            steps = listOf(\\n                \\\"Define service standards (e.g., 99.9% uptime, 1-hour ticket response).\\\",\\n                \\\"Monitor performance metrics continuously.\\\",\\n                \\\"Report on SLA compliance and penalize/reward performance.\\\"\\n            ),\\n            workplaceExample = \\\"Cloud hosting provider committing to 99.99% uptime SLA with financial credits for downtime breaches.\\\",\\n            advantages = listOf(\\\"Clear performance accountability\\\", \\\"Protects client interests\\\"),\\n            limitations = listOf(\\\"Can create perverse incentives if metrics are gamed\\\"),\\n            keyTakeaway = \\\"Clear Service Level Agreements establish enforceable performance standards between providers and clients.\\\",\\n            relatedModelIds = listOf(\\\"kpis\\\", \\\"kpi_dashboards\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"human_capital_roi\\\",\\n            categoryIds = listOf(\\\"cat6\\\", \\\"cat8\\\"),\\n            title = \\\"Human Capital ROI\\\",\\n            abbreviation = \\\"HC-ROI\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"A financial metric measuring the financial return generated by employee wages and benefits.\\\",\\n            purpose = \\\"To evaluate workforce productivity and cost-effectiveness.\\\",\\n            whenToUse = \\\"During financial analysis, HR budgeting, and productivity reviews.\\\",\\n            steps = listOf(\\n                \\\"Calculate Net Value (Revenue minus Operating Expenses excluding labor).\\\",\\n                \\\"Divide by Total Employment Costs (Salaries + Benefits).\\\",\\n                \\\"HC-ROI = (Revenue - Expenses) / Total Labor Costs.\\\"\\n            ),\\n            workplaceExample = \\\"Measuring how much net revenue is generated for every dollar spent on employee payroll.\\\",\\n            advantages = listOf(\\\"Connects HR investment to financial return\\\"),\\n            limitations = listOf(\\\"Does not capture intangible morale or long-term culture value\\\"),\\n            keyTakeaway = \\\"Human Capital ROI measures the financial value generated per dollar of employee payroll investment.\\\",\\n            relatedModelIds = listOf(\\\"eva\\\", \\\"roi\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"economic_value_added\\\",\\n            categoryIds = listOf(\\\"cat6\\\", \\\"cat8\\\"),\\n            title = \\\"Economic Value Added\\\",\\n            abbreviation = \\\"EVA\\\",\\n            categoryName = \\\"Performance Management & Productivity\\\",\\n            definition = \\\"A financial metric measuring true economic profit by deducting the cost of capital from operating profit.\\\",\\n            purpose = \\\"To determine whether a company is truly creating shareholder value above its cost of capital.\\\",\\n            whenToUse = \\\"During corporate financial evaluation and capital budgeting.\\\",\\n            steps = listOf(\\n                \\\"Calculate Net Operating Profit After Tax (NOPAT).\\\",\\n                \\\"Calculate Total Capital Employed multiplied by Cost of Capital.\\\",\\n                \\\"EVA = NOPAT - (Capital x Cost of Capital).\\\"\\n            ),\\n            workplaceExample = \\\"Evaluating whether a manufacturing division\'s profit exceeds the interest cost of capital borrowed to buy machinery.\\\",\\n            advantages = listOf(\\\"True measure of economic profit\\\", \\\"Aligns management with shareholders\\\"),\\n            limitations = listOf(\\\"Complex accounting adjustments required\\\"),\\n            keyTakeaway = \\\"Economic Value Added measures whether a firm generates returns exceeding its cost of capital.\\\",\\n            relatedModelIds = listOf(\\\"npv\\\", \\\"roi\\\", \\\"wacc\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n\\n        // CATEGORY 7 \342\200\224 RISK MANAGEMENT, GOVERNANCE, AND COMPLIANCE\\n        ManagementModel(\\n            id = \\\"iso_31000\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"ISO 31000 Risk Management Framework\\\",\\n            abbreviation = \\\"ISO 31000\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"An international standard providing principles and guidelines for enterprise risk management.\\\",\\n            purpose = \\\"To integrate risk management into all organizational activities and decision-making.\\\",\\n            whenToUse = \\\"When establishing enterprise-wide risk governance systems.\\\",\\n            steps = listOf(\\n                \\\"Establish scope and context.\\\",\\n                \\\"Risk Assessment (Identification, Analysis, Evaluation).\\\",\\n                \\\"Risk Treatment (Mitigation).\\\",\\n                \\\"Monitoring, Review, and Communication.\\\"\\n            ),\\n            workplaceExample = \\\"A global bank embedding ISO 31000 risk principles across loan approval and treasury operations.\\\",\\n            advantages = listOf(\\\"Globally recognized standard\\\", \\\"Comprehensive risk governance\\\"),\\n            limitations = listOf(\\\"High-level guidance requiring customized internal implementation\\\"),\\n            keyTakeaway = \\\"Embedding ISO 31000 risk management principles protects organizations across all operational activities.\\\",\\n            relatedModelIds = listOf(\\\"coso_erm\\\", \\\"risk_matrix\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"coso_erm\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"COSO Enterprise Risk Management\\\",\\n            abbreviation = \\\"COSO ERM\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"An enterprise risk management framework integrating risk with strategy setting across five components and 20 principles.\\\",\\n            purpose = \\\"To help organizations manage risk to create, preserve, and realize value.\\\",\\n            whenToUse = \\\"For corporate governance, board risk oversight, and enterprise compliance.\\\",\\n            steps = listOf(\\n                \\\"Governance & Culture.\\\",\\n                \\\"Strategy & Objective-Setting.\\\",\\n                \\\"Performance.\\\",\\n                \\\"Review & Revision.\\\",\\n                \\\"Information, Communication & Reporting.\\\"\\n            ),\\n            workplaceExample = \\\"A board of directors reviewing cybersecurity risks using COSO ERM governance structures.\\\",\\n            advantages = listOf(\\\"Gold standard for corporate governance\\\", \\\"Connects risk to strategy\\\"),\\n            limitations = listOf(\\\"Extensive framework requiring dedicated compliance resources\\\"),\\n            keyTakeaway = \\\"COSO ERM integrates enterprise risk management directly with corporate strategy and value creation.\\\",\\n            relatedModelIds = listOf(\\\"iso_31000\\\", \\\"coso_internal_control\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"coso_internal_control\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"COSO Internal Control Framework\\\",\\n            abbreviation = \\\"COSO IC\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"A framework establishing internal control across Control Environment, Risk Assessment, Control Activities, Information & Communication, and Monitoring.\\\",\\n            purpose = \\\"To ensure operational efficiency, financial reporting reliability, and regulatory compliance.\\\",\\n            whenToUse = \\\"For Sarbanes-Oxley (SOX) compliance and financial audit preparation.\\\",\\n            steps = listOf(\\n                \\\"Control Environment: Integrity and ethical values.\\\",\\n                \\\"Risk Assessment: Identify financial/fraud risks.\\\",\\n                \\\"Control Activities: Segregation of duties and approvals.\\\",\\n                \\\"Information & Communication.\\\",\\n                \\\"Monitoring Activities: Internal audits.\\\"\\n            ),\\n            workplaceExample = \\\"Requiring dual authorization for bank wire transfers exceeding $10,000.\\\",\\n            advantages = listOf(\\\"Robust financial controls\\\", \\\"Prevents fraud and errors\\\"),\\n            limitations = listOf(\\\"Can create administrative control bottlenecks\\\"),\\n            keyTakeaway = \\\"Robust internal controls protect financial reporting integrity and prevent fraud.\\\",\\n            relatedModelIds = listOf(\\\"coso_erm\\\", \\\"three_lines_model\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"risk_register\\\",\\n            categoryIds = listOf(\\\"cat5\\\", \\\"cat7\\\"),\\n            title = \\\"Risk Register\\\",\\n            abbreviation = \\\"Risk Register\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"A centralized document tracking identified risks, likelihood, impact, mitigation owners, and status.\\\",\\n            purpose = \\\"To maintain ongoing visibility and accountability for enterprise or project risks.\\\",\\n            whenToUse = \\\"Throughout project execution and enterprise risk reviews.\\\",\\n            steps = listOf(\\n                \\\"Identify risk and assign ID.\\\",\\n                \\\"Score likelihood and impact.\\\",\\n                \\\"Assign mitigation owner.\\\",\\n                \\\"Track status weekly.\\\"\\n            ),\\n            workplaceExample = \\\"Logging server failure risk with mitigation owner DevOps lead and backup failover status.\\\",\\n            advantages = listOf(\\\"Centralized risk tracking\\\", \\\"Ensures accountability\\\"),\\n            limitations = listOf(\\\"Requires disciplined updating\\\"),\\n            keyTakeaway = \\\"A centralized risk register ensures every identified threat has a mitigation owner and tracking status.\\\",\\n            relatedModelIds = listOf(\\\"project_risk_matrix\\\", \\\"raid_log\\\"),\\n            illustrationType = \\\"raci_table\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"bow_tie_analysis\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Bow-Tie Risk Analysis\\\",\\n            abbreviation = \\\"Bow-Tie\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"A visual risk diagram mapping the preventive barriers leading up to a hazardous event and recovery barriers mitigating consequences after.\\\",\\n            purpose = \\\"To evaluate cause-and-effect barriers for high-consequence operational hazards.\\\",\\n            whenToUse = \\\"In aviation, oil and gas, chemical processing, and critical infrastructure safety.\\\",\\n            steps = listOf(\\n                \\\"Identify central hazardous event (the knot of the bow-tie).\\\",\\n                \\\"Map causes on left and preventive barriers.\\\",\\n                \\\"Map consequences on right and recovery/mitigation barriers.\\\"\\n            ),\\n            workplaceExample = \\\"Mapping aircraft engine failure causes (left barriers: maintenance) and emergency landing consequences (right barriers: parachutes, fire suppression).\\\",\\n            advantages = listOf(\\\"Visual barrier clarity\\\", \\\"Connects causes and consequences\\\"),\\n            limitations = listOf(\\\"Focuses on single hazard scenarios at a time\\\"),\\n            keyTakeaway = \\\"Bow-Tie analysis visually maps preventive and recovery barriers around high-consequence hazards.\\\",\\n            relatedModelIds = listOf(\\\"fault_tree\\\", \\\"fmea\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"fault_tree_analysis\\\",\\n            categoryIds = listOf(\\\"cat7\\\", \\\"cat2\\\"),\\n            title = \\\"Fault Tree Analysis\\\",\\n            abbreviation = \\\"FTA\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"A top-down deductive failure analysis using Boolean logic to determine root causes of system hazards.\\\",\\n            purpose = \\\"To calculate system failure probabilities and identify single points of failure.\\\",\\n            whenToUse = \\\"In aerospace, nuclear, medical device, and high-reliability engineering.\\\",\\n            steps = listOf(\\n                \\\"Define top undesired system failure event.\\\",\\n                \\\"Deduce contributing sub-system failures using AND/OR logic gates.\\\",\\n                \\\"Calculate failure probabilities.\\\"\\n            ),\\n            workplaceExample = \\\"Analyzing why an automated braking system failed by evaluating electrical power failure AND sensor malfunction gates.\\\",\\n            advantages = listOf(\\\"Rigorous deductive logic\\\", \\\"Identifies single points of failure\\\"),\\n            limitations = listOf(\\\"Complex mathematical modeling required\\\"),\\n            keyTakeaway = \\\"Fault Tree analysis uses Boolean logic to trace top-level system failures back to root component causes.\\\",\\n            relatedModelIds = listOf(\\\"bow_tie_analysis\\\", \\\"fmea\\\"),\\n            illustrationType = \\\"decision_tree\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"business_impact_analysis\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Business Impact Analysis\\\",\\n            abbreviation = \\\"BIA\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"An analysis determining the financial and operational impacts of disruptions to critical business functions.\\\",\\n            purpose = \\\"To establish Recovery Time Objectives (RTO) and Recovery Point Objectives (RPO) for disaster planning.\\\",\\n            whenToUse = \\\"During business continuity and disaster recovery planning.\\\",\\n            steps = listOf(\\n                \\\"Identify critical business functions.\\\",\\n                \\\"Assess financial and operational impacts over time of disruption.\\\",\\n                \\\"Determine maximum tolerable downtime (MTD).\\\",\\n                \\\"Establish RTO and RPO targets.\\\"\\n            ),\\n            workplaceExample = \\\"Determining that if the e-commerce checkout server goes down for more than 30 minutes, revenue loss exceeds $500,000.\\\",\\n            advantages = listOf(\\\"Identifies critical operational dependencies\\\", \\\"Guides disaster recovery investment\\\"),\\n            limitations = listOf(\\\"Requires estimation under uncertainty\\\"),\\n            keyTakeaway = \\\"Business Impact Analysis defines recovery time objectives by measuring the cost of operational disruptions.\\\",\\n            relatedModelIds = listOf(\\\"business_continuity_planning\\\", \\\"disaster_recovery\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"business_continuity_planning\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Business Continuity Planning\\\",\\n            abbreviation = \\\"BCP\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"Creating systems and procedures to ensure an organization can continue operating during unplanned disruptions.\\\",\\n            purpose = \\\"To safeguard employees, maintain critical operations, and protect brand reputation during crises.\\\",\\n            whenToUse = \\\"When preparing for natural disasters, cyber attacks, pandemics, or supply chain shocks.\\\",\\n            steps = listOf(\\n                \\\"Conduct Business Impact Analysis (BIA).\\\",\\n                \\\"Develop continuity and fallback procedures.\\\",\\n                \\\"Establish alternate work sites and cloud backups.\\\",\\n                \\\"Test plans with simulated disaster drills.\\\"\\n            ),\\n            workplaceExample = \\\"A bank establishing secondary hot-site data centers so operations resume within 1 hour of primary data center failure.\\\",\\n            advantages = listOf(\\\"Ensures organizational survival during crises\\\", \\\"Protects revenue\\\"),\\n            limitations = listOf(\\\"Ongoing maintenance and testing overhead\\\"),\\n            keyTakeaway = \\\"Business continuity planning ensures organizations survive unexpected crises and resume operations rapidly.\\\",\\n            relatedModelIds = listOf(\\\"business_impact_analysis\\\", \\\"disaster_recovery\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"disaster_recovery\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Disaster Recovery Planning\\\",\\n            abbreviation = \\\"DRP\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"IT-focused procedures and policies restoring hardware, software, and data after natural or man-made disasters.\\\",\\n            purpose = \\\"To recover critical IT infrastructure and data with minimal data loss.\\\",\\n            whenToUse = \\\"When designing IT cloud architectures and enterprise data backups.\\\",\\n            steps = listOf(\\n                \\\"Identify critical IT systems and data.\\\",\\n                \\\"Establish offsite data replication and backups.\\\",\\n                \\\"Define failover protocols.\\\",\\n                \\\"Test disaster recovery restoration drills.\\\"\\n            ),\\n            workplaceExample = \\\"Replicating AWS databases across multi-region availability zones for instant automatic failover.\\\",\\n            advantages = listOf(\\\"Protects against catastrophic data loss\\\", \\\"Rapid IT restoration\\\"),\\n            limitations = listOf(\\\"Cloud backup and replication costs\\\"),\\n            keyTakeaway = \\\"Disaster recovery planning ensures IT infrastructure and data survive catastrophic outages.\\\",\\n            relatedModelIds = listOf(\\\"business_continuity_planning\\\", \\\"nist_cybersecurity\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"three_lines_model\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Three Lines Model\\\",\\n            abbreviation = \\\"Three Lines\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"An IIA governance model separating roles across Operational Management (1st line), Risk & Compliance oversight (2nd line), and Internal Audit (3rd line).\\\",\\n            purpose = \\\"To ensure robust governance, risk management, and independent oversight without role conflicts.\\\",\\n            whenToUse = \\\"When structuring corporate governance, audit committees, and risk management departments.\\\",\\n            steps = listOf(\\n                \\\"1st Line (Management): Owns and manages risks operationally.\\\",\\n                \\\"2nd Line (Risk & Compliance): Oversees and challenges risk management practices.\\\",\\n                \\\"3rd Line (Internal Audit): Provides independent objective assurance to board.\\\",\\n                \\\"Governing Body: Ultimate accountability to stakeholders.\\\"\\n            ),\\n            workplaceExample = \\\"Loan officers approve loans (1st line), risk officers set lending limits (2nd line), and internal auditors review sample loan files (3rd line).\\\",\\n            advantages = listOf(\\\"Clear separation of duties\\\", \\\"Robust independent oversight\\\"),\\n            limitations = listOf(\\\"Requires careful coordination to avoid bureaucratic friction\\\"),\\n            keyTakeaway = \\\"Separating operational management, risk oversight, and internal audit ensures robust governance integrity.\\\",\\n            relatedModelIds = listOf(\\\"coso_erm\\\", \\\"coso_internal_control\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"grc\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Governance, Risk and Compliance\\\",\\n            abbreviation = \\\"GRC\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"An integrated strategy combining corporate governance, enterprise risk management, and regulatory compliance.\\\",\\n            purpose = \\\"To align IT and business operations with regulatory rules while mitigating risk efficiently.\\\",\\n            whenToUse = \\\"In highly regulated industries such as finance, healthcare, and energy.\\\",\\n            steps = listOf(\\n                \\\"Establish governance policies.\\\",\\n                \\\"Monitor enterprise risks.\\\",\\n                \\\"Ensure compliance with laws (GDPR, HIPAA, SOX, etc.).\\\",\\n                \\\"Automate reporting dashboards.\\\"\\n            ),\\n            workplaceExample = \\\"A fintech company utilizing GRC software to track GDPR privacy compliance and SOC2 audits.\\\",\\n            advantages = listOf(\\\"Holistic compliance management\\\", \\\"Reduces regulatory penalty risks\\\"),\\n            limitations = listOf(\\\"Complex software integration required\\\"),\\n            keyTakeaway = \\\"Integrating governance, risk, and compliance protects organizations from regulatory fines and reputational damage.\\\",\\n            relatedModelIds = listOf(\\\"coso_erm\\\", \\\"iso_31000\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"cobit_framework\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"COBIT Framework\\\",\\n            abbreviation = \\\"COBIT\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"An ISACA framework for the governance and management of enterprise information and technology (I&T).\\\",\\n            purpose = \\\"To ensure IT investments deliver value while mitigating cybersecurity and operational risks.\\\",\\n            whenToUse = \\\"For IT governance audits, CIO strategy planning, and enterprise IT management.\\\",\\n            steps = listOf(\\n                \\\"Provide stakeholder value.\\\",\\n                \\\"Holistic governance approach.\\\",\\n                \\\"Dynamic governance system.\\\",\\n                \\\"Govern vs. Manage separation.\\\"\\n            ),\\n            workplaceExample = \\\"An enterprise IT department adopting COBIT governance to align IT security spending with board risk appetite.\\\",\\n            advantages = listOf(\\\"World-class IT governance\\\", \\\"Bridges business goals with IT execution\\\"),\\n            limitations = listOf(\\\"Heavy framework requiring specialized IT auditors\\\"),\\n            keyTakeaway = \\\"COBIT provides governance ensuring enterprise IT delivers value while managing cyber and operational risks.\\\",\\n            relatedModelIds = listOf(\\\"nist_cybersecurity\\\", \\\"grc\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"nist_cybersecurity\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"NIST Cybersecurity Framework\\\",\\n            abbreviation = \\\"NIST CSF\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"A cybersecurity standard built around five core functions: Identify, Protect, Detect, Respond, and Recover.\\\",\\n            purpose = \\\"To help organizations assess, prevent, and respond to cybersecurity threats.\\\",\\n            whenToUse = \\\"For information security audits, cyber risk management, and IT infrastructure defense.\\\",\\n            steps = listOf(\\n                \\\"Identify: Asset management and risk assessment.\\\",\\n                \\\"Protect: Access control and data encryption.\\\",\\n                \\\"Detect: Continuous anomaly monitoring.\\\",\\n                \\\"Respond: Incident response planning.\\\",\\n                \\\"Recover: Disaster restoration.\\\"\\n            ),\\n            workplaceExample = \\\"A healthcare provider implementing NIST controls to protect patient records from ransomware attacks.\\\",\\n            advantages = listOf(\\\"Gold standard cybersecurity framework\\\", \\\"Widely adopted globally\\\"),\\n            limitations = listOf(\\\"Requires ongoing technical auditing\\\"),\\n            keyTakeaway = \\\"Identifying, protecting, detecting, responding, and recovering forms the essential shield against cyber threats.\\\",\\n            relatedModelIds = listOf(\\\"disaster_recovery\\\", \\\"cobit_framework\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"nist_risk_management\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"NIST Risk Management Framework\\\",\\n            abbreviation = \\\"NIST RMF\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"A seven-step lifecycle process integrating security and privacy risk management into federal and enterprise systems.\\\",\\n            purpose = \\\"To manage information system security risk throughout system lifecycles.\\\",\\n            whenToUse = \\\"When building secure federal or enterprise information systems.\\\",\\n            steps = listOf(\\n                \\\"Prepare, Categorize, Select, Implement, Assess, Authorize, Monitor.\\\"\\n            ),\\n            workplaceExample = \\\"A defense contractor securing federal cloud databases following NIST RMF authorization steps.\\\",\\n            advantages = listOf(\\\"Extremely rigorous security lifecycle\\\", \\\"Comprehensive compliance\\\"),\\n            limitations = listOf(\\\"Bureaucratic paperwork overhead\\\"),\\n            keyTakeaway = \\\"NIST RMF integrates security and privacy risk management into every phase of system development.\\\",\\n            relatedModelIds = listOf(\\\"nist_cybersecurity\\\", \\\"coso_erm\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"control_self_assessment\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Control Self-Assessment\\\",\\n            abbreviation = \\\"CSA\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"A technique where operational teams evaluate the effectiveness of their own internal controls rather than relying solely on external auditors.\\\",\\n            purpose = \\\"To foster a culture of risk awareness and control ownership across frontline staff.\\\",\\n            whenToUse = \\\"During annual internal control reviews and compliance workshops.\\\",\\n            steps = listOf(\\n                \\\"Train operational staff on control standards.\\\",\\n                \\\"Facilitate team workshops evaluating local process controls.\\\",\\n                \\\"Identify control weaknesses.\\\",\\n                \\\"Develop remediation plans.\\\"\\n            ),\\n            workplaceExample = \\\"Branch bank managers reviewing their own cash handling controls against compliance checklists.\\\",\\n            advantages = listOf(\\\"Empowers frontline staff\\\", \\\"Uncovers operational risks faster than external audits\\\"),\\n            limitations = listOf(\\\"Can be lenient if staff lack objectivity\\\"),\\n            keyTakeaway = \\\"Control Self-Assessment empowers frontline operational teams to take ownership of their own risk controls.\\\",\\n            relatedModelIds = listOf(\\\"coso_internal_control\\\", \\\"three_lines_model\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"root_cause_corrective_action\\\",\\n            categoryIds = listOf(\\\"cat7\\\", \\\"cat4\\\", \\\"cat2\\\"),\\n            title = \\\"Root Cause and Corrective Action\\\",\\n            abbreviation = \\\"RCCA\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"A formal compliance methodology for investigating audit non-conformances, finding root causes, and verifying corrective actions.\\\",\\n            purpose = \\\"To close audit findings permanently and prevent regulatory non-compliance recurrence.\\\",\\n            whenToUse = \\\"Following regulatory audits, ISO inspections, and quality non-conformances.\\\",\\n            steps = listOf(\\n                \\\"Log audit non-conformance finding.\\\",\\n                \\\"Investigate root cause using 5 Whys.\\\",\\n                \\\"Implement corrective action plan (CAP).\\\",\\n                \\\"Auditor verification and closure.\\\"\\n            ),\\n            workplaceExample = \\\"Closing an FDA audit finding by redesigning chemical labeling SOPs and retraining staff.\\\",\\n            advantages = listOf(\\\"Permanent regulatory compliance closure\\\", \\\"Prevents repeat findings\\\"),\\n            limitations = listOf(\\\"Requires strict documentation\\\"),\\n            keyTakeaway = \\\"RCCA turns audit findings into permanent operational improvements through rigorous root cause investigation.\\\",\\n            relatedModelIds = listOf(\\\"five_whys\\\", \\\"iso_9001\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"business_continuity_management\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Business Continuity Management\\\",\\n            abbreviation = \\\"BCM\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"An overarching management process providing a framework to build organizational resilience against disruptions.\\\",\\n            purpose = \\\"To ensure enterprise survival and brand protection through comprehensive preparedness.\\\",\\n            whenToUse = \\\"For enterprise resilience planning and board risk oversight.\\\",\\n            steps = listOf(\\n                \\\"Establish BCM policy and governance.\\\",\\n                \\\"Conduct BIA and risk assessments.\\\",\\n                \\\"Develop business continuity and disaster recovery plans.\\\",\\n                \\\"Exercise and audit plans annually.\\\"\\n            ),\\n            workplaceExample = \\\"A global airline running annual tabletop exercises simulating pandemic travel shutdowns and cyber ransomware attacks.\\\",\\n            advantages = listOf(\\\"Comprehensive enterprise resilience\\\", \\\"Protects brand and stakeholders\\\"),\\n            limitations = listOf(\\\"Requires executive sponsorship and budget\\\"),\\n            keyTakeaway = \\\"Business Continuity Management builds organizational resilience to survive unexpected catastrophic disruptions.\\\",\\n            relatedModelIds = listOf(\\\"business_continuity_planning\\\", \\\"iso_31000\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"third_party_risk_management\\\",\\n            categoryIds = listOf(\\\"cat7\\\"),\\n            title = \\\"Third-Party Risk Management\\\",\\n            abbreviation = \\\"TPRM\\\",\\n            categoryName = \\\"Risk Management, Governance & Compliance\\\",\\n            definition = \\\"The process of analyzing, monitoring, and mitigating risks associated with outsourced vendors, suppliers, and partners.\\\",\\n            purpose = \\\"To protect the organization from vendor data breaches, operational failures, and compliance violations.\\\",\\n            whenToUse = \\\"When onboarding SaaS vendors, cloud providers, and offshore manufacturers.\\\",\\n            steps = listOf(\\n                \\\"Inventory and tier all third-party vendors.\\\",\\n                \\\"Conduct security and financial due diligence assessments.\\\",\\n                \\\"Include strict compliance and SLA clauses in contracts.\\\",\\n                \\\"Continuously monitor vendor risk posture.\\\"\\n            ),\\n            workplaceExample = \\\"Auditing a third-party payroll vendor\'s SOC2 compliance report before signing software contracts.\\\",\\n            advantages = listOf(\\\"Protects against supply chain cyber attacks\\\", \\\"Ensures vendor accountability\\\"),\\n            limitations = listOf(\\\"Resource-intensive vendor auditing\\\"),\\n            keyTakeaway = \\\"Outsourcing operations does not outsource risk; robust Third-Party Risk Management is essential.\\\",\\n            relatedModelIds = listOf(\\\"grc\\\", \\\"iso_31000\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n\\n        // CATEGORY 8 \342\200\224 FINANCIAL MANAGEMENT AND MANAGERIAL ACCOUNTING\\n        ManagementModel(\\n            id = \\\"break_even\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Break-Even Analysis\\\",\\n            abbreviation = \\\"Break-Even\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A financial calculation determining the sales volume required to cover total fixed and variable costs (Zero Profit point).\\\",\\n            purpose = \\\"To calculate minimum sales targets required before a product or business becomes profitable.\\\",\\n            whenToUse = \\\"When launching new products, pricing goods, or evaluating startup feasibility.\\\",\\n            steps = listOf(\\n                \\\"Identify Fixed Costs (rent, salaries).\\\",\\n                \\\"Determine Variable Cost per unit.\\\",\\n                \\\"Determine Selling Price per unit.\\\",\\n                \\\"Calculate Break-Even Units = Fixed Costs / (Selling Price - Variable Cost per unit).\\\"\\n            ),\\n            workplaceExample = \\\"A cafe with $10,000 monthly fixed costs, selling coffee for $5 with $2 variable cost has a break-even point of 3,333 cups monthly.\\\",\\n            advantages = listOf(\\\"Simple and vital financial feasibility check\\\", \\\"Clear sales targets\\\"),\\n            limitations = listOf(\\\"Assumes constant selling prices and linear costs\\\"),\\n            keyTakeaway = \\\"Knowing your break-even sales volume is essential before launching any commercial enterprise.\\\",\\n            relatedModelIds = listOf(\\\"cvp_analysis\\\", \\\"roi\\\"),\\n            illustrationType = \\\"break_even_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"cvp_analysis\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Cost\342\200\223Volume\342\200\223Profit Analysis\\\",\\n            abbreviation = \\\"CVP Analysis\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A financial model examining how changes in costs (fixed and variable), volume, and prices affect operating profit.\\\",\\n            purpose = \\\"To model profitability scenarios under varying sales volumes and pricing strategies.\\\",\\n            whenToUse = \\\"During pricing decisions, budgeting, and profit planning.\\\",\\n            steps = listOf(\\n                \\\"Determine contribution margin per unit (Price minus Variable Cost).\\\",\\n                \\\"Calculate impact of volume changes on operating income.\\\",\\n                \\\"Model target profit scenarios.\\\"\\n            ),\\n            workplaceExample = \\\"Calculating how a 10% price increase will impact total profit volume given expected customer churn.\\\",\\n            advantages = listOf(\\\"Powerful scenario planning tool for pricing\\\", \\\"Clear profit modeling\\\"),\\n            limitations = listOf(\\\"Assumes linear cost behavior\\\"),\\n            keyTakeaway = \\\"Cost-Volume-Profit analysis models how pricing and volume changes ripple through operating income.\\\",\\n            relatedModelIds = listOf(\\\"break_even\\\", \\\"flexible_budgeting\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"activity_based_costing\\\",\\n            categoryIds = listOf(\\\"cat8\\\", \\\"cat4\\\"),\\n            title = \\\"Activity-Based Costing\\\",\\n            abbreviation = \\\"ABC Costing\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A costing method identifying overhead activities and assigning costs to products based on actual resource consumption.\\\",\\n            purpose = \\\"To allocate overhead costs accurately rather than using blunt volume-based formulas.\\\",\\n            whenToUse = \\\"When manufacturing complex product mixes or pricing professional services.\\\",\\n            steps = listOf(\\n                \\\"Identify indirect activities (machine setups, customer support).\\\",\\n                \\\"Determine cost drivers for each activity.\\\",\\n                \\\"Assign overhead costs to products based on activity consumption.\\\"\\n            ),\\n            workplaceExample = \\\"Discovering that custom low-volume products consume disproportionate machine setup time, making them unprofitable under accurate ABC costing.\\\",\\n            advantages = listOf(\\\"Accurate product profitability pricing\\\", \\\"Uncovers hidden cost drivers\\\"),\\n            limitations = listOf(\\\"Complex data collection overhead\\\"),\\n            keyTakeaway = \\\"Activity-Based Costing reveals true product profitability by allocating overhead to actual resource drivers.\\\",\\n            relatedModelIds = listOf(\\\"variance_analysis\\\", \\\"zbb\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"variance_analysis\\\",\\n            categoryIds = listOf(\\\"cat8\\\", \\\"cat6\\\"),\\n            title = \\\"Variance Analysis\\\",\\n            abbreviation = \\\"Variance Analysis\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"Comparing actual financial results against budgeted figures to investigate favorable and unfavorable variances.\\\",\\n            purpose = \\\"To pinpoint operational cost overruns and revenue shortfalls for management intervention.\\\",\\n            whenToUse = \\\"During monthly financial close and budget reviews.\\\",\\n            steps = listOf(\\n                \\\"Compare actual revenue and expenses against budget.\\\",\\n                \\\"Calculate dollar and percentage variance.\\\",\\n                \\\"Investigate root causes of significant variances.\\\",\\n                \\\"Take corrective managerial action.\\\"\\n            ),\\n            workplaceExample = \\\"Investigating an unfavorable 15% material cost variance in manufacturing due to supplier price hikes.\\\",\\n            advantages = listOf(\\\"Early financial control\\\", \\\"Accountability for budget performance\\\"),\\n            limitations = listOf(\\\"Historical lookback rather than predictive\\\"),\\n            keyTakeaway = \\\"Investigating budget variances monthly keeps operational spending aligned with financial targets.\\\",\\n            relatedModelIds = listOf(\\\"flexible_budgeting\\\", \\\"zbb\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"zero_based_budgeting\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Zero-Based Budgeting\\\",\\n            abbreviation = \\\"ZBB\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A budgeting process where every expense must be justified for each new period starting from zero, rather than rolling over previous budgets.\\\",\\n            purpose = \\\"To eliminate legacy bloat and force rigorous justification of all operational expenses.\\\",\\n            whenToUse = \\\"During financial turnaround, cost reduction initiatives, and annual budget planning.\\\",\\n            steps = listOf(\\n                \\\"Start every budget line item from zero.\\\",\\n                \\\"Require department heads to justify business value for every dollar requested.\\\",\\n                \\\"Rank and fund packages based on strategic ROI.\\\"\\n            ),\\n            workplaceExample = \\\"A tech company forcing marketing to justify every software subscription from scratch rather than auto-renewing last year\'s spend.\\\",\\n            advantages = listOf(\\\"Eliminates legacy budget bloat\\\", \\\"Drives extreme cost discipline\\\"),\\n            limitations = listOf(\\\"Extremely time-consuming and labor-intensive\\\"),\\n            keyTakeaway = \\\"Zero-Based Budgeting destroys legacy bloat by forcing every expense to justify its existence from scratch.\\\",\\n            relatedModelIds = listOf(\\\"variance_analysis\\\", \\\"flexible_budgeting\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"capital_budgeting\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Capital Budgeting\\\",\\n            abbreviation = \\\"CapEx Budgeting\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"The process of evaluating and selecting long-term investment projects exceeding one year.\\\",\\n            purpose = \\\"To allocate long-term capital to projects generating highest risk-adjusted returns.\\\",\\n            whenToUse = \\\"When evaluating major equipment purchases, acquisitions, or plant expansions.\\\",\\n            steps = listOf(\\n                \\\"Estimate future cash flows of investment.\\\",\\n                \\\"Determine cost of capital.\\\",\\n                \\\"Apply appraisal methods (NPV, IRR, Payback Period).\\\",\\n                \\\"Approve capital allocation.\\\"\\n            ),\\n            workplaceExample = \\\"Evaluating whether to invest $10M in a new automated assembly line.\\\",\\n            advantages = listOf(\\\"Ensures disciplined long-term capital allocation\\\", \\\"Maximizes shareholder value\\\"),\\n            limitations = listOf(\\\"Relies on cash flow forecasts subject to error\\\"),\\n            keyTakeaway = \\\"Capital budgeting uses rigorous financial appraisal methods to allocate long-term investments.\\\",\\n            relatedModelIds = listOf(\\\"npv\\\", \\\"irr\\\", \\\"payback_period\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"npv\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Net Present Value\\\",\\n            abbreviation = \\\"NPV\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"The sum of present values of incoming and outgoing cash flows discounted over time at a target rate.\\\",\\n            purpose = \\\"To determine the absolute dollar value added to a firm by an investment project.\\\",\\n            whenToUse = \\\"During capital budgeting and investment appraisal.\\\",\\n            steps = listOf(\\n                \\\"Forecast future cash flows for each year.\\\",\\n                \\\"Select discount rate (cost of capital).\\\",\\n                \\\"Discount cash flows back to present value.\\\",\\n                \\\"Sum present values minus initial investment cost (Positive NPV = Accept).\\\"\\n            ),\\n            workplaceExample = \\\"A project with $1M initial cost yielding present value cash flows of $1.3M has an NPV of +$300,000.\\\",\\n            advantages = listOf(\\\"Accounts for time value of money\\\", \\\"Adds absolute dollar value to firm\\\"),\\n            limitations = listOf(\\\"Requires accurate discount rate and cash flow forecasting\\\"),\\n            keyTakeaway = \\\"Projects with positive Net Present Value increase shareholder wealth and should be accepted.\\\",\\n            relatedModelIds = listOf(\\\"irr\\\", \\\"payback_period\\\", \\\"capital_budgeting\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"irr\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Internal Rate of Return\\\",\\n            abbreviation = \\\"IRR\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"The discount rate making the Net Present Value (NPV) of all cash flows equal to zero in a discounted cash flow analysis.\\\",\\n            purpose = \\\"To measure the annualized percentage yield of an investment project.\\\",\\n            whenToUse = \\\"When comparing percentage returns across competing capital projects.\\\",\\n            steps = listOf(\\n                \\\"Set NPV formula equal to zero.\\\",\\n                \\\"Solve for discount rate (IRR).\\\",\\n                \\\"Compare IRR against corporate Hurdle Rate (Accept if IRR > Hurdle Rate).\\\"\\n            ),\\n            workplaceExample = \\\"An investment project yielding an IRR of 18% when corporate hurdle rate is 10% is approved.\\\",\\n            advantages = listOf(\\\"Percentage return easy for executives to understand\\\", \\\"Allows cross-project comparison\\\"),\\n            limitations = listOf(\\\"Can produce multiple IRR values for unconventional cash flow signs\\\"),\\n            keyTakeaway = \\\"Internal Rate of Return measures the annualized percentage yield of capital investments.\\\",\\n            relatedModelIds = listOf(\\\"npv\\\", \\\"payback_period\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"payback_period\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Payback Period\\\",\\n            abbreviation = \\\"Payback\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"The length of time required for an investment to recover its initial outlay in net cash flows.\\\",\\n            purpose = \\\"To measure investment liquidity and speed of capital recovery.\\\",\\n            whenToUse = \\\"For quick risk screening of capital investments and tech projects.\\\",\\n            steps = listOf(\\n                \\\"Identify initial investment cost.\\\",\\n                \\\"Track annual cash inflows.\\\",\\n                \\\"Calculate time required for cumulative inflows to equal initial cost.\\\"\\n            ),\\n            workplaceExample = \\\"A $50,000 software upgrade generating $20,000 annual savings has a payback period of 2.5 years.\\\",\\n            advantages = listOf(\\\"Simple and easy to calculate\\\", \\\"Measures liquidity risk\\\"),\\n            limitations = listOf(\\\"Ignores cash flows occurring after the payback period\\\"),\\n            keyTakeaway = \\\"Payback period measures how quickly invested capital is recovered, though it ignores cash flows beyond payback.\\\",\\n            relatedModelIds = listOf(\\\"npv\\\", \\\"irr\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"roi\\\",\\n            categoryIds = listOf(\\\"cat8\\\", \\\"cat6\\\"),\\n            title = \\\"Return on Investment\\\",\\n            abbreviation = \\\"ROI\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A financial ratio dividing net profit from an investment by its initial cost.\\\",\\n            purpose = \\\"To measure the percentage efficiency and profitability of an investment.\\\",\\n            whenToUse = \\\"For marketing campaign evaluation, project appraisal, and capital investments.\\\",\\n            steps = listOf(\\n                \\\"Calculate Net Profit (Gain from investment minus Cost).\\\",\\n                \\\"Divide by Cost of Investment.\\\",\\n                \\\"Multiply by 100 to get percentage ROI.\\\"\\n            ),\\n            workplaceExample = \\\"A $10,000 ad campaign generating $40,000 in gross sales ($30,000 net profit) yields an ROI of 300%.\\\",\\n            advantages = listOf(\\\"Universally understood percentage metric\\\", \\\"Simple to compute\\\"),\\n            limitations = listOf(\\\"Ignores time value of money\\\"),\\n            keyTakeaway = \\\"Return on Investment measures the percentage gain generated relative to initial project costs.\\\",\\n            relatedModelIds = listOf(\\\"roa\\\", \\\"roe\\\", \\\"npv\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"roa\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Return on Assets\\\",\\n            abbreviation = \\\"ROA\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A financial ratio measuring net income produced by total company assets.\\\",\\n            purpose = \\\"To evaluate how efficiently management uses assets to generate earnings.\\\",\\n            whenToUse = \\\"During financial ratio analysis and company performance reviews.\\\",\\n            steps = listOf(\\n                \\\"Take Net Income.\\\",\\n                \\\"Divide by Total Assets.\\\",\\n                \\\"ROA = Net Income / Total Assets.\\\"\\n            ),\\n            workplaceExample = \\\"A company with $10M net income and $100M total assets has an ROA of 10%.\\\",\\n            advantages = listOf(\\\"Measures asset utilization efficiency\\\"),\\n            limitations = listOf(\\\"Varying asset depreciation accounting can distort comparisons\\\"),\\n            keyTakeaway = \\\"Return on Assets measures how efficiently a company utilizes its asset base to generate profit.\\\",\\n            relatedModelIds = listOf(\\\"roe\\\", \\\"roi\\\", \\\"dupont_analysis\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"roe\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Return on Equity\\\",\\n            abbreviation = \\\"ROE\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A financial ratio measuring net income generated relative to shareholders\' total equity.\\\",\\n            purpose = \\\"To measure profitability from the perspective of equity investors.\\\",\\n            whenToUse = \\\"During stock analysis, investor reviews, and corporate financial evaluations.\\\",\\n            steps = listOf(\\n                \\\"Take Net Income.\\\",\\n                \\\"Divide by Shareholders\' Equity.\\\",\\n                \\\"ROE = Net Income / Shareholders\' Equity.\\\"\\n            ),\\n            workplaceExample = \\\"A company generating $15M net income on $75M shareholder equity achieves a 20% ROE.\\\",\\n            advantages = listOf(\\\"Key metric for equity investors\\\", \\\"Measures profitability on invested capital\\\"),\\n            limitations = listOf(\\\"Can be artificially inflated by high financial leverage (debt)\\\"),\\n            keyTakeaway = \\\"Return on Equity measures the profitability generated on shareholders\' invested capital.\\\",\\n            relatedModelIds = listOf(\\\"roa\\\", \\\"dupont_analysis\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"dupont_analysis\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"DuPont Analysis\\\",\\n            abbreviation = \\\"DuPont\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A financial framework breaking down Return on Equity (ROE) into Profit Margin, Asset Turnover, and Financial Leverage.\\\",\\n            purpose = \\\"To uncover the underlying operational drivers of a company\'s Return on Equity.\\\",\\n            whenToUse = \\\"During deep financial statement analysis and operational valuation.\\\",\\n            steps = listOf(\\n                \\\"Break ROE into three components: Profit Margin x Asset Turnover x Equity Multiplier.\\\",\\n                \\\"Analyze whether ROE is driven by operational margin, asset efficiency, or debt leverage.\\\"\\n            ),\\n            workplaceExample = \\\"Comparing two retailers with 20% ROE: one achieves it via high profit margins (luxury goods), the other via high asset turnover (discount warehouse).\\\",\\n            advantages = listOf(\\\"Deep operational insight into financial returns\\\", \\\"Identifies financial levers\\\"),\\n            limitations = listOf(\\\"Relies on historical accounting balance sheet data\\\"),\\n            keyTakeaway = \\\"DuPont analysis dissects ROE into profit margins, asset turnover, and financial leverage.\\\",\\n            relatedModelIds = listOf(\\\"roe\\\", \\\"roa\\\", \\\"financial_ratios\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"wacc\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Weighted Average Cost of Capital\\\",\\n            abbreviation = \\\"WACC\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"The average rate of return a company is expected to pay to all its security holders, weighted by debt and equity proportions.\\\",\\n            purpose = \\\"To establish the hurdle rate for capital budgeting and investment appraisal.\\\",\\n            whenToUse = \\\"When calculating discount rates for NPV and corporate valuation.\\\",\\n            steps = listOf(\\n                \\\"Determine cost of equity and cost of debt.\\\",\\n                \\\"Determine market value proportions of debt and equity.\\\",\\n                \\\"Calculate weighted average cost.\\\"\\n            ),\\n            workplaceExample = \\\"A company financed 70% by equity (cost 10%) and 30% by debt (cost 5%) has a WACC of 8.5%.\\\",\\n            advantages = listOf(\\\"Essential corporate finance benchmark rate\\\"),\\n            limitations = listOf(\\\"Assumes capital structure remains constant\\\"),\\n            keyTakeaway = \\\"WACC establishes the baseline hurdle rate that investments must exceed to create value.\\\",\\n            relatedModelIds = listOf(\\\"npv\\\", \\\"irr\\\", \\\"capital_budgeting\\\"),\\n            illustrationType = \\\"pie_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"cash_flow_forecasting\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Cash Flow Forecasting\\\",\\n            abbreviation = \\\"Cash Flow Forecast\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"Projecting future cash inflows and outflows over a specific horizon (weekly, monthly, annually).\\\",\\n            purpose = \\\"To prevent liquidity crunches and ensure solvency.\\\",\\n            whenToUse = \\\"For treasury management, startup burn-rate monitoring, and working capital planning.\\\",\\n            steps = listOf(\\n                \\\"Project cash receipts from sales and receivables.\\\",\\n                \\\"Project cash disbursements for payroll, rent, and suppliers.\\\",\\n                \\\"Calculate net monthly cash flow and closing cash balance.\\\",\\n                \\\"Maintain minimum cash reserves.\\\"\\n            ),\\n            workplaceExample = \\\"A seasonal retailer forecasting cash flow to ensure sufficient cash buffer before holiday inventory purchases.\\\",\\n            advantages = listOf(\\\"Prevents sudden insolvency\\\", \\\"Identifies working capital gaps\\\"),\\n            limitations = listOf(\\\"Receivable delays can disrupt forecasts\\\"),\\n            keyTakeaway = \\\"Cash is oxygen; rigorous cash flow forecasting prevents unexpected insolvency.\\\",\\n            relatedModelIds = listOf(\\\"break_even\\\", \\\"financial_ratios\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"financial_ratios\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Financial Ratio Analysis\\\",\\n            abbreviation = \\\"Financial Ratios\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"Analyzing liquidity, solvency, profitability, and efficiency ratios from financial statements.\\\",\\n            purpose = \\\"To evaluate overall financial health and operational performance.\\\",\\n            whenToUse = \\\"During credit evaluations, investment analysis, and annual financial audits.\\\",\\n            steps = listOf(\\n                \\\"Calculate Liquidity Ratios (Current Ratio, Quick Ratio).\\\",\\n                \\\"Calculate Solvability/Leverage Ratios (Debt-to-Equity).\\\",\\n                \\\"Calculate Profitability Ratios (Net Margin, ROE).\\\",\\n                \\\"Compare against industry benchmarks.\\\"\\n            ),\\n            workplaceExample = \\\"Checking that current ratio exceeds 1.5 to ensure short-term solvency.\\\",\\n            advantages = listOf(\\\"Quick snapshot of financial health\\\", \\\"Standardized comparison\\\"),\\n            limitations = listOf(\\\"Historical accounting snapshot\\\"),\\n            keyTakeaway = \\\"Financial ratios provide a standardized snapshot of liquidity, leverage, and profitability.\\\",\\n            relatedModelIds = listOf(\\\"dupont_analysis\\\", \\\"cash_flow_forecasting\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"flexible_budgeting\\\",\\n            categoryIds = listOf(\\\"cat8\\\"),\\n            title = \\\"Flexible Budgeting\\\",\\n            abbreviation = \\\"Flexible Budget\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A budget that adjusts automatically for changes in actual sales volume or activity levels.\\\",\\n            purpose = \\\"To evaluate cost performance fairly when actual production volume differs from static budget forecasts.\\\",\\n            whenToUse = \\\"In manufacturing and variable-volume businesses during monthly variance reviews.\\\",\\n            steps = listOf(\\n                \\\"Separate fixed costs from variable costs per unit.\\\",\\n                \\\"Adjust variable budget allowances based on actual volume produced.\\\",\\n                \\\"Compare actual costs against adjusted flexible budget targets.\\\"\\n            ),\\n            workplaceExample = \\\"A factory budgeted for 10,000 units but actually produced 12,000 units; the flexible budget automatically scales variable material costs upward for fair comparison.\\\",\\n            advantages = listOf(\\\"Fair variance evaluation\\\", \\\"Adapts to volume changes\\\"),\\n            limitations = listOf(\\\"Requires clear separation of fixed and variable costs\\\"),\\n            keyTakeaway = \\\"Flexible budgets adjust automatically for volume changes, enabling fair cost performance evaluations.\\\",\\n            relatedModelIds = listOf(\\\"variance_analysis\\\", \\\"cvp_analysis\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"total_cost_of_ownership\\\",\\n            categoryIds = listOf(\\\"cat8\\\", \\\"cat4\\\"),\\n            title = \\\"Total Cost of Ownership\\\",\\n            abbreviation = \\\"TCO\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"An estimate evaluating direct and indirect costs of a product, asset, or system over its entire lifecycle.\\\",\\n            purpose = \\\"To look beyond upfront purchase price to evaluate long-term cost implications.\\\",\\n            whenToUse = \\\"During major procurement, IT software purchasing, and equipment acquisition.\\\",\\n            steps = listOf(\\n                \\\"Calculate upfront purchase price.\\\",\\n                \\\"Estimate ongoing operating, maintenance, and training costs.\\\",\\n                \\\"Calculate end-of-life disposal or upgrade costs.\\\",\\n                \\\"Sum total lifecycle costs.\\\"\\n            ),\\n            workplaceExample = \\\"Comparing a cheaper server with high maintenance costs against an expensive server with low TCO over 5 years.\\\",\\n            advantages = listOf(\\\"Prevents hidden cost traps\\\", \\\"Long-term financial accuracy\\\"),\\n            limitations = listOf(\\\"Long-term forecasting involves estimation uncertainty\\\"),\\n            keyTakeaway = \\\"The cheapest purchase price often carries the highest Total Cost of Ownership over its lifecycle.\\\",\\n            relatedModelIds = listOf(\\\"cost_benefit\\\", \\\"capital_budgeting\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"make_or_buy\\\",\\n            categoryIds = listOf(\\\"cat8\\\", \\\"cat4\\\"),\\n            title = \\\"Make-or-Buy Analysis\\\",\\n            abbreviation = \\\"Make-or-Buy\\\",\\n            categoryName = \\\"Financial Management & Managerial Accounting\\\",\\n            definition = \\\"A strategic financial decision comparing the internal cost and capability of producing a component/service vs. outsourcing.\\\",\\n            purpose = \\\"To determine whether to manufacture internally or procure from external suppliers.\\\",\\n            whenToUse = \\\"During supply chain planning, software development (build vs. buy), and manufacturing decisions.\\\",\\n            steps = listOf(\\n                \\\"Calculate internal production costs (fixed + variable).\\\",\\n                \\\"Obtain external supplier purchase quotes.\\\",\\n                \\\"Evaluate strategic factors (IP protection, quality control, core competence).\\\",\\n                \\\"Select optimal path.\\\"\\n            ),\\n            workplaceExample = \\\"Deciding whether to build an in-house customer support chat tool or buy a SaaS subscription.\\\",\\n            advantages = listOf(\\\"Optimizes cost and resource allocation\\\", \\\"Clarifies core competencies\\\"),\\n            limitations = listOf(\\\"Must account for qualitative risks like supplier dependency\\\"),\\n            keyTakeaway = \\\"Make-or-buy analysis balances financial production costs against strategic core competencies.\\\",\\n            relatedModelIds = listOf(\\\"value_chain\\\", \\\"cost_benefit\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n\\n        // CATEGORY 9 \342\200\224 TIME MANAGEMENT AND PERSONAL PRODUCTIVITY\\n        ManagementModel(\\n            id = \\\"pomodoro\\\",\\n            categoryIds = listOf(\\\"cat9\\\"),\\n            title = \\\"Pomodoro Technique\\\",\\n            abbreviation = \\\"Pomodoro\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"A time management method using a timer to break work into 25-minute focused intervals separated by 5-minute breaks.\\\",\\n            purpose = \\\"To maintain high mental focus and prevent burnout through structured work-rest cycles.\\\",\\n            whenToUse = \\\"For tackling writing, coding, studying, and deep concentration tasks.\\\",\\n            steps = listOf(\\n                \\\"Choose a task.\\\",\\n                \\\"Set timer for 25 minutes.\\\",\\n                \\\"Work with zero distractions until timer rings.\\\",\\n                \\\"Take a 5-minute break.\\\",\\n                \\\"After 4 pomodoros, take a longer 15-30 minute break.\\\"\\n            ),\\n            workplaceExample = \\\"Coding a software feature in two 25-minute sprints with a 5-minute stretch break in between.\\\",\\n            advantages = listOf(\\\"Defeats procrastination\\\", \\\"Maintains high mental energy\\\"),\\n            limitations = listOf(\\\"Can disrupt collaborative team meetings or complex deep-flow states\\\"),\\n            keyTakeaway = \\\"Breaking work into 25-minute focused sprints maintains mental energy and banishes procrastination.\\\",\\n            relatedModelIds = listOf(\\\"deep_work\\\", \\\"time_blocking\\\"),\\n            illustrationType = \\\"pie_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"gtd\\\",\\n            categoryIds = listOf(\\\"cat9\\\"),\\n            title = \\\"Getting Things Done\\\",\\n            abbreviation = \\\"GTD\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"A personal productivity system by David Allen based on capturing, clarifying, organizing, reflecting, and engaging tasks.\\\",\\n            purpose = \\\"To clear mental clutter by moving tasks out of your head into a trusted external system.\\\",\\n            whenToUse = \\\"When managing overwhelming multi-project workloads and daily action items.\\\",\\n            steps = listOf(\\n                \\\"Capture: Collect all incoming tasks and ideas.\\\",\\n                \\\"Clarify: Decide if actionable; if yes, do, delegate, or defer.\\\",\\n                \\\"Organize: Sort into context lists (Calls, Office, Errands).\\\",\\n                \\\"Reflect: Review weekly.\\\",\\n                \\\"Engage: Execute tasks with confidence.\\\"\\n            ),\\n            workplaceExample = \\\"Emptying your inbox daily by turning emails immediately into calendar actions or reference folders.\\\",\\n            advantages = listOf(\\\"Reduces mental stress\\\", \\\"Ensures zero dropped tasks\\\"),\\n            limitations = listOf(\\\"Requires rigorous ongoing maintenance habit\\\"),\\n            keyTakeaway = \\\"Your mind is for having ideas, not holding them; capturing tasks externally clears mental bandwidth.\\\",\\n            relatedModelIds = listOf(\\\"weekly_review\\\", \\\"mits\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"time_blocking\\\",\\n            categoryIds = listOf(\\\"cat9\\\", \\\"cat6\\\"),\\n            title = \\\"Time Blocking\\\",\\n            abbreviation = \\\"Time Blocking\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"A scheduling method dividing your day into distinct blocks of time dedicated to specific tasks or projects.\\\",\\n            purpose = \\\"To eliminate context switching and protect time for deep work.\\\",\\n            whenToUse = \\\"For calendar management, executive scheduling, and project execution.\\\",\\n            steps = listOf(\\n                \\\"Review weekly priorities.\\\",\\n                \\\"Allocate dedicated calendar blocks for deep work, meetings, and admin.\\\",\\n                \\\"Treat blocks as unbreakable appointments with yourself.\\\",\\n                \\\"Review and adjust daily.\\\"\\n            ),\\n            workplaceExample = \\\"Reserving 9:00 AM to 11:00 AM daily exclusively for coding without checking email or Slack.\\\",\\n            advantages = listOf(\\\"Eliminates context switching\\\", \\\"Protects time for strategic priorities\\\"),\\n            limitations = listOf(\\\"Requires discipline to stick to schedule when interruptions occur\\\"),\\n            keyTakeaway = \\\"Time blocking turns your calendar into an execution roadmap rather than a reactive meeting victim.\\\",\\n            relatedModelIds = listOf(\\\"deep_work\\\", \\\"pomodoro\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"time_boxing\\\",\\n            categoryIds = listOf(\\\"cat9\\\"),\\n            title = \\\"Time Boxing\\\",\\n            abbreviation = \\\"Time Boxing\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"Allocating a fixed maximum amount of time to a specific activity, after which work stops regardless of completion.\\\",\\n            purpose = \\\"To prevent perfectionism and Parkinson\'s Law by enforcing hard time limits.\\\",\\n            whenToUse = \\\"When writing reports, brainstorming, or preventing scope creep on tasks.\\\",\\n            steps = listOf(\\n                \\\"Select task and set a strict time limit (e.g., 45 minutes).\\\",\\n                \\\"Work intensely until timer expires.\\\",\\n                \\\"Stop and evaluate: Accept current state or schedule next box.\\\"\\n            ),\\n            workplaceExample = \\\"Giving yourself exactly 30 minutes to draft an executive email summary instead of agonizing over it for two hours.\\\",\\n            advantages = listOf(\\\"Cures perfectionism\\\", \\\"Stops tasks from expanding infinitely\\\"),\\n            limitations = listOf(\\\"Can lead to rushed output if time limit is too tight\\\"),\\n            keyTakeaway = \\\"Setting a hard time box cures perfectionism and prevents tasks from expanding indefinitely.\\\",\\n            relatedModelIds = listOf(\\\"pomodoro\\\", \\\"eisenhower_matrix\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"eat_that_frog\\\",\\n            categoryIds = listOf(\\\"cat9\\\"),\\n            title = \\\"Eat That Frog\\\",\\n            abbreviation = \\\"Eat That Frog\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"A prioritization rule based on tackling your biggest, most important, or most dreaded task first thing in the morning.\\\",\\n            purpose = \\\"To overcome procrastination and build unstoppable daily momentum.\\\",\\n            whenToUse = \\\"First thing every morning when planning your workday.\\\",\\n            steps = listOf(\\n                \\\"Identify your biggest, most dreaded task (\'the frog\').\\\",\\n                \\\"Commit to tackling it immediately first thing in the morning.\\\",\\n                \\\"Enjoy the psychological momentum for the rest of the day.\\\"\\n            ),\\n            workplaceExample = \\\"Writing the difficult client termination email at 9:00 AM before checking email or social media.\\\",\\n            advantages = listOf(\\\"Instantly defeats procrastination\\\", \\\"Unlocks daily momentum\\\"),\\n            limitations = listOf(\\\"Requires high morning willpower\\\"),\\n            keyTakeaway = \\\"Tackling your hardest task first thing in the morning eliminates procrastination and empowers your entire day.\\\",\\n            relatedModelIds = listOf(\\\"mits\\\", \\\"eisenhower_matrix\\\"),\\n            illustrationType = \\\"flow_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"abcde_prioritization\\\",\\n            categoryIds = listOf(\\\"cat9\\\"),\\n            title = \\\"ABCDE Prioritization Method\\\",\\n            abbreviation = \\\"ABCDE\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"A task ranking system grading items from A (Must do - serious consequences) down to E (Eliminate).\\\",\\n            purpose = \\\"To rank a long list of tasks in order of true consequence.\\\",\\n            whenToUse = \\\"When organizing daily to-do lists and task backlogs.\\\",\\n            steps = listOf(\\n                \\\"A: Must do (serious consequences if not done).\\\",\\n                \\\"B: Should do (mild consequences).\\\",\\n                \\\"C: Nice to do (no consequences).\\\",\\n                \\\"D: Delegate to someone else.\\\",\\n                \\\"E: Eliminate entirely.\\\"\\n            ),\\n            workplaceExample = \\\"Grading a tax filing task as A1, lunch with a vendor as C, and filling out old expense reports as D.\\\",\\n            advantages = listOf(\\\"Clear consequence-based ranking\\\", \\\"Filters out busywork\\\"),\\n            limitations = listOf(\\\"Requires discipline to avoid working on C tasks first\\\"),\\n            keyTakeaway = \\\"Grading tasks by the severity of consequences ensures you focus only on high-impact A tasks.\\\",\\n            relatedModelIds = listOf(\\\"eisenhower_matrix\\\", \\\"moscow\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"ivy_lee_method\\\",\\n            categoryIds = listOf(\\\"cat9\\\"),\\n            title = \\\"Ivy Lee Method\\\",\\n            abbreviation = \\\"Ivy Lee\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"A daily productivity routine where you write down the 6 most important tasks for tomorrow, rank them in order of importance, and tackle them sequentially.\\\",\\n            purpose = \\\"To achieve laser focus with zero multitasking distraction.\\\",\\n            whenToUse = \\\"At the end of every workday to plan the next day.\\\",\\n            steps = listOf(\\n                \\\"At end of workday, write down top 6 tasks for tomorrow.\\\",\\n                \\\"Rank them in strict order of importance (1 to 6).\\\",\\n                \\\"Next morning, focus exclusively on task #1 until finished, then move to #2.\\\",\\n                \\\"Unfinished tasks move to next day\'s list.\\\"\\n            ),\\n            workplaceExample = \\\"Executive listing 6 tasks every evening and starting the next day strictly on task #1.\\\",\\n            advantages = listOf(\\\"Deceptively simple\\\", \\\"Zero morning decision fatigue\\\"),\\n            limitations = listOf(\\\"Fixed list of 6 can be rigid for dynamic environments\\\"),\\n            keyTakeaway = \\\"Writing down your top 6 priorities every evening eliminates morning decision fatigue and drives sequential execution.\\\",\\n            relatedModelIds = listOf(\\\"mits\\\", \\\"eat_that_frog\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"most_important_tasks\\\",\\n            categoryIds = listOf(\\\"cat9\\\", \\\"cat6\\\"),\\n            title = \\\"Most Important Tasks\\\",\\n            abbreviation = \\\"MITs\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"Selecting 1 to 3 vital tasks every morning that must be accomplished that day above all else.\\\",\\n            purpose = \\\"To ensure daily progress on strategic goals despite inevitable administrative interruptions.\\\",\\n            whenToUse = \\\"First thing every morning during daily planning.\\\",\\n            steps = listOf(\\n                \\\"Identify 1-3 tasks that will make today a success.\\\",\\n                \\\"Write them down prominently.\\\",\\n                \\\"Commit to completing them before attending to email or minor admin.\\\"\\n            ),\\n            workplaceExample = \\\"Setting \'Finish Q3 financial forecast\' and \'Approve architectural review\' as today\'s 2 MITs.\\\",\\n            advantages = listOf(\\\"Guarantees daily strategic progress\\\", \\\"Simple and effective\\\"),\\n            limitations = listOf(\\\"Requires discipline to ignore urgent distractions\\\"),\\n            keyTakeaway = \\\"Completing your 1-3 Most Important Tasks every day guarantees continuous strategic progress.\\\",\\n            relatedModelIds = listOf(\\\"eisenhower_matrix\\\", \\\"ivy_lee_method\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"weekly_review\\\",\\n            categoryIds = listOf(\\\"cat9\\\"),\\n            title = \\\"Weekly Review Method\\\",\\n            abbreviation = \\\"Weekly Review\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"A dedicated weekly ritual reviewing past tasks, updating calendars, clearing inboxes, and planning the upcoming week.\\\",\\n            purpose = \\\"To maintain high-level situational awareness and prevent projects from falling through the cracks.\\\",\\n            whenToUse = \\\"Every Friday afternoon or Sunday evening.\\\",\\n            steps = listOf(\\n                \\\"Clear all inboxes and capture loose notes.\\\",\\n                \\\"Review calendar for past week and upcoming month.\\\",\\n                \\\"Update project task lists and priorities.\\\",\\n                \\\"Set top goals for the coming week.\\\"\\n            ),\\n            workplaceExample = \\\"Spending 45 minutes every Friday at 4 PM clearing emails, updating Jira boards, and planning next week\'s schedule.\\\",\\n            advantages = listOf(\\\"Brings peace of mind\\\", \\\"Ensures zero dropped projects\\\"),\\n            limitations = listOf(\\\"Requires protected calendar time\\\"),\\n            keyTakeaway = \\\"A weekly review ritual connects daily execution with long-term strategic direction.\\\",\\n            relatedModelIds = listOf(\\\"gtd\\\", \\\"time_blocking\\\"),\\n            illustrationType = \\\"process_cycle\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"deep_work\\\",\\n            categoryIds = listOf(\\\"cat9\\\", \\\"cat6\\\"),\\n            title = \\\"Deep Work Framework\\\",\\n            abbreviation = \\\"Deep Work\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"Professional activities performed in distraction-free concentration that push cognitive capabilities to their limit.\\\",\\n            purpose = \\\"To produce high-value elite output in an era of constant digital distraction.\\\",\\n            whenToUse = \\\"When writing code, crafting strategy, designing systems, or conducting complex analysis.\\\",\\n            steps = listOf(\\n                \\\"Schedule unbroken blocks of deep focus (2-4 hours).\\\",\\n                \\\"Eliminate all distractions (notifications off, closed doors).\\\",\\n                \\\"Establish strict rituals and workspace environments.\\\",\\n                \\\"Measure output in quality hours x focus intensity.\\\"\\n            ),\\n            workplaceExample = \\\"Software architect locking office door and turning off Slack for a 3-hour deep work block to design system architecture.\\\",\\n            advantages = listOf(\\\"Unlocks elite productivity and skill mastery\\\", \\\"Creates rare, valuable output\\\"),\\n            limitations = listOf(\\\"Difficult to maintain in highly collaborative or interrupt-driven roles\\\"),\\n            keyTakeaway = \\\"Unbroken blocks of deep, distraction-free concentration produce elite professional output.\\\",\\n            relatedModelIds = listOf(\\\"pomodoro\\\", \\\"time_blocking\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"personal_kanban\\\",\\n            categoryIds = listOf(\\\"cat9\\\", \\\"cat4\\\", \\\"cat5\\\"),\\n            title = \\\"Personal Kanban\\\",\\n            abbreviation = \\\"Personal Kanban\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"Applying Kanban principles (visualizing work and limiting WIP) to personal tasks and projects.\\\",\\n            purpose = \\\"To manage personal workloads and prevent overwhelm.\\\",\\n            whenToUse = \\\"For individual task tracking on personal whiteboards or digital boards.\\\",\\n            steps = listOf(\\n                \\\"Visualize tasks in columns: Backlog, Doing, Done.\\\",\\n                \\\"Limit Work in Progress (WIP limit of 2 or 3 active tasks).\\\",\\n                \\\"Pull tasks as capacity opens up.\\\"\\n            ),\\n            workplaceExample = \\\"A manager tracking their daily tasks on a sticky-note Kanban board with a strict WIP limit of 3.\\\",\\n            advantages = listOf(\\\"Visual transparency\\\", \\\"Reduces cognitive overwhelm\\\"),\\n            limitations = listOf(\\\"Requires personal habit discipline\\\"),\\n            keyTakeaway = \\\"Visualizing your personal workload and limiting active tasks prevents burnout and accelerates completion.\\\",\\n            relatedModelIds = listOf(\\\"kanban\\\", \\\"eisenhower_matrix\\\"),\\n            illustrationType = \\\"kanban_board\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"capacity_planning\\\",\\n            categoryIds = listOf(\\\"cat9\\\", \\\"cat5\\\", \\\"cat6\\\"),\\n            title = \\\"Capacity Planning\\\",\\n            abbreviation = \\\"Capacity Planning\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"Determining the human and operational bandwidth available to take on new projects and tasks.\\\",\\n            purpose = \\\"To prevent team burnout and overcommitment by matching workload to actual capacity.\\\",\\n            whenToUse = \\\"During quarterly sprint planning, resource allocation, and project budgeting.\\\",\\n            steps = listOf(\\n                \\\"Measure total available working hours/resources.\\\",\\n                \\\"Calculate time consumed by recurring operational meetings and maintenance.\\\",\\n                \\\"Determine net available capacity for new projects.\\\",\\n                \\\"Reject or defer projects exceeding net capacity.\\\"\\n            ),\\n            workplaceExample = \\\"Realizing the engineering team has 160 available hours this sprint, so accepting no more than 150 hours of story points.\\\",\\n            advantages = listOf(\\\"Prevents team burnout\\\", \\\"Realistic commitments\\\"),\\n            limitations = listOf(\\\"Unforeseen emergencies can disrupt capacity calculations\\\"),\\n            keyTakeaway = \\\"Matching workloads to actual available capacity prevents burnout and missed deadlines.\\\",\\n            relatedModelIds = listOf(\\\"toc\\\", \\\"raci_matrix\\\"),\\n            illustrationType = \\\"bar_chart\\\"\\n        ),\\n        ManagementModel(\\n            id = \\\"goal_decomposition\\\",\\n            categoryIds = listOf(\\\"cat9\\\", \\\"cat1\\\"),\\n            title = \\\"Goal Decomposition and Task Breakdown\\\",\\n            abbreviation = \\\"Goal Decomposition\\\",\\n            categoryName = \\\"Time Management & Personal Productivity\\\",\\n            definition = \\\"Breaking massive intimidating goals down into quarterly milestones, monthly targets, weekly projects, and daily tasks.\\\",\\n            purpose = \\\"To make large strategic goals actionable and prevent overwhelm.\\\",\\n            whenToUse = \\\"When planning major projects, career goals, or strategic initiatives.\\\",\\n            steps = listOf(\\n                \\\"Define 1-year macro goal.\\\",\\n                \\\"Decompose into 4 quarterly milestones.\\\",\\n                \\\"Break milestones down into monthly targets.\\\",\\n                \\\"Translate into weekly projects and daily tasks.\\\"\\n            ),\\n            workplaceExample = \\\"Breaking \'write a management book\' down into 10 chapters, 2 chapters per month, 1 page per day.\\\",\\n            advantages = listOf(\\\"Makes intimidating goals achievable\\\", \\\"Clear execution path\\\"),\\n            limitations = listOf(\\\"Requires upfront planning time\\\"),\\n            keyTakeaway = \\\"Breaking massive goals down into daily tasks transforms daunting ambitions into achievable daily habits.\\\",\\n            relatedModelIds = listOf(\\\"smart_goals\\\", \\\"wbs\\\"),\\n            illustrationType = \\\"hierarchy\\\"\\n        )\\n    )\\n\\n    fun getModelsForCategory(categoryId: String): List<ManagementModel> {\\n        return models.filter { it.categoryIds.contains(categoryId) }\\n    }\\n\\n    fun getModelById(modelId: String): ManagementModel? {\\n        return models.find { it.id == modelId }\\n    }\\n\\n    fun searchModels(query: String): List<ManagementModel> {\\n        if (query.isBlank()) return emptyList()\\n        val q = query.lowercase().trim()\\n        return models.filter { model ->\\n            model.title.lowercase().contains(q) ||\\n                    (model.abbreviation?.lowercase()?.contains(q) == true) ||\\n                    model.definition.lowercase().contains(q) ||\\n                    model.categoryName.lowercase().contains(q) ||\\n                    model.purpose.lowercase().contains(q) ||\\n                    model.workplaceExample.lowercase().contains(q)\\n        }\\n    }\\n}\\n\",\"Description\":\"Create comprehensive ManagementRepository with all 180 models across 9 categories\",\"Overwrite\":true,\"TargetFile\":\"/app/src/main/java/com/example/data/ManagementRepository.kt\",\"toolAction\":\"Creating repository data\",\"toolSummary\":\"Create model repository\"}"
