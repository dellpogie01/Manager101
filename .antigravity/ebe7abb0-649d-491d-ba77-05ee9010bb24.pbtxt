            }
            lines {
              text: "            advantages = listOf(\"Reflects real-world adult learning\", \"Cost-effective\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            limitations = listOf(\"Requires availability of stretch assignments\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"The vast majority of professional growth happens on the job through hands-on experience and mentorship.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
