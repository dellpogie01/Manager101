            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Goal: Establish what the coachee wants to achieve.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Reality: Examine the current situation and obstacles.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Options: Brainstorm possible solutions and actions.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Will: Commit to specific action steps and timeline.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
