  planner_response {
    tool_calls {
      id: "call_279287"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"package com.example.ui.navigation\\n\\nimport androidx.compose.foundation.layout.padding\\nimport androidx.compose.material.icons.Icons\\nimport androidx.compose.material.icons.filled.*\\nimport androidx.compose.material3.*\\nimport androidx.compose.runtime.*\\nimport androidx.compose.ui.Modifier\\nimport androidx.lifecycle.viewmodel.compose.viewModel\\nimport androidx.navigation.NavType\\nimport androidx.navigation.compose.*\\nimport androidx.navigation.navArgument\\nimport com.example.ui.screens.*\\nimport com.example.ui.viewmodel.ModelViewModel\\nimport com.google.firebase.auth.FirebaseAuth\\n\\n@Composable\\nfun NavGraph() {\\n    val navController = rememberNavHostController()\\n    val modelViewModel: ModelViewModel = viewModel()\\n    val currentUser = FirebaseAuth.getInstance().currentUser\\n\\n    val startDestination = if (currentUser != null) \\\"home\\\" else \\\"auth\\\"\\n\\n    Scaffold(\\n        bottomBar = {\\n            val navBackStackEntry by navController.currentBackStackEntryAsState()\\n            val currentRoute = navBackStackEntry?.destination?.route\\n\\n            if (currentRoute == \\\"home\\\" || currentRoute == \\\"library\\\" || currentRoute == \\\"favorites\\\" || currentRoute == \\\"settings\\\") {\\n                NavigationBar {\\n                    NavigationBarItem(\\n                        selected = currentRoute == \\\"home\\\",\\n                        onClick = { navController.navigate(\\\"home\\\") { popUpTo(\\\"home\\\") } },\\n                        icon = { Icon(Icons.Default.Home, contentDescription = \\\"Home\\\") },\\n                        label = { Text(\\\"Home\\\") }\\n                    )\\n                    NavigationBarItem(\\n                        selected = currentRoute == \\\"library\\\",\\n                        onClick = { navController.navigate(\\\"library\\\") { popUpTo(\\\"home\\\") } },\\n                        icon = { Icon(Icons.Default.MenuBook, contentDescription = \\\"Library\\\") },\\n                        label = { Text(\\\"Library\\\") }\\n                    )\\n                    NavigationBarItem(\\n                        selected = currentRoute == \\\"favorites\\\",\\n                        onClick = { navController.navigate(\\\"favorites\\\") { popUpTo(\\\"home\\\") } },\\n                        icon = { Icon(Icons.Default.Favorite, contentDescription = \\\"Favorites\\\") },\\n                        label = { Text(\\\"Favorites\\\") }\\n                    )\\n                    NavigationBarItem(\\n                        selected = currentRoute == \\\"settings\\\",\\n                        onClick = { navController.navigate(\\\"settings\\\") { popUpTo(\\\"home\\\") } },\\n                        icon = { Icon(Icons.Default.Settings, contentDescription = \\\"Settings\\\") },\\n                        label = { Text(\\\"Settings\\\") }\\n                    )\\n                }\\n            }\\n        }\\n    ) { innerPadding ->\\n        NavHost(\\n            navController = navController,\\n            startDestination = startDestination,\\n            modifier = Modifier.padding(innerPadding)\\n        ) {\\n            composable(\\\"auth\\\") {\\n                AuthScreen(\\n                    onAuthSuccess = {\\n                        navController.navigate(\\\"home\\\") { popUpTo(\\\"auth\\\") }\\n                    },\\n                    onSkipAuth = {\\n                        navController.navigate(\\\"home\\\") { popUpTo(\\\"auth\\\") }\\n                    }\\n                )\\n            }\\n            composable(\\\"home\\\") {\\n                HomeScreen(\\n                    viewModel = modelViewModel,\\n                    onCategoryClick = { categoryId ->\\n                        navController.navigate(\\\"library?categoryId=$categoryId\\\")\\n                    },\\n                    onModelClick = { modelId ->\\n                        navController.navigate(\\\"detail/$modelId\\\")\\n                    },\\n                    onSearchClick = {\\n                        navController.navigate(\\\"library\\\")\\n                    }\\n                )\\n            }\\n            composable(\\n                route = \\\"library?categoryId={categoryId}\\\",\\n                arguments = listOf(navArgument(\\\"categoryId\\\") { type = NavType.StringType; nullable = true })\\n            ) { backStackEntry ->\\n                val categoryId = backStackEntry.arguments?.getString(\\\"categoryId\\\")\\n                LibraryScreen(\\n                    viewModel = modelViewModel,\\n                    initialCategoryId = categoryId,\\n                    onModelClick = { modelId ->\\n                        navController.navigate(\\\"detail/$modelId\\\")\\n                    },\\n                    onBackClick = {\\n                        navController.popBackStack()\\n                    }\\n                )\\n            }\\n            composable(\\n                route = \\\"detail/{modelId}\\\",\\n                arguments = listOf(navArgument(\\\"modelId\\\") { type = NavType.StringType })\\n            ) { backStackEntry ->\\n                val modelId = backStackEntry.arguments?.getString(\\\"modelId\\\") ?: \\\"\\\"\\n                ModelDetailScreen(\\n                    modelId = modelId,\\n                    viewModel = modelViewModel,\\n                    onBackClick = { navController.popBackStack() },\\n                    onRelatedModelClick = { relId ->\\n                        navController.navigate(\\\"detail/$relId\\\")\\n                    }\\n                )\\n            }\\n            composable(\\\"favorites\\\") {\\n                FavoritesScreen(\\n                    viewModel = modelViewModel,\\n                    onModelClick = { modelId ->\\n                        navController.navigate(\\\"detail/$modelId\\\")\\n                    }\\n                )\