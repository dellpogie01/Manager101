              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Performance Management & Productivity\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"Performance metrics split into predictive leading indicators (driving future results) and historical lagging indicators (measuring past outcomes).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To balance backward-looking results tracking with forward-looking predictive control.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"When designing balanced executive dashboards and operational scorecards.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
