            }
            lines {
              text: "            categoryName = \"Communication, Coaching & People Development\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A learning framework stating that development occurs 70% from experiential stretch assignments, 20% from developmental relationships, and 10% from formal coursework.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To design balanced and effective professional development programs.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"When designing corporate training and leadership development curricula.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"70%: Assign stretch projects and operational problem solving.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"20%: Provide mentoring, coaching, and peer feedback.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"10%: Provide formal workshops, courses, and reading.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"Instead of sending engineers to a 5-day coding seminar (10%), assign them to lead a new microservice migration (70%) with a senior mentor (20%).\","
