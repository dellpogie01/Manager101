            }
            lines {
              text: "            definition = \"A metric multiplying Availability, Performance, and Quality to evaluate manufacturing productivity.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To measure true manufacturing productivity and uncover hidden production losses.\","
