            lines {
              text: "            categoryName = \"Time Management & Personal Productivity\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A daily productivity routine where you write down the 6 most important tasks for tomorrow, rank them in order of importance, and tackle them sequentially.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To achieve laser focus with zero multitasking distraction.\","
