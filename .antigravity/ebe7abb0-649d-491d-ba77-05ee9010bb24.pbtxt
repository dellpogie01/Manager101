            }
            lines {
              text: "            definition = \"A feedback framework structuring delivery around Situation, Behavior, and Impact.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To deliver objective, non-judgmental feedback that drives behavioral change without triggering defensiveness.\","
