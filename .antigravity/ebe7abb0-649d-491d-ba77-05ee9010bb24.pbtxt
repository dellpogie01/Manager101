            }
            lines {
              text: "            title = \"Zero-Based Budgeting\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            abbreviation = \"ZBB\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Financial Management & Managerial Accounting\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A budgeting process where every expense must be justified for each new period starting from zero, rather than rolling over previous budgets.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To eliminate legacy bloat and force rigorous justification of all operational expenses.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"During financial turnaround, cost reduction initiatives, and annual budget planning.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Start every budget line item from zero.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Require department heads to justify business value for every dollar requested.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Rank and fund packages based on strategic ROI.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"A tech company forcing marketing to justify every software subscription from scratch rather than auto-renewing last year\'s spend.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            advantages = listOf(\"Eliminates legacy budget bloat\", \"Drives extreme cost discipline\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            limitations = listOf(\"Extremely time-consuming and labor-intensive\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"Zero-Based Budgeting destroys legacy bloat by forcing every expense to justify its existence from scratch.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            relatedModelIds = listOf(\"variance_analysis\", \"flexible_budgeting\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            illustrationType = \"bar_chart\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        ManagementModel("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            id = \"capital_budgeting\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryIds = listOf(\"cat8\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            title = \"Capital Budgeting\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            abbreviation = \"CapEx Budgeting\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Financial Management & Managerial Accounting\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"The process of evaluating and selecting long-term investment projects exceeding one year.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To allocate long-term capital to projects generating highest risk-adjusted returns.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"When evaluating major equipment purchases, acquisitions, or plant expansions.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Estimate future cash flows of investment.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Determine cost of capital.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Apply appraisal methods (NPV, IRR, Payback Period).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Approve capital allocation.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"Evaluating whether to invest $10M in a new automated assembly line.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            advantages = listOf(\"Ensures disciplined long-term capital allocation\", \"Maximizes shareholder value\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            limitations = listOf(\"Relies on cash flow forecasts subject to error\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"Capital budgeting uses rigorous financial appraisal methods to allocate long-term investments.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            relatedModelIds = listOf(\"npv\", \"irr\", \"payback_period\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            illustrationType = \"flow_chart\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        ManagementModel("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            id = \"npv\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryIds = listOf(\"cat8\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            title = \"Net Present Value\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            abbreviation = \"NPV\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Financial Management & Managerial Accounting\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"The sum of present values of incoming and outgoing cash flows discounted over time at a target rate.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To determine the absolute dollar value added to a firm by an investment project.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"During capital budgeting and investment appraisal.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Forecast future cash flows for each year.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Select discount rate (cost of capital).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Discount cash flows back to present value.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Sum present values minus initial investment cost (Positive NPV = Accept).\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"A project with $1M initial cost yielding present value cash flows of $1.3M has an NPV of +$300,000.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            advantages = listOf(\"Accounts for time value of money\", \"Adds absolute dollar value to firm\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            limitations = listOf(\"Requires accurate discount rate and cash flow forecasting\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"Projects with positive Net Present Value increase shareholder wealth and should be accepted.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
