            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Write down the problem statement at the fish head.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
