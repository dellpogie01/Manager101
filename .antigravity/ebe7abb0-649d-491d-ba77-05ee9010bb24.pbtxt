              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            abbreviation = \"A3\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Decision-Making & Problem-Solving\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A structured problem-solving and continuous improvement report developed on a single A3-sized sheet of paper.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
