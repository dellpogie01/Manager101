            }
            lines {
              text: "            categoryName = \"General Management & Strategic Planning\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A process of identifying individuals or groups affected by a project and mapping their Power and Interest.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To manage expectations, secure buy-in, and mitigate opposition from key stakeholders.\","
