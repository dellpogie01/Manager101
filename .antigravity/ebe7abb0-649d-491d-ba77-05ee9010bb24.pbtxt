            }
            lines {
              text: "            categoryName = \"General Management & Strategic Planning\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A portfolio management framework categorizing business units or products into Cash Cows, Stars, Question Marks, and Dogs.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To allocate capital and manage product lifecycles across a diversified portfolio.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"During multi-product portfolio reviews and strategic resource allocation.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Plot business units by Market Growth Rate and Relative Market Share.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Classify into Stars (high growth, high share), Cash Cows (low growth, high share), Question Marks (high growth, low share), and Dogs (low growth, low share).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Invest in Stars, harvest Cash Cows, evaluate Question Marks, and divest Dogs.\""
