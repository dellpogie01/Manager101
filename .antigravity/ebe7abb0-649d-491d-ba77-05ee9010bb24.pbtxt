            }
            lines {
              text: "            categoryName = \"General Management & Strategic Planning\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A strategic planning tool evaluating Strengths, Weaknesses, Opportunities, and Threats.\","
