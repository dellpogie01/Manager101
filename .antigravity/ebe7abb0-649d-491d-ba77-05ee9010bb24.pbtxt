              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"Grading a tax filing task as A1, lunch with a vendor as C, and filling out old expense reports as D.\","
