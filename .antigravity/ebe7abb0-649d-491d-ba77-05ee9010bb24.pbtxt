            }
            lines {
              text: "                \"Define task duration ranges (min, most likely, max).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Run 10,000 computer simulation iterations.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Analyze probability distribution curve (e.g., 80% confidence date).\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
