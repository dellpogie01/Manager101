              text: "            purpose = \"To maximize ROI on time and resources by focusing on high-impact, low-effort projects.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"When prioritizing feature backlogs, improvement ideas, or task lists.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"List all proposed tasks or ideas.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Estimate Business Impact (High/Low) and Implementation Effort (High/Low).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Plot on 2x2 matrix.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Prioritize Quick Wins first, then Major Projects; avoid Thankless Tasks.\""
