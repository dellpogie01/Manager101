            }
            lines {
              text: "            title = \"Fishbone Diagram (Ishikawa)\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"Ishikawa\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Decision-Making & Problem-Solving\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A visualization tool categorizing potential causes of a problem into categories (e.g., 6Ms: Manpower, Methods, Materials, Machinery, Measurement, Milieu).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To brainstorm and organize all potential root causes of a quality or operational issue.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"During root cause analysis workshops and quality circles.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Write down the problem statement at the fish head.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Draw major category bones (Methods, Machines, Materials, Manpower, etc.).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Brainstorm contributing factors branching off each category.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Investigate most likely causes.\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            workplaceExample = \"Investigating manufacturing scrap defects by examining machine calibration and raw material batches.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            advantages = listOf(\"Comprehensive brainstorming structure\", \"Visual clarity\"),"
