              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"Focusing management attention on the critical path prevents project schedule overruns.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
