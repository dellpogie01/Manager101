              text: "            categoryIds = listOf(\"cat5\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            title = \"Program Evaluation and Review Technique\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"PERT\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Project, Program & Portfolio Management\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A project scheduling tool using probabilistic time estimates (Optimistic, Most Likely, Pessimistic) to calculate task durations.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To manage uncertainty and schedule risk in complex R&D or engineering projects.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"When project task durations are uncertain or unprecedented.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Estimate Optimistic (O), Most Likely (M), and Pessimistic (P) durations.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Calculate expected time: TE = (O + 4M + P) / 6.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
