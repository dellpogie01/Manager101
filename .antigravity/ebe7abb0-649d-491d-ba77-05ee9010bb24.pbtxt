            lines {
              text: "            categoryName = \"Project, Program & Portfolio Management\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A computerized mathematical technique generating thousands of probabilistic outcome simulations to evaluate project schedule and cost risk.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To model project uncertainty and forecast probability distributions of completion dates and budgets.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"For high-risk megaprojects, construction estimating, and financial modeling.\","
