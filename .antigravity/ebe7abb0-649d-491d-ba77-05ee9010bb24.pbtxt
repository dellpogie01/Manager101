            }
            lines {
              text: "                \"List all project tasks and duration estimates.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Map task dependencies and sequence.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Calculate earliest and latest start/finish times.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Identify the Critical Path (zero float tasks).\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
