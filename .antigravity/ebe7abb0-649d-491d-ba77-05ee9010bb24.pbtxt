            }
            lines {
              text: "            title = \"Cynefin Framework\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"Cynefin\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Decision-Making & Problem-Solving\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A conceptual framework categorizing contexts into Clear, Complicated, Complex, Chaotic, and Confusion domains.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To guide leaders on how to make decisions appropriate to the level of system complexity.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"When choosing leadership approaches in unfamiliar or shifting business environments.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Identify domain: Clear (best practice), Complicated (expert analysis), Complex (probe-sense-respond), Chaotic (act-sense-respond).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Apply matching leadership decision style.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Avoid applying simple rules to complex adaptive environments.\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            workplaceExample = \"Treating supply chain logistics as Complicated (expert analysis) vs. managing an ongoing cyber breach as Chaotic (immediate containment).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            advantages = listOf(\"Prevents applying wrong problem-solving approach\", \"Enhances strategic awareness\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            limitations = listOf(\"Nuanced framework requiring leadership training\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            keyTakeaway = \"Effective leaders match their decision-making approach to the specific complexity domain of the problem.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            relatedModelIds = listOf(\"vroom_yetton\", \"six_thinking_hats\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
