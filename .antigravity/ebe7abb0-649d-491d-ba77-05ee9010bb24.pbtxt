              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"Listening to understand rather than to reply is the foundation of empathetic leadership.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
