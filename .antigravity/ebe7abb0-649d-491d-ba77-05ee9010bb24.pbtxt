            }
            lines {
              text: "            categoryName = \"General Management & Strategic Planning\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A strategic technique exploring multiple plausible future operating environments to test resilience.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To prepare organizations for uncertainty and volatility rather than relying on a single forecast.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"During long-term strategic planning in volatile or disruptive industries.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Identify key uncertainties and driving forces.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Develop 3-4 distinct plausible scenarios (e.g., boom, recession, technological disruption).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Evaluate strategy performance under each scenario.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Build robust contingency plans and early warning indicators.\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
