              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Communication, Coaching & People Development\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A communication process based on Observations, Feelings, Needs, and Requests.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To resolve conflicts with empathy and clarity without blame or judgment.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"During negotiations, team conflict resolution, and difficult conversations.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Observation: State objective facts without evaluation.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Feeling: State emotional reaction.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Need: Identify universal human need underlying feeling.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Request: Make a clear, actionable, positive request.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"\'When code is deployed without tests (Observation), I feel anxious (Feeling) because reliability is our priority (Need). Would you run unit tests before merging? (Request).\'\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            advantages = listOf(\"De-escalates tension\", \"Builds deep connection\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            limitations = listOf(\"Unfamiliar syntax requiring practice\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"Expressing observations, feelings, needs, and requests without blame transforms conflict into connection.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            relatedModelIds = listOf(\"desc_communication\", \"active_listening\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
