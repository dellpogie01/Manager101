            }
            lines {
              text: "            title = \"Kirkpatrick Four Levels of Training Evaluation\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            abbreviation = \"Kirkpatrick\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Communication, Coaching & People Development\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A model evaluating training effectiveness across Reaction, Learning, Behavior, and Results.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To measure whether training investments actually change workplace behavior and business outcomes.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"When evaluating corporate training programs and leadership academies.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Level 1 (Reaction): Did trainees like the training?\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Level 2 (Learning): Did trainees acquire knowledge/skills?\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Level 3 (Behavior): Are trainees applying new skills on the job?\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Level 4 (Results): Did the training produce positive business outcomes?\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
