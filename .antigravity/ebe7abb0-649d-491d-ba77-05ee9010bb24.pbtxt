            lines {
              text: "            categoryIds = listOf(\"cat3\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            title = \"Active Listening Framework\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
