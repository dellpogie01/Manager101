            }
            lines {
              text: "            definition = \"A framework establishing internal control across Control Environment, Risk Assessment, Control Activities, Information & Communication, and Monitoring.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To ensure operational efficiency, financial reporting reliability, and regulatory compliance.\","
