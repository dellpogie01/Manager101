            }
            lines {
              text: "            definition = \"A project scheduling tool using probabilistic time estimates (Optimistic, Most Likely, Pessimistic) to calculate task durations.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To manage uncertainty and schedule risk in complex R&D or engineering projects.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
