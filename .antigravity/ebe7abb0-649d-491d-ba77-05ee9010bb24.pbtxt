            }
            lines {
              text: "            categoryName = \"Financial Management & Managerial Accounting\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"Comparing actual financial results against budgeted figures to investigate favorable and unfavorable variances.\","
