              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"Manager asks: \'What is your career goal?\' (Goal), \'Where do you stand today?\' (Reality), \'What could you try?\' (Options), \'What will you commit to doing by Friday?\' (Will).\","
