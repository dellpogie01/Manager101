            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Quadrant 1: Urgent and Important (Do immediately).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Quadrant 2: Important, Not Urgent (Schedule time for growth and prevention).\","
