              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            title = \"Johari Window\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"Johari\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Communication, Coaching & People Development\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A psychological tool for self-awareness and mutual understanding across Open, Blind, Hidden, and Unknown quadrants.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To improve self-awareness and team trust through feedback and self-disclosure.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"During team building, leadership retreats, and self-reflection workshops.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Open Area: Known to self and others.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Blind Spot: Unknown to self, known to others.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Hidden Area: Known to self, unknown to others.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Unknown Area: Unknown to self and others.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Expand Open area by asking for feedback and sharing self-disclosure.\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
