            }
            lines {
              text: "            abbreviation = \"Kolb Cycle\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Communication, Coaching & People Development\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A four-stage experiential learning cycle: Concrete Experience, Reflective Observation, Abstract Conceptualization, and Active Experimentation.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To explain how individuals learn from hands-on experience and reflection.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"During experiential training, debriefs, and leadership reflection workshops.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Concrete Experience: Doing or experiencing an activity.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Reflective Observation: Reviewing and reflecting on the experience.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Abstract Conceptualization: Learning lessons and forming theories.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Active Experimentation: Testing new theories in practice.\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"After a failed client negotiation (Experience), reflecting on why it stalled (Reflection), concluding that pricing must be flexible (Conceptualization), and trying flexible pricing on the next pitch (Experimentation).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            advantages = listOf(\"Captures natural human learning\", \"Bridges theory and practice\"),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
