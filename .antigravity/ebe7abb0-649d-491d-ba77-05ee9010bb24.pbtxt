            }
            lines {
              text: "            abbreviation = \"Kaizen\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Operations Management, Quality & Process Improvement\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"A Japanese philosophy of continuous, incremental improvement involving all employees.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
