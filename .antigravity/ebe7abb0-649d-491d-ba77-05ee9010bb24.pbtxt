            }
            lines {
              text: "            categoryName = \"Performance Management & Productivity\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"Calculates output per unit of input (labor, capital, materials) across operational processes.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To measure efficiency gains and resource utilization.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"During operational audits, manufacturing reviews, and labor planning.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Measure total output generated (units produced, revenue earned).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Measure total inputs consumed (labor hours, equipment costs, materials).\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
