              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            keyTakeaway = \"True educational mastery moves from basic recall up to complex synthesis and creation.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
