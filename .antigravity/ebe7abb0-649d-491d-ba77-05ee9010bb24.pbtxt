            }
            lines {
              text: "            whenToUse = \"When seeking to improve profit margins or build competitive advantage.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Identify Primary Activities: Inbound Logistics, Operations, Outbound Logistics, Marketing & Sales, Service.\","
