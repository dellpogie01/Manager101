            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"Instead of sending engineers to a 5-day coding seminar (10%), assign them to lead a new microservice migration (70%) with a senior mentor (20%).\","
