            lines {
              text: "            title = \"Radical Candor Framework\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            abbreviation = \"Radical Candor\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Communication, Coaching & People Development\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"A feedback framework balancing \'Care Personally\' with \'Challenge Directly\'.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To guide managers on how to give praise and criticism effectively without being aggressive or ruinously empathetic.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            whenToUse = \"During day-to-day management, feedback sessions, and culture building.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Care Personally: Demonstrate genuine human empathy.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Challenge Directly: Give honest, unvarnished feedback.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                \"Avoid Ruinous Empathy (nice on surface, unhelpful), Manipulative Insincerity, and Obnoxious Aggression.\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            workplaceExample = \"Telling a team member \'Your slides had formatting errors that hurt our pitch, but I know you can fix them by noon because your content was brilliant.\'\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            advantages = listOf(\"Builds high trust and high standards\", \"Prevents unspoken resentment\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            limitations = listOf(\"Easily misconstrued as license to be blunt if \'Care Personally\' is missing\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            keyTakeaway = \"True leadership demands caring personally while challenging directly.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            relatedModelIds = listOf(\"sbi_feedback\", \"coin_feedback\"),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
