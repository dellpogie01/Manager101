            }
            lines {
              text: "            title = \"Five Whys\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            abbreviation = \"5 Whys\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            categoryName = \"Decision-Making & Problem-Solving\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            definition = \"An iterative interrogative technique used to explore cause-and-effect relationships underlying a problem.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            purpose = \"To drill down past symptoms to discover the true root cause.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            whenToUse = \"During incident post-mortems, quality defects, and operational failures.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            steps = listOf("
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"State the problem clearly.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Ask \'Why\' did this happen?\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Ask \'Why\' again to the answer.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "                \"Repeat until root cause is uncovered (typically 5 iterations).\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ),"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            workplaceExample = \"Server crashed? Why? Memory overflow. Why? Memory leak in job runner. Why? Unreleased connection pool. Root cause: Missing unit test for leak detection.\","
