              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            categoryName = \"Decision-Making & Problem-Solving\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            definition = \"An eight-discipline problem-solving methodology designed to identify, correct, and eliminate recurring non-conformances.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            purpose = \"To resolve major customer-facing quality failures permanently.\","
